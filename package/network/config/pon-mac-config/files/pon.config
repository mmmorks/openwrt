
config mac 'mac'
	option enabled '0'
	# auto, gpon or xgs-pon
	option line_mode 'gpon'
	# the ONU serial number: vendor ID (4 characters) and 8 hex digits
	#option serial_number ''
	# GPON: up to 10 characters, or 20 hex digits
	#option password ''
	# XGS-PON: up to 36 characters, or 72 hex digits
	#option registration_id ''
