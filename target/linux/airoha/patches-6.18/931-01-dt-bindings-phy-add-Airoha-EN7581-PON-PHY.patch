From 5d1db62f579d9486945f47fefcedbc398607b45c Mon Sep 17 00:00:00 2001
From: John Morkel <john@morkel.me>
Date: Sun, 18 Oct 2026 21:00:00 +0000
Subject: [PATCH] dt-bindings: phy: add Airoha EN7581 PON PHY

Describe the PON serdes, line block and transmit-disable connection.

Signed-off-by: John Morkel <john@morkel.me>
---
 .../bindings/phy/airoha,en7581-pon-phy.yaml   | 122 ++++++++++++++++++
 1 file changed, 122 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/airoha,en7581-pon-phy.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/airoha,en7581-pon-phy.yaml
@@ -0,0 +1,122 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/airoha,en7581-pon-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha EN7581 PON PHY
+
+maintainers:
+  - mmmorks <john@morkel.me>
+
+description:
+  The PON PHY of the EN7581 is the serdes that faces the optical module, plus
+  a line block that finds downstream frame sync, latches link events, counts
+  line errors and shapes the upstream bursts. It runs GPON (ITU-T G.984) or
+  XGS-PON (ITU-T G.9807.1); the PON MAC picks the mode. A few of its controls
+  sit in the system controller and in the chip-level controller.
+
+properties:
+  compatible:
+    const: airoha,en7581-pon-phy
+
+  reg:
+    items:
+      - description: serdes, analog half followed by the PMA half
+      - description: line block
+
+  reg-names:
+    items:
+      - const: serdes
+      - const: line
+
+  interrupts:
+    maxItems: 1
+    description:
+      The PHY's interrupt, raised while a link event the PHY has latched is
+      pending. Without it the PHY finds those events by polling.
+
+  resets:
+    maxItems: 1
+    description: the PON PHY reset line of the system controller
+
+  airoha,scu:
+    description:
+      The system controller, which holds the PON line mode select, the
+      optical module's transmit-power pin mode and the PHY's bus enable.
+    $ref: /schemas/types.yaml#/definitions/phandle
+
+  airoha,chip-scu:
+    description:
+      The chip-level controller, which holds the PON pin mode and the
+      burst-enable pin's source.
+    $ref: /schemas/types.yaml#/definitions/phandle
+
+  tx-disable-gpios:
+    maxItems: 1
+    description:
+      The optical module's transmit-disable input, asserted to turn its
+      transmitter off.
+
+  airoha,invert-rx-detect:
+    description:
+      Set when the module's receive signal-detect output is asserted on
+      loss of light rather than on light.
+    type: boolean
+
+  airoha,invert-tx-detect:
+    description:
+      Set when the module's transmit signal-detect output has the opposite
+      polarity to the PHY's input.
+    type: boolean
+
+  airoha,invert-burst-enable:
+    description:
+      Set when the module's burst-enable input has the opposite polarity to
+      the PHY's output.
+    type: boolean
+
+  airoha,invert-tx-fault:
+    description:
+      Set when the module's transmit-fault output has the opposite polarity
+      to the PHY's input.
+    type: boolean
+
+  "#phy-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - resets
+  - airoha,scu
+  - airoha,chip-scu
+  - "#phy-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/reset/airoha,en7581-reset.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        phy@1fa8a000 {
+            compatible = "airoha,en7581-pon-phy";
+            reg = <0x0 0x1fa8a000 0x0 0x2000>,
+                  <0x0 0x1faf0000 0x0 0x1000>;
+            reg-names = "serdes", "line";
+            interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
+            airoha,scu = <&scuclk>;
+            airoha,chip-scu = <&chip_scu>;
+            resets = <&scuclk EN7581_XPON_PHY_RST>;
+            tx-disable-gpios = <&en7581_pinctrl 38 GPIO_ACTIVE_HIGH>;
+            airoha,invert-rx-detect;
+            #phy-cells = <0>;
+        };
+    };
