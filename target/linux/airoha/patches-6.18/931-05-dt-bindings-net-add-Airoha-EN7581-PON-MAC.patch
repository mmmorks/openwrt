From 59507c4bce8766dae042598f288e034aadc66285 Mon Sep 17 00:00:00 2001
From: John Morkel <john@morkel.me>
Date: Sun, 18 Oct 2026 21:00:00 +0000
Subject: [PATCH] dt-bindings: net: add Airoha EN7581 PON MAC

Describe both PON MAC windows, their PHYs, interrupts and optic controls.

Signed-off-by: John Morkel <john@morkel.me>
---
 .../bindings/net/airoha,en7581-pon-mac.yaml   | 147 ++++++++++++++++++
 1 file changed, 147 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/net/airoha,en7581-pon-mac.yaml

diff --git a/Documentation/devicetree/bindings/net/airoha,en7581-pon-mac.yaml b/Documentation/devicetree/bindings/net/airoha,en7581-pon-mac.yaml
new file mode 100644
index 0000000..d3d557d
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/airoha,en7581-pon-mac.yaml
@@ -0,0 +1,147 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/airoha,en7581-pon-mac.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha EN7581 PON MAC
+
+maintainers:
+  - mmmorks <john@morkel.me>
+
+description: |
+  The EN7581 has two PON MACs: a GPON transmission convergence block
+  (ITU-T G.984.3) and a 10G one that runs XGS-PON (ITU-T G.9807.1). A board
+  runs one of them at a time, behind the one PON PHY, and they are described
+  together because a combo optical network terminal decides between them at
+  run time, from the optic that sees light.
+
+  The MACs carry the activation, ranging and PLOAM side of the PON. Frames
+  reach them through one GMAC port of the frame engine, the port marked
+  airoha,pon (see airoha,en7581-eth.yaml), which this node points at.
+
+  A board with two optics, one per line mode, behind a shared fibre describes
+  their power lines, their optical path selects and their loss-of-signal
+  outputs here, so that the MAC can power the optic of the chosen mode and
+  find which one sees light. A board with one optic leaves them out and its
+  line mode is set by configuration.
+
+  The driver registers an LED trigger named "pon-link", which a board's PON
+  lamp can name as its linux,default-trigger: the lamp is on while the MAC
+  runs in any activation state but O1, in O7 only while the PON PHY reports
+  the downstream ready, and off while the MAC is stopped.
+
+properties:
+  compatible:
+    const: airoha,en7581-pon-mac
+
+  reg:
+    items:
+      - description: the GPON MAC
+      - description: the 10G MAC
+
+  reg-names:
+    items:
+      - const: gpon
+      - const: xgspon
+
+  interrupts:
+    items:
+      - description:
+          the MAC interrupt, one line that both MACs raise; the MAC that
+          runs takes it
+      - description: the supply monitor that announces a power failure
+
+  interrupt-names:
+    items:
+      - const: mac
+      - const: power-fail
+
+  resets:
+    maxItems: 1
+    description: the GPON MAC block reset of the system controller
+
+  phys:
+    minItems: 1
+    items:
+      - description: the PON PHY (airoha,en7581-pon-phy.yaml)
+      - description:
+          the optics' laser driver (airoha,en7572.yaml), which the MAC
+          starts with the calibration of each line mode it runs or tests
+
+  airoha,system-controller:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      The system controller, whose word at offset 0x84 latches the
+      power-fail interrupt in bit 16.
+
+  airoha,pon-port:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      The GMAC port node of the frame engine that carries the PON traffic.
+      It must have the airoha,pon property.
+
+  optic-power-gpios:
+    items:
+      - description: powers the GPON optic when asserted
+      - description: powers the XGS-PON optic when asserted
+
+  optic-select-gpios:
+    minItems: 1
+    maxItems: 2
+    description:
+      The optical path selects. Asserted, every listed line routes the fibre
+      to the XGS-PON optic; deasserted, to the GPON optic.
+
+  los-gpios:
+    items:
+      - description: asserted while the GPON optic sees no light
+      - description: asserted while the XGS-PON optic sees no light
+
+dependencies:
+  optic-select-gpios: [ optic-power-gpios ]
+  los-gpios: [ optic-power-gpios ]
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - resets
+  - phys
+  - airoha,system-controller
+  - airoha,pon-port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/reset/airoha,en7581-reset.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        pon-mac@1fb64000 {
+            compatible = "airoha,en7581-pon-mac";
+            reg = <0x0 0x1fb64000 0x0 0x1000>,
+                  <0x0 0x1fb65000 0x0 0x1000>;
+            reg-names = "gpon", "xgspon";
+            interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>,
+                         <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
+            interrupt-names = "mac", "power-fail";
+            resets = <&scuclk EN7581_XPON_MAC_RST>;
+            phys = <&en7581_pon_phy>;
+            airoha,system-controller = <&scuclk>;
+            airoha,pon-port = <&gdm2>;
+            optic-power-gpios = <&en7581_pinctrl 9 GPIO_ACTIVE_LOW>,
+                                <&en7581_pinctrl 8 GPIO_ACTIVE_LOW>;
+            optic-select-gpios = <&en7581_pinctrl 45 GPIO_ACTIVE_HIGH>,
+                                 <&en7581_pinctrl 46 GPIO_ACTIVE_HIGH>;
+            los-gpios = <&en7581_pinctrl 10 GPIO_ACTIVE_HIGH>,
+                        <&en7581_pinctrl 11 GPIO_ACTIVE_HIGH>;
+        };
+    };
