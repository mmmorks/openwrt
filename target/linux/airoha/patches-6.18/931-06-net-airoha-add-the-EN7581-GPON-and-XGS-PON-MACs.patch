+/*
+ * G.988 OMCI messages. Octet 4 is the device identifier: a baseline message
+ * is 44 octets, an extended one 10 octets of header (its contents length
+ * in octets 9 and 10) and at most 1966 of contents. On the line each ends
+ * in a 4-octet trailer, in G-PON the CRC-32 of ITU-T I.363.5.
+ */
+#define OMCI_DEV_ID		3
+#define OMCI_DEV_BASELINE	0x0a
+#define OMCI_DEV_EXTENDED	0x0b
+#define OMCI_BASE_LEN	44
+#define OMCI_EXT_HDR_LEN	10
+#define OMCI_EXT_CONTENTS_LEN	8
+#define OMCI_EXT_MAX_CONTENTS	1966
+#define OMCI_TRAILER_LEN	4
+#define OMCI_MAX_LEN		(OMCI_EXT_HDR_LEN + OMCI_EXT_MAX_CONTENTS)
+/* octet 2 is the message type, its low five bits the action */
+#define OMCI_MSG_TYPE		2
+#define OMCI_MT_ACTION		GENMASK(4, 0)
+#define OMCI_MIB_UPLOAD		13
+/* no EtherType names OMCI, and the frames have no header to carry one */
+#define OMCI_PROTOCOL		ETH_P_802_EX1
+/* the OMCI netdev carries nothing */
+#define PMAC_OMCI_NONE		U32_MAX
+
+enum pmac_line {
+	PMAC_AUTO,
+	PMAC_GPON,
+	PMAC_XGS,
+};
+
+static const char * const pmac_line_names[] = {
+	[PMAC_AUTO] = "auto",
+	[PMAC_GPON] = "gpon",
+	[PMAC_XGS] = "xgs-pon",
+};
+
+enum pmac_link {
+	PMAC_LINK_NONE,
+	PMAC_LINK_READY,
+	PMAC_LINK_LOST,
+};
+
+/*
+ * A one-shot timer whose handler takes the state machine's lock. It counts
+ * as run out only while armed and past its deadline, so a handler that was
+ * already waiting for the lock when the timer was stopped or armed again
+ * does nothing.
+ */
+struct pmac_timer {
+	struct delayed_work work;
+	unsigned long expires;
+	bool armed;
+};
+
+/* GPON: where the OMCI watch is (pmac_watch_tick()) */
+enum pmac_watch {
+	PMAC_WATCH_OFF,
+	PMAC_WATCH_ON,
+	PMAC_WATCH_DONE,
+};
+
+/*
+ * XGS-PON: where Key Control is. Only a key generated after the last one
+ * was confirmed or ran out is new; a confirm counts only once a key went
+ * up in Key Report. Back to none wherever the keys are wiped, a disconnect
+ * and each start in O1 too: a key reported when
+ * the line went then leaves it repeating that key after the reconnect, with
+ * no 100 ms timer to end it.
+ */
+enum pmac_x_keys {
+	PMAC_X_KEYS_NONE,
+	PMAC_X_KEYS_REPORTED,
+	PMAC_X_KEYS_CONFIRMED,
+};
+
+/* the PHY's downstream FEC counters (struct pmac_fec) */
+enum {
+	PMAC_FEC_BYTES,
+	PMAC_FEC_FIXED,
+	PMAC_FEC_LOST,
+	PMAC_FEC_WORDS,
+	PMAC_FEC_SECS,
+	PMAC_FEC_NUM,
+};
+
+/*
+ * The XGS-PON messages and events the driver counts itself, for ITU-T
+ * G.988's XG-PON TC and management PM: the downstream messages that passed
+ * the destination and MIC checks by type, the upstream messages by type.
+ */
+enum {
+	PMAC_XM_LODS,
+	PMAC_XM_LODS_RESTORED,
+	PMAC_XM_LODS_REACTIVATED,
+	PMAC_XM_RX_PROFILE,
+	PMAC_XM_RX_RANGING_TIME,
+	PMAC_XM_RX_DEACTIVATE,
+	PMAC_XM_RX_DISABLE_SN,
+	PMAC_XM_RX_REQUEST_REG,
+	PMAC_XM_RX_ASSIGN_ALLOC,
+	PMAC_XM_RX_KEY_CONTROL,
+	PMAC_XM_RX_SLEEP_ALLOW,
+	PMAC_XM_RX_ASSIGN_ONU,
+	PMAC_XM_TX_SERIAL_NUMBER,
+	PMAC_XM_TX_REGISTRATION,
+	PMAC_XM_TX_KEY_REPORT,
+	PMAC_XM_TX_ACK,
+	PMAC_XM_NUM,
+};
+
+/* the activation state machine of the line the MAC runs */
+struct pmac_onu {
+	/* serialises the state machine: interrupts, link reports, timers */
+	struct mutex lock;
+	bool running;
+	unsigned int state;
+
+	bool onu_valid;
+	u16 onu_id;
+	u16 alloc[PMAC_SLOTS];
+	unsigned long slots;
+	/* the frame engine T-CONTs that are open */
+	unsigned long tconts;
+	bool omcc_valid;
+	u16 omcc;
+
+	/* GPON: the part of the equalisation delay below one byte, in bits */
+	u8 sub_byte;
+	u8 key[PMAC_KEY_LEN];
+	u8 key_index;
+	/* a key was made or switched to since the last bring-up */
+	bool keyed;
+	u8 err_seq;
+	/* TO1 expiries left before the MAC starts over */
+	unsigned int to1_left;
+	/* the last downstream message accepted, and the repeats dropped since */
+	u8 last[PLOAM_NBYTES];
+	bool last_valid;
+	unsigned int repeats;
+	/* ranging again after a broadcast POPUP */
+	bool rerange;
+	unsigned int ber_ms;
+	/* the last BER interval's sample; the count is never reset */
+	u64 ber_seq;
+	u32 ber_errors;
+	u32 ber_last_ms;
+	/* XGS-PON: the bits the errors were counted over, 0 on GPON */
+	u64 ber_bits;
+	/* XGS-PON: the FEC sums and the time the interval started at */
+	u64 ber_mark[PMAC_FEC_NUM];
+	ktime_t ber_at;
+
+	/*
+	 * XGS-PON: in O1 after a new ONU-ID, waiting for a loss report
+	 * before a ready one counts
+	 */
+	bool await_loss;
+	/* the key encryption keys by key set, one of which encrypts Key Report's key */
+	u8 kek[2][AES_KEYSIZE_128];
+	/*
+	 * The integrity keys the driver derives itself to check downstream
+	 * MICs: the ONU's own PLOAM integrity key (set A's) and the OMCI
+	 * integrity key of each key set. Valid from the keys' derivation in
+	 * O2-3 to the next MAC stop; a derivation that did not finish leaves
+	 * them invalid, and then Key Control makes no key either.
+	 */
+	u8 ploam_mic_key[AES_KEYSIZE_128];
+	u8 omci_mic_key[2][AES_KEYSIZE_128];
+	bool ik_valid;
+	/*
+	 * The master session key management set in this activation, and the
+	 * PLOAM integrity key it gives, which a downstream message to us may
+	 * carry from the Registration after it. Cleared where the keys are
+	 * derived again.
+	 */
+	u8 msk[AES_KEYSIZE_128];
+	u8 msk_ploam_key[AES_KEYSIZE_128];
+	bool msk_valid;
+	/*
+	 * PLOAM and the key encryption key move to the master session key's
+	 * set (@msk_set) at the next Request Registration. A MAC stop clears it.
+	 */
+	bool msk_switch;
+	u8 msk_set;
+	/* the keys made for Key Control, by key index, kept for their names */
+	u8 x_key[2][AES_KEYSIZE_128];
+	enum pmac_x_keys x_keys;
+	/*
+	 * The key set (X_KEY_SET_*) of the key index bit in the upstream
+	 * messages the driver writes, of the OMCI integrity key, and of the
+	 * key encryption key. Set B at every MAC stop; they move to set A
+	 * only together.
+	 */
+	u8 ploam_set;
+	u8 omci_set;
+	u8 kek_set;
+	/*
+	 * A ranging grant in O4 compared them with the MAC's key index. Only
+	 * the probe clears it, not a MAC stop or a new connect.
+	 */
+	bool set_checked;
+	/* the last Key Report and its key index, sent again until confirmed */
+	u8 report[XPLOAM_UP_NBYTES];
+	u8 report_set;
+	/* the XGS-PON messages and events counted since bind (PMAC_XM_*) */
+	u64 x_msgs[PMAC_XM_NUM];
+	struct pmac_timer key_a;
+	struct pmac_timer key_b;
+
+	struct pmac_timer to1;
+	struct pmac_timer to2;
+	struct pmac_timer ber;
+	/* rewrites the GEM port index table after the port table changed */
+	struct pmac_timer index_refresh;
+	/*
+	 * GPON: the OMCI watch, from O5 and from each MIB upload message, and
+	 * the share of the packet buffers that follows a T-CONT opened after it
+	 */
+	enum pmac_watch watch_state;
+	struct pmac_timer watch;
+	bool watch_seen;
+	unsigned int watch_ticks;
+	unsigned int watch_slot;
+	unsigned long watch_last;
+	unsigned long watch_sum;
+	unsigned long watch_got[PMAC_WATCH_WINDOW];
+	struct pmac_timer buf_share;
+	/* a MIB upload message came in */
+	struct work_struct mib_work;
+	/* struct pmac_gem_count by Port-ID, for every port opened since bind */
+	struct xarray gem_counts;
+
+	struct work_struct link_work;
+	/* a loss report came in since the link work last ran */
+	bool lost_seen;
+
+	/* GEM ports this driver made valid in the MAC's port table */
+	DECLARE_BITMAP(ports, PMAC_X_PORTS);
+	/* XGS-PON: of those, the ones written unicast */
+	DECLARE_BITMAP(unicast, PMAC_X_PORTS);
+	/* XGS-PON: of those, the ones written with upstream encryption */
+	DECLARE_BITMAP(up_crypt, PMAC_X_PORTS);
+	/* GEM ports the OLT encrypts (GPON: Encrypted Port-ID) */
+	DECLARE_BITMAP(crypt, PMAC_X_PORTS);
+	/* frame engine T-CONTs a rate limit was set on */
+	unsigned long rated;
+};
+
+/* a T-CONT's configuration from userspace, by its Alloc-ID */
+struct pmac_tcont_cfg {
+	u16 alloc;
+	bool sched;
+	u8 strict;
+	u16 weights[AIROHA_PON_TCONT_QUEUES];
+	u32 rate;
+	u32 burst;
+};
+
+/* a GEM port from userspace, its upstream T-CONT named by Alloc-ID */
+struct pmac_gem_cfg {
+	u16 port;
+	bool has_alloc;
+	u16 alloc;
+	u8 dir;
+	u8 queue;
+	/* enum airoha_pon_mac_key_ring, the OLT's through OMCI */
+	u8 key_ring;
+	/* the ANI port device it is delivered on, 0 for the PON interface */
+	u32 ifindex;
+};
+
+/* a GEM port's counters, numbered as the MAC numbers them */
+enum {
+	PMAC_GEM_RX_FRAMES,
+	PMAC_GEM_RX_BYTES,
+	PMAC_GEM_TX_FRAMES,
+	PMAC_GEM_TX_BYTES,
+	PMAC_GEM_NUM,
+};
+
+/*
+ * A GEM port's counters, added up since the device was bound. The MAC's
+ * own are 64 bits wide and never cleared here; each read adds what they
+ * moved since @last, which is known only while @settled: from the index
+ * table's rewrite after the port opened until the next change to the port
+ * table or reset of the MAC.
+ */
+struct pmac_gem_count {
+	u64 sum[PMAC_GEM_NUM];
+	u64 last[PMAC_GEM_NUM];
+	bool settled;
+};
+
+/*
+ * The PHY's downstream FEC counters, widened to 64 bits: each fold adds
+ * what a register moved since the last one, which is right across a wrap.
+ */
+struct pmac_fec {
+	/* serialises the reads and the sums; taken after every other lock */
+	struct mutex lock;
+	/* the PHY is powered and counting, from a start to its stop */
+	bool on;
+	u32 last[PMAC_FEC_NUM];
+	u64 sum[PMAC_FEC_NUM];
+	struct delayed_work work;
+};
+
+/* the 10G MAC's line counter fields, as pmac_x_fields[] reads them */
+enum {
+	PMAC_XF_XGTC_HEC,
+	PMAC_XF_ALLOC_HEC = PMAC_XF_XGTC_HEC + 3,
+	PMAC_XF_XGEM_HEC = PMAC_XF_ALLOC_HEC + 3,
+	PMAC_XF_PSBD_HEC = PMAC_XF_XGEM_HEC + 3,
+	PMAC_XF_PLOAM_MIC = PMAC_XF_PSBD_HEC + 2,
+	PMAC_XF_OMCI_MIC,
+	PMAC_XF_KEY_ERR,
+	PMAC_XF_HEC_LOST,
+	PMAC_XF_PROFILE,
+	PMAC_XF_PLOAM_DOWN,
+	PMAC_XF_PLOAM_UP,
+	PMAC_XF_XGEM_UP,
+	PMAC_XF_BYTES_DOWN,
+	PMAC_XF_BYTES_UP,
+	PMAC_XF_FRAGMENTS,
+	PMAC_XF_NUM,
+};
+
+/*
+ * The 10G MAC's line counters, widened to 64 bits field by field, as the
+ * FEC counters are. They count from the downstream ready that clears them
+ * to the MAC's stop, which may clear them too: each fold adds what a field
+ * moved since the last one.
+ */
+struct pmac_xcnt {
+	/* serialises the reads and the sums; taken after every other lock */
+	struct mutex lock;
+	bool on;
+	u32 last[PMAC_XF_NUM];
+	u64 sum[PMAC_XF_NUM];
+	struct delayed_work work;
+};
+
+/* the OMCI messages the OMCI netdev delivered on an XGS-PON line */
+enum {
+	PMAC_XO_BASELINE,
+	PMAC_XO_EXTENDED,
+	/* those that arrived with a MIC that failed the driver's check */
+	PMAC_XO_MIC_ERRORS,
+	PMAC_XO_NUM,
+};
+
+struct pmac {
+	struct device *dev;
+	void __iomem *gpon;
+	void __iomem *xgs;
+	struct reset_control *reset;
+	struct phy *phy;
+	struct airoha_pon *pon;
+	/* the MAC interrupt, one line for both MACs */
+	int irq;
+
+	/* the power-failure interrupt and its latch */
+	int pf_irq;
+	struct regmap *scu;
+	/*
+	 * Set from the power-failure interrupt until the line it hit is
+	 * stopped: the state machine takes nothing more from the OLT or the
+	 * PHY. @pf_line and @pf_at are the line and the time it hit.
+	 */
+	bool pf;
+	enum pmac_line pf_line;
+	ktime_t pf_at;
+	/* keeps the words of one upstream GPON PLOAM message together */
+	raw_spinlock_t up_lock;
+	/* MIC engine A's buffer (PMAC_X_MIC_*) */
+	u8 *mic;
+	dma_addr_t mic_dma;
+
+	struct gpio_descs *power;
+	struct gpio_descs *select;
+	struct gpio_descs *los;
+	/* the optics' laser driver, when the board has one, and whether it runs */
+	struct phy *laser;
+	bool laser_started;
+
+	/* serialises the configuration and starting and stopping */
+	struct mutex lock;
+	enum pmac_line mode;
+	/* the line mode the MAC runs in, PMAC_AUTO while stopped */
+	enum pmac_line line;
+	/*
+	 * The running line was picked with no light on either optic while
+	 * both lines could run, so @redetect tests the optics again until
+	 * the PHY reports light. Also set across a repeat's restart, so a
+	 * repeat that finds no light again logs nothing. A line that saw
+	 * light and then lost it for @redetect's period is tested the same
+	 * way, so a fibre moved to the other mode's OLT is followed.
+	 */
+	bool guess;
+	struct delayed_work redetect;
+	/* @redetect's period, PMAC_REDETECT_MS unless debugfs set it */
+	u32 redetect_ms;
+	/*
+	 * The line a test that finds no light starts: the one that lost its
+	 * light, or PMAC_AUTO for automatic selection.
+	 */
+	enum pmac_line dark_line;
+	/* the PHY reported light since the start, written from its handler */
+	bool lit;
+	/* when the PHY last reported the link lost, written from its handler */
+	unsigned long lost_at;
+	bool sn_set;
+	u8 sn[PMAC_SN_LEN];
+	u8 password[PMAC_PASSWORD_LEN];
+	u8 reg_id[PMAC_REG_ID_LEN];
+
+	/* the PHY's last report, written from its link handler */
+	enum pmac_link link;
+	/* the link lamp trigger, NULL when it could not be registered */
+	struct led_trigger *lamp;
+	/* orders the trigger's events (pmac_lamp_update()) */
+	spinlock_t lamp_lock;
+
+	struct pmac_onu o;
+	struct pmac_fec fec;
+	struct pmac_xcnt xcnt;
+
+	/* the OMCI channel, and the GEM port it sends on or PMAC_OMCI_NONE */
+	struct net_device *omci;
+	u32 omci_port;
+	/* its XGS-PON message counts since bind (PMAC_XO_*) */
+	atomic64_t omci_x[PMAC_XO_NUM];
+
+	/*
+	 * The datapath tables userspace set over netlink. Written with both
+	 * locks held, so either one is enough to read them.
+	 */
+	struct list_head node;
+	unsigned int num_tconts;
+	struct pmac_tcont_cfg tconts[PMAC_SLOTS];
+	unsigned int num_gems;
+	struct pmac_gem_cfg gems[AIROHA_PON_MAX_GEMS];
+	unsigned int num_rules;
+	struct airoha_pon_rule rules[AIROHA_PON_MAX_RULES];
+};
+
+/* every bound device, for the netlink family to find; taken before ->lock */
+static LIST_HEAD(pmac_list);
+static DEFINE_MUTEX(pmac_list_lock);
+
+static void pmac_nl_notify(struct pmac *mac);
+static void pmac_nl_ber(struct pmac *mac);
+static void pmac_x_ber_start(struct pmac *mac);
+static void pmac_nl_reboot(struct pmac *mac, const u8 *m, bool other);
+static void pmac_g_ploam_drain(struct pmac *mac);
+
+static unsigned long pmac_redetect_period(struct pmac *mac)
+{
+	return msecs_to_jiffies(READ_ONCE(mac->redetect_ms));
+}
+
+/*
+ * Stop all four traffic interfaces of a MAC and wait for each to say it
+ * stopped, one at a time.
+ */
+static int pmac_stop_interfaces(struct pmac *mac, void __iomem *reg,
+				const struct pmac_if_stop *stops)
+{
+	unsigned int i;
+	u32 val;
+	int err;
+
+	for (i = 0; i < PMAC_STOPS; i++) {
+		writel((readl(reg) & ~stops[i].done) | stops[i].request, reg);
+		err = readl_poll_timeout(reg, val, val & stops[i].done, 10,
+					 PMAC_STOP_TIMEOUT_US);
+		if (err) {
+			dev_err(mac->dev, "a traffic interface did not stop\n");
+			return err;
+		}
+	}
+
+	return 0;
+}
+
+static void pmac_mask_irqs(void __iomem *enable, void __iomem *status)
+{
+	writel(0, enable);
+	writel(~0U, status);
+}
+
+static void pmac_g_rmw(struct pmac *mac, u32 reg, u32 clr, u32 set)
+{
+	void __iomem *addr = mac->gpon + reg;
+
+	writel((readl(addr) & ~clr) | set, addr);
+}
+
+/*
+ * The OMCI netdev carries frames, and has its carrier, while the ONU is in
+ * O5 with an OMCC: the MAC sends nothing upstream before O5, and a control
+ * frame means nothing while no OMCC is assigned.
+ *
+ * The carrier is the agent's session boundary. On a loss, delivery stops
+ * first, and the carrier goes off only once every frame of the lost OMCC
+ * the frame engine was delivering is in a socket queue, so none arrives
+ * after the agent saw the edge. That holds while RPS is off on the OMCI
+ * netdev: a frame steered to another CPU's backlog leaves the grace period.
+ */
+static void pmac_omci_update(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	bool up = o->state == PMAC_O5 && o->omcc_valid;
+	u32 port = up ? o->omcc : PMAC_OMCI_NONE;
+	u32 old = READ_ONCE(mac->omci_port);
+
+	WRITE_ONCE(mac->omci_port, port);
+	if (up) {
+		netif_carrier_on(mac->omci);
+		return;
+	}
+	if (old != PMAC_OMCI_NONE)
+		synchronize_net();
+	netif_carrier_off(mac->omci);
+}
+
+/*
+ * The "pon-link" LED trigger, for a lamp that shows the ONU has found the
+ * downstream: on while the MAC runs in any state but O1, in O7 only while
+ * the PHY reports the downstream ready, off while the MAC is stopped. Run
+ * after each write of the state, the link report or the running line, from
+ * any context: the lock makes the last caller's event the one that stays.
+ */
+static void pmac_lamp_update(struct pmac *mac)
+{
+	unsigned long flags;
+	unsigned int state;
+	bool on;
+
+	spin_lock_irqsave(&mac->lamp_lock, flags);
+	state = READ_ONCE(mac->o.state);
+	on = READ_ONCE(mac->line) != PMAC_AUTO && state != PMAC_O1 &&
+	     (state != PMAC_O7 || READ_ONCE(mac->link) == PMAC_LINK_READY);
+	led_trigger_event(mac->lamp, on ? LED_FULL : LED_OFF);
+	spin_unlock_irqrestore(&mac->lamp_lock, flags);
+}
+
+/* What follows a write of the activation state to either MAC. */
+static void pmac_state_changed(struct pmac *mac, unsigned int state)
+{
+	WRITE_ONCE(mac->o.state, state);
+	pmac_lamp_update(mac);
+	sysfs_notify(&mac->dev->kobj, NULL, "state");
+	pmac_omci_update(mac);
+	/* a start reports its state once the state machine runs */
+	if (mac->o.running)
+		pmac_nl_notify(mac);
+}
+
+static void pmac_g_set_state(struct pmac *mac, unsigned int state)
+{
+	pmac_g_rmw(mac, REG_G_STATE, REG_G_STATE_NUM, state);
+	pmac_state_changed(mac, state);
+}
+
+static void pmac_x_rmw(struct pmac *mac, u32 reg, u32 clr, u32 set)
+{
+	void __iomem *addr = mac->xgs + reg;
+
+	writel((readl(addr) & ~clr) | set, addr);
+}
+
+/*
+ * The 10G MAC's O2 is G.9807.1's O2-3. In O5 and O6 the PHY watches for link
+ * events: O6 goes back to O5 only on a ready report inside TO2, which is
+ * shorter than the PHY's poll, and the loss that starts TO2 is seen as soon.
+ * A stop leaves the watch to the PHY's exit.
+ */
+static void pmac_x_set_state(struct pmac *mac, unsigned int state)
+{
+	pmac_x_rmw(mac, REG_X_STATE, REG_X_STATE_NUM, state);
+	pmac_state_changed(mac, state);
+	en7581_pon_phy_watch_events(mac->phy,
+				    state == PMAC_O5 || state == PMAC_O6);
+}
+
+/*
+ * The sleep count is loaded by writing it and then setting the load bit,
+ * which clears itself. The driver offers no power saving, so the count is
+ * always all ones.
+ */
+static void pmac_g_load_sleep_count(struct pmac *mac)
+{
+	writel(~0U, mac->gpon + REG_G_SLEEP_COUNT);
+	pmac_g_rmw(mac, REG_G_SLEEP_CTRL, 0, REG_G_SLEEP_LOAD);
+}
+
+/* Stop the traffic interfaces, pulse the block reset, stop them again. */
+static void pmac_g_reset_block(struct pmac *mac)
+{
+	pmac_stop_interfaces(mac, mac->gpon + REG_G_IF_STOP, pmac_g_stops);
+
+	reset_control_assert(mac->reset);
+	udelay(PMAC_RESET_US);
+	reset_control_deassert(mac->reset);
+
+	pmac_stop_interfaces(mac, mac->gpon + REG_G_IF_STOP, pmac_g_stops);
+}
+
+/*
+ * Let the four traffic interfaces go again, @order giving the sequence:
+ * each write clears the request bits released so far and the done bits of
+ * the ones released before it.
+ */
+static void pmac_g_release(struct pmac *mac, const u8 *order, unsigned int n)
+{
+	u32 mask = 0;
+	unsigned int i;
+
+	for (i = 0; i < n; i++) {
+		mask |= pmac_g_stops[order[i]].request;
+		pmac_g_rmw(mac, REG_G_IF_STOP, mask, 0);
+		mask |= pmac_g_stops[order[i]].done;
+	}
+}
+
+/* Turn the diagnostic capture off and empty its buffers. */
+static void pmac_g_capture_off(struct pmac *mac)
+{
+	void __iomem *flush = mac->gpon + REG_G_CAP_FLUSH;
+	unsigned int i;
+	u32 val;
+
+	pmac_g_rmw(mac, REG_G_CAP_MODE, REG_G_CAP_MODE_BIT, 0);
+	pmac_g_rmw(mac, REG_G_CAP_CTRL, BIT(31), 0);
+	pmac_g_rmw(mac, REG_G_CAP_FLUSH, 0, REG_G_CAP_FLUSH_ALL);
+
+	/* one capture at a time; the flush bits clear once it is empty */
+	for (i = 1; i <= 3; i++) {
+		pmac_g_rmw(mac, REG_G_CAP_CTRL, BIT(31) | GENMASK(i, 1), 0);
+		if (i < 3)
+			readl_poll_timeout_atomic(flush, val,
+						  !(val & REG_G_CAP_FLUSH_ALL),
+						  1, 4);
+	}
+	pmac_g_rmw(mac, REG_G_CAP_CTRL, REG_G_CAP_CTRL_ALL, 0);
+}
+
+/* GPON: interfaces stopped, block reset pulsed, everything masked, O1 */
+static void pmac_gpon_connect(struct pmac *mac)
+{
+	pmac_g_load_sleep_count(mac);
+	pmac_g_rmw(mac, REG_G_UPSTREAM, REG_G_UPSTREAM_DATA, 0);
+	en7581_pon_phy_set_transmitter(mac->phy, false);
+
+	pmac_g_reset_block(mac);
+
+	pmac_mask_irqs(mac->gpon + REG_G_IRQ_ENABLE,
+		       mac->gpon + REG_G_IRQ_STATUS);
+	pmac_g_set_state(mac, PMAC_O1);
+}
+
+/*
+ * Stop a pair of the 10G MAC's traffic interfaces at once and wait for
+ * both to say they stopped.
+ */
+static int pmac_x_stop_pair(struct pmac *mac, u32 request, u32 done)
+{
+	u32 val;
+	int err;
+
+	pmac_x_rmw(mac, REG_X_IF_STOP, done, request);
+	err = readl_poll_timeout(mac->xgs + REG_X_IF_STOP, val,
+				 (val & done) == done, 10, PMAC_STOP_TIMEOUT_US);
+	if (err)
+		dev_err(mac->dev, "a traffic interface did not stop\n");
+
+	return err;
+}
+
+/*
+ * The key set the driver works with, for all three uses at once. Nothing
+ * of it goes to the MAC: key-set-select stays as the connect left it.
+ */
+static void pmac_x_use_set(struct pmac *mac, u8 set)
+{
+	mac->o.ploam_set = set;
+	mac->o.omci_set = set;
+	mac->o.kek_set = set;
+}
+
+struct pmac_x_field {
+	u16 reg;
+	u8 shift;
+	u8 width;
+};
+
+#define PMAC_XF(r, s, w)	{ .reg = (r), .shift = (s), .width = (w) }
+
+/* in register order, each register's fields together: one read each */
+static const struct pmac_x_field pmac_x_fields[PMAC_XF_NUM] = {
+	[PMAC_XF_XGTC_HEC]	= PMAC_XF(REG_X_CNT_XGTC_HEC, 0, 8),
+	[PMAC_XF_XGTC_HEC + 1]	= PMAC_XF(REG_X_CNT_XGTC_HEC, 8, 8),
+	[PMAC_XF_XGTC_HEC + 2]	= PMAC_XF(REG_X_CNT_XGTC_HEC, 16, 8),
+	[PMAC_XF_ALLOC_HEC]	= PMAC_XF(REG_X_CNT_ALLOC_HEC, 0, 8),
+	[PMAC_XF_ALLOC_HEC + 1]	= PMAC_XF(REG_X_CNT_ALLOC_HEC, 8, 8),
+	[PMAC_XF_ALLOC_HEC + 2]	= PMAC_XF(REG_X_CNT_ALLOC_HEC, 16, 8),
+	[PMAC_XF_XGEM_HEC]	= PMAC_XF(REG_X_CNT_XGEM_HEC, 0, 8),
+	[PMAC_XF_XGEM_HEC + 1]	= PMAC_XF(REG_X_CNT_XGEM_HEC, 8, 8),
+	[PMAC_XF_XGEM_HEC + 2]	= PMAC_XF(REG_X_CNT_XGEM_HEC, 16, 8),
+	[PMAC_XF_PSBD_HEC]	= PMAC_XF(REG_X_CNT_PSBD_HEC, 0, 16),
+	[PMAC_XF_PSBD_HEC + 1]	= PMAC_XF(REG_X_CNT_PSBD_HEC, 16, 16),
+	[PMAC_XF_PLOAM_MIC]	= PMAC_XF(REG_X_CNT_MIC, 0, 16),
+	[PMAC_XF_OMCI_MIC]	= PMAC_XF(REG_X_CNT_MIC, 16, 16),
+	[PMAC_XF_KEY_ERR]	= PMAC_XF(REG_X_CNT_KEY_ERR, 0, 32),
+	[PMAC_XF_HEC_LOST]	= PMAC_XF(REG_X_CNT_HEC_LOST, 0, 32),
+	[PMAC_XF_PROFILE]	= PMAC_XF(REG_X_CNT_PROFILE, 0, 32),
+	[PMAC_XF_PLOAM_DOWN]	= PMAC_XF(REG_X_CNT_PLOAM_DOWN, 0, 32),
+	[PMAC_XF_PLOAM_UP]	= PMAC_XF(REG_X_CNT_PLOAM_UP, 0, 32),
+	[PMAC_XF_XGEM_UP]	= PMAC_XF(REG_X_CNT_XGEM_UP, 0, 32),
+	[PMAC_XF_BYTES_DOWN]	= PMAC_XF(REG_X_CNT_BYTES_DOWN, 0, 32),
+	[PMAC_XF_BYTES_UP]	= PMAC_XF(REG_X_CNT_BYTES_UP, 0, 32),
+	[PMAC_XF_FRAGMENTS]	= PMAC_XF(REG_X_CNT_FRAGMENTS, 0, 32),
+};
+
+/* Read the line counters; add what they moved to the sums when @add. */
+static void pmac_xcnt_read(struct pmac *mac, bool add)
+{
+	struct pmac_xcnt *x = &mac->xcnt;
+	unsigned int i;
+	u32 val = 0;
+
+	lockdep_assert_held(&x->lock);
+
+	for (i = 0; i < PMAC_XF_NUM; i++) {
+		const struct pmac_x_field *f = &pmac_x_fields[i];
+		u32 mask = GENMASK(f->width - 1, 0);
+		u32 now;
+
+		if (!i || f->reg != pmac_x_fields[i - 1].reg)
+			val = readl(mac->xgs + f->reg);
+		now = (val >> f->shift) & mask;
+		if (add)
+			x->sum[i] += (now - x->last[i]) & mask;
+		x->last[i] = now;
+	}
+}
+
+static void pmac_xcnt_work(struct work_struct *work)
+{
+	struct pmac *mac = container_of(to_delayed_work(work), struct pmac,
+					xcnt.work);
+
+	mutex_lock(&mac->xcnt.lock);
+	if (mac->xcnt.on) {
+		pmac_xcnt_read(mac, true);
+		schedule_delayed_work(&mac->xcnt.work,
+				      msecs_to_jiffies(PMAC_X_CNT_FOLD_MS));
+	}
+	mutex_unlock(&mac->xcnt.lock);
+}
+
+/*
+ * The downstream is ready and the line counters were just cleared: count
+ * from what they hold now. Every downstream ready follows a MAC stop, which
+ * ended the last count.
+ */
+static void pmac_xcnt_begin(struct pmac *mac)
+{
+	mutex_lock(&mac->xcnt.lock);
+	pmac_xcnt_read(mac, false);
+	mac->xcnt.on = true;
+	schedule_delayed_work(&mac->xcnt.work,
+			      msecs_to_jiffies(PMAC_X_CNT_FOLD_MS));
+	mutex_unlock(&mac->xcnt.lock);
+}
+
+/* The MAC is about to stop, which may clear them: keep what they counted. */
+static void pmac_xcnt_end(struct pmac *mac)
+{
+	cancel_delayed_work_sync(&mac->xcnt.work);
+
+	mutex_lock(&mac->xcnt.lock);
+	if (mac->xcnt.on)
+		pmac_xcnt_read(mac, true);
+	mac->xcnt.on = false;
+	mutex_unlock(&mac->xcnt.lock);
+}
+
+/*
+ * The 10G MAC is not reset through the system controller: clearing its
+ * enable bit holds it in reset. It stops the bus side of its traffic
+ * first, then the PHY side, and the driver's key sets go back to set B.
+ */
+static int pmac_x_stop_mac(struct pmac *mac)
+{
+	int err;
+
+	pmac_xcnt_end(mac);
+	err = pmac_x_stop_pair(mac, X_STOP_BUS, X_STOP_BUS_DONE);
+	if (!err)
+		err = pmac_x_stop_pair(mac, X_STOP_PHY, X_STOP_PHY_DONE);
+	pmac_x_rmw(mac, REG_X_ENABLE, REG_X_ENABLE_RUN, 0);
+
+	/* the reset control (mac-enable) cleared: retire all channels */
+	airoha_pon_retire_all(mac->pon);
+
+	pmac_x_use_set(mac, X_KEY_SET_B);
+	mac->o.ik_valid = false;
+	mac->o.msk_switch = false;
+
+	return err;
+}
+
+/* One access to the 10G MAC's T-CONT table; the read's result, or 0. */
+static u32 pmac_x_tcont_cmd(struct pmac *mac, u32 cmd)
+{
+	u32 val;
+
+	writel(cmd, mac->xgs + REG_X_TCONT_CMD);
+	if (readl_poll_timeout(mac->xgs + REG_X_TCONT_DONE, val,
+			       val & REG_X_TCONT_DONE_BIT, 1,
+			       PMAC_SLOT_TIMEOUT_US)) {
+		dev_warn(mac->dev, "the T-CONT table did not answer\n");
+		return 0;
+	}
+
+	return val;
+}
+
+static void pmac_x_write_slot(struct pmac *mac, unsigned int slot, u16 alloc,
+			      bool valid)
+{
+	u32 cmd = REG_X_TCONT_CMD_WRITE |
+		  FIELD_PREP(REG_X_TCONT_CMD_SLOT, slot) |
+		  FIELD_PREP(REG_X_TCONT_CMD_ALLOC, alloc);
+
+	if (valid)
+		cmd |= REG_X_TCONT_CMD_VALID;
+	pmac_x_tcont_cmd(mac, cmd);
+}
+
+/* Empty the T-CONT table: every valid slot written back free. */
+static void pmac_x_free_slots(struct pmac *mac)
+{
+	unsigned int slot;
+	u32 val;
+
+	for (slot = 0; slot < PMAC_SLOTS; slot++) {
+		val = pmac_x_tcont_cmd(mac,
+				       FIELD_PREP(REG_X_TCONT_CMD_SLOT, slot));
+		if (val & REG_X_TCONT_CMD_VALID)
+			pmac_x_write_slot(mac, slot, PMAC_X_SLOT_FREE, false);
+	}
+}
+
+static int pmac_x_port_cmd(struct pmac *mac, u16 port, u32 flags)
+{
+	u32 val;
+	int err;
+
+	writel(REG_X_PORT_CMD_WRITE | flags |
+	       FIELD_PREP(REG_X_PORT_CMD_ID, port), mac->xgs + REG_X_PORT_CMD);
+	err = readl_poll_timeout(mac->xgs + REG_X_PORT_DONE, val,
+				 val & REG_X_PORT_DONE_BIT, 1,
+				 PMAC_PORT_TIMEOUT_US);
+	if (err)
+		dev_warn(mac->dev, "XGEM port %#x: the port table did not answer\n",
+			 port);
+
+	return err;
+}
+
+/* A 128-bit key into four of the 10G MAC's words, octets 1-4 in the last. */
+static void pmac_x_put_key(struct pmac *mac, u32 reg, const u8 *key)
+{
+	unsigned int i;
+
+	for (i = 0; i < 4; i++)
+		writel(key ? get_unaligned_be32(key + 4 * (3 - i)) : 0,
+		       mac->xgs + reg + 4 * i);
+}
+
+static void pmac_x_get_key(struct pmac *mac, u32 reg, u8 *key)
+{
+	unsigned int i;
+
+	for (i = 0; i < 4; i++)
+		put_unaligned_be32(readl(mac->xgs + reg + 4 * (3 - i)),
+				   key + 4 * i);
+}
+
+static void pmac_x_copy_key(struct pmac *mac, u32 from, u32 to)
+{
+	unsigned int i;
+
+	for (i = 0; i < 4; i++)
+		writel(readl(mac->xgs + from + 4 * i), mac->xgs + to + 4 * i);
+}
+
+/* Forget the master session key management set. */
+static void pmac_x_drop_msk(struct pmac_onu *o)
+{
+	memzero_explicit(o->msk, sizeof(o->msk));
+	memzero_explicit(o->msk_ploam_key, sizeof(o->msk_ploam_key));
+	o->msk_valid = false;
+	o->msk_switch = false;
+}
+
+/*
+ * Zero the master key and both key sets in the MAC, and the driver's own
+ * copies. The derivations' result registers keep their last results: the
+ * result registers are not known to be writable.
+ */
+static void pmac_x_wipe_sets(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	unsigned int set;
+
+	pmac_x_drop_msk(o);
+	pmac_x_put_key(mac, REG_X_MASTER, NULL);
+	for (set = X_KEY_SET_A; set <= X_KEY_SET_B; set++) {
+		pmac_x_put_key(mac, REG_X_PLOAM_IK(set), NULL);
+		pmac_x_put_key(mac, REG_X_OMCI_IK(set), NULL);
+		pmac_x_put_key(mac, REG_X_KEK(set), NULL);
+	}
+	memzero_explicit(o->kek, sizeof(o->kek));
+	memzero_explicit(o->ploam_mic_key, sizeof(o->ploam_mic_key));
+	memzero_explicit(o->omci_mic_key, sizeof(o->omci_mic_key));
+	o->ik_valid = false;
+}
+
+/* The serial number and the registration ID the MAC sends by itself. */
+static void pmac_x_write_identity(struct pmac *mac)
+{
+	int i;
+
+	writel(get_unaligned_be32(mac->sn), mac->xgs + REG_X_SN_HI);
+	writel(get_unaligned_be32(mac->sn + 4), mac->xgs + REG_X_SN_LO);
+	for (i = PMAC_REG_ID_LEN / 4 - 1; i >= 0; i--)
+		writel(get_unaligned_be32(mac->reg_id + 4 * i),
+		       mac->xgs + REG_X_REG_ID(i));
+}
+
+/*
+ * 10G MAC: initial settings, then the connect sequence:
+ * every T-CONT slot free, the MAC stopped and in reset, O1, no ONU-ID and
+ * everything masked. The MAC is told key set B for PLOAM and OMCI, and
+ * the driver's own key sets start at set B too (pmac_x_use_set()).
+ */
+static int pmac_xgs_connect(struct pmac *mac)
+{
+	int err;
+
+	pmac_x_rmw(mac, REG_X_OPTIONS, 0, REG_X_OPTIONS_BASE);
+	pmac_x_rmw(mac, REG_X_RESPONSE, REG_X_RESPONSE_VAL,
+		   FIELD_PREP(REG_X_RESPONSE_VAL, X_RESPONSE_TIME));
+	pmac_x_rmw(mac, REG_X_OPTIONS, REG_X_OPTIONS_FILTER, 0);
+	pmac_x_rmw(mac, REG_X_KEY_SET, 0, REG_X_KEY_SET_PLOAM_B);
+	pmac_x_rmw(mac, REG_X_KEY_SET, 0, REG_X_KEY_SET_OMCI_B);
+
+	pmac_x_free_slots(mac);
+	err = pmac_x_stop_mac(mac);
+	if (err)
+		return err;
+
+	pmac_mask_irqs(mac->xgs + REG_X_IRQ_ENABLE,
+		       mac->xgs + REG_X_IRQ_STATUS);
+	pmac_x_rmw(mac, REG_X_ONU, REG_X_ONU_VALID | REG_X_ONU_NUM,
+		   REG_X_ONU_NONE);
+	pmac_x_set_state(mac, PMAC_O1);
+
+	return 0;
+}
+
+static void pmac_timer_arm(struct pmac_timer *t, unsigned int ms)
+{
+	unsigned long delay = msecs_to_jiffies(ms);
+
+	t->expires = jiffies + delay;
+	t->armed = true;
+	mod_delayed_work(system_wq, &t->work, delay);
+}
+
+static void pmac_timer_stop(struct pmac_timer *t)
+{
+	t->armed = false;
+	cancel_delayed_work(&t->work);
+}
+
+/* With the state machine locked: whether @t has run out, disarming it if so. */
+static bool pmac_timer_expired(struct pmac_timer *t)
+{
+	if (!t->armed)
+		return false;
+
+	if (time_before(jiffies, t->expires)) {
+		mod_delayed_work(system_wq, &t->work, t->expires - jiffies);
+		return false;
+	}
+
+	t->armed = false;
+	return true;
+}
+
+static void pmac_stop_timers(struct pmac *mac)
+{
+	pmac_timer_stop(&mac->o.to1);
+	pmac_timer_stop(&mac->o.to2);
+	pmac_timer_stop(&mac->o.ber);
+	pmac_timer_stop(&mac->o.index_refresh);
+	pmac_timer_stop(&mac->o.key_a);
+	pmac_timer_stop(&mac->o.key_b);
+	pmac_timer_stop(&mac->o.watch);
+	mac->o.watch_state = PMAC_WATCH_OFF;
+	pmac_timer_stop(&mac->o.buf_share);
+}
+
+/* Send one upstream PLOAM message @times times. */
+static void pmac_g_send(struct pmac *mac, u8 id, const u8 *data,
+			unsigned int times)
+{
+	u8 msg[PLOAM_NBYTES];
+	unsigned long flags;
+	unsigned int i;
+
+	msg[0] = READ_ONCE(mac->o.onu_id);
+	msg[1] = id;
+	memcpy(msg + 2, data, PLOAM_NDATA);
+
+	/* the power-failure interrupt sends too, from hard interrupt context */
+	raw_spin_lock_irqsave(&mac->up_lock, flags);
+	while (times--)
+		for (i = 0; i < PLOAM_NWORDS; i++)
+			writel(get_unaligned_be32(msg + 4 * i),
+			       mac->gpon + REG_G_UP_MSG);
+	raw_spin_unlock_irqrestore(&mac->up_lock, flags);
+
+	memzero_explicit(msg, sizeof(msg));
+}
+
+/*
+ * Acknowledge downstream message @m: its message ID, then its first nine
+ * octets as they arrived, the ONU-ID octet included.
+ */
+static void pmac_g_ack(struct pmac *mac, const u8 *m)
+{
+	u8 data[PLOAM_NDATA];
+
+	data[0] = OCT(m, 2);
+	memcpy(data + 1, m, PLOAM_NDATA - 1);
+	pmac_g_send(mac, UP_ACK, data, PLOAM_REPEAT);
+}
+
+static int pmac_g_port_cmd(struct pmac *mac, u16 port, u32 flags)
+{
+	u32 val;
+	int err;
+
+	writel(REG_G_PORT_CMD_GO | flags | FIELD_PREP(REG_G_PORT_CMD_ID, port),
+	       mac->gpon + REG_G_PORT_CMD);
+	err = readl_poll_timeout(mac->gpon + REG_G_PORT_DONE, val,
+				 val & REG_G_PORT_DONE_BIT, 1,
+				 PMAC_PORT_TIMEOUT_US);
+	if (err)
+		dev_warn(mac->dev, "GEM port %#x: the port table did not answer\n",
+			 port);
+
+	return err;
+}
+
+/* Whether @port is valid in the MAC's port table. */
+static bool pmac_port_open(const struct pmac_onu *o, unsigned int port)
+{
+	return test_bit(port, o->ports) || (o->omcc_valid && o->omcc == port);
+}
+
+/* Read the four counters of GEM port @port, without clearing them. */
+static int pmac_g_gem_read(struct pmac *mac, u16 port, u64 *now)
+{
+	unsigned int n;
+	u32 val, hi;
+	int err;
+
+	for (n = 0; n < PMAC_GEM_NUM; n++) {
+		writel(FIELD_PREP(REG_G_GEM_MIB_COUNTER, n) |
+		       FIELD_PREP(REG_G_GEM_MIB_PORT, port),
+		       mac->gpon + REG_G_GEM_MIB);
+		err = readl_poll_timeout(mac->gpon + REG_G_GEM_MIB, val,
+					 val & REG_G_GEM_MIB_DONE,
+					 PMAC_GEM_MIB_POLL_US,
+					 PMAC_GEM_MIB_TIMEOUT_US);
+		if (err) {
+			dev_warn_ratelimited(mac->dev,
+					     "GEM port %#x: the counters did not answer\n",
+					     port);
+			return err;
+		}
+		hi = readl(mac->gpon + REG_G_GEM_MIB_HI);
+		now[n] = (u64)hi << 32 | readl(mac->gpon + REG_G_GEM_MIB_LO);
+	}
+
+	return 0;
+}
+
+/*
+ * The same for XGEM port @port. The read-and-clear bit is cleared before
+ * each counter: it applies to every read while it is set.
+ */
+static int pmac_x_gem_read(struct pmac *mac, u16 port, u64 *now)
+{
+	unsigned int n;
+	u32 val, hi;
+	int err;
+
+	for (n = 0; n < PMAC_GEM_NUM; n++) {
+		pmac_x_rmw(mac, REG_X_GEM_MIB_CTRL,
+			   REG_X_GEM_MIB_CLEARS | REG_X_GEM_MIB_ALL_DONE, 0);
+		writel(FIELD_PREP(REG_X_GEM_MIB_COUNTER, n) |
+		       FIELD_PREP(REG_X_GEM_MIB_PORT, port),
+		       mac->xgs + REG_X_GEM_MIB);
+		err = readl_poll_timeout(mac->xgs + REG_X_GEM_MIB, val,
+					 val & REG_X_GEM_MIB_DONE, 1,
+					 PMAC_X_TABLE_TIMEOUT_US);
+		if (err) {
+			dev_warn_ratelimited(mac->dev,
+					     "XGEM port %#x: the counters did not answer\n",
+					     port);
+			return err;
+		}
+		hi = readl(mac->xgs + REG_X_GEM_MIB_HI);
+		now[n] = (u64)hi << 32 | readl(mac->xgs + REG_X_GEM_MIB_LO);
+	}
+
+	return 0;
+}
+
+static int pmac_gem_read(struct pmac *mac, u16 port, u64 *now)
+{
+	if (READ_ONCE(mac->line) == PMAC_XGS)
+		return pmac_x_gem_read(mac, port, now);
+
+	return pmac_g_gem_read(mac, port, now);
+}
+
+/*
+ * Add what the counters of each settled GEM port moved since the last read
+ * to its sums. A counter that went back is counted again from its new value.
+ * With @unsettle the port table or the MAC is about to change, and nothing
+ * is counted again until pmac_gem_settle().
+ */
+static void pmac_gem_fold(struct pmac *mac, bool unsettle)
+{
+	struct pmac_onu *o = &mac->o;
+	struct pmac_gem_count *c;
+	u64 now[PMAC_GEM_NUM];
+	unsigned long port;
+	unsigned int n;
+
+	lockdep_assert_held(&o->lock);
+
+	xa_for_each(&o->gem_counts, port, c) {
+		if (!c->settled)
+			continue;
+		if (pmac_port_open(o, port) && !pmac_gem_read(mac, port, now))
+			for (n = 0; n < PMAC_GEM_NUM; n++) {
+				if (now[n] >= c->last[n])
+					c->sum[n] += now[n] - c->last[n];
+				c->last[n] = now[n];
+			}
+		if (unsettle)
+			c->settled = false;
+	}
+}
+
+/* Count GEM port @port's traffic from what its counters hold now. */
+static void pmac_gem_settle_port(struct pmac *mac, unsigned int port)
+{
+	struct pmac_onu *o = &mac->o;
+	struct pmac_gem_count *c;
+
+	c = xa_load(&o->gem_counts, port);
+	if (!c) {
+		c = kzalloc(sizeof(*c), GFP_KERNEL);
+		if (!c)
+			return;
+		if (xa_err(xa_store(&o->gem_counts, port, c, GFP_KERNEL))) {
+			kfree(c);
+			return;
+		}
+	}
+	c->settled = !pmac_gem_read(mac, port, c->last);
+}
+
+/* The same for every open GEM port. */
+static void pmac_gem_settle(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	unsigned int port;
+
+	for_each_set_bit(port, o->ports, PMAC_X_PORTS)
+		pmac_gem_settle_port(mac, port);
+	if (o->omcc_valid && !test_bit(o->omcc, o->ports))
+		pmac_gem_settle_port(mac, o->omcc);
+}
+
+/*
+ * The MAC finds a GEM port's counters through the index table: entry n
+ * holds how many open GEM ports, the OMCC's included, have a Port-ID below
+ * 16 n (32 n in XGS-PON). The vendor's module rewrites every entry 2 s after
+ * any port opens or closes, the timer starting over at each change, and so
+ * does this driver. Which counters a port's traffic goes to between a
+ * change and the rewrite is not known, so from the change until the rewrite
+ * the open ports are not counted: pmac_ports_changing() before a change,
+ * pmac_ports_changed() after it.
+ */
+static void pmac_ports_changing(struct pmac *mac)
+{
+	pmac_gem_fold(mac, true);
+}
+
+static void pmac_ports_changed(struct pmac *mac)
+{
+	pmac_timer_arm(&mac->o.index_refresh, PMAC_GEM_INDEX_MS);
+}
+
+static void pmac_g_write_index(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	bool omcc = o->omcc_valid && !test_bit(o->omcc, o->ports);
+	unsigned int n, below;
+	u32 val;
+
+	for (n = 0; n < PMAC_GEM_BLOCKS; n++) {
+		below = bitmap_weight(o->ports, n * PMAC_GEM_BLOCK) +
+			(omcc && o->omcc < n * PMAC_GEM_BLOCK);
+		writel(REG_G_GEM_INDEX_WRITE |
+		       FIELD_PREP(REG_G_GEM_INDEX_NUM, n) |
+		       FIELD_PREP(REG_G_GEM_INDEX_VAL, below),
+		       mac->gpon + REG_G_GEM_INDEX);
+		if (readl_poll_timeout_atomic(mac->gpon + REG_G_GEM_INDEX_DONE,
+					      val,
+					      val & REG_G_GEM_INDEX_DONE_BIT, 1,
+					      PMAC_GEM_INDEX_TIMEOUT_US)) {
+			dev_warn(mac->dev, "the GEM port index table did not answer\n");
+			return;
+		}
+	}
+
+	/* in O6, TO2 is running: the counters wait for pmac_g_resettle() */
+	if (o->state != PMAC_O6)
+		pmac_gem_settle(mac);
+}
+
+/*
+ * GPON, leaving O6 for O5: count the open GEM ports again from what their
+ * counters hold, which the loss of signal stopped, unless the index table
+ * is still to be rewritten.
+ */
+static void pmac_g_resettle(struct pmac *mac)
+{
+	if (!mac->o.index_refresh.armed)
+		pmac_gem_settle(mac);
+}
+
+static void pmac_x_write_index(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	bool omcc = o->omcc_valid && !test_bit(o->omcc, o->ports);
+	unsigned int n, below = 0;
+	u32 val;
+
+	for (n = 0; n < PMAC_X_GEM_BLOCKS; n++) {
+		if (n)
+			below += hweight32(bitmap_read(o->ports,
+						       (n - 1) * PMAC_X_GEM_BLOCK,
+						       PMAC_X_GEM_BLOCK));
+		writel(REG_X_GEM_INDEX_WRITE |
+		       FIELD_PREP(REG_X_GEM_INDEX_NUM, n) |
+		       FIELD_PREP(REG_X_GEM_INDEX_VAL,
+				  below + (omcc && o->omcc < n * PMAC_X_GEM_BLOCK)),
+		       mac->xgs + REG_X_GEM_INDEX);
+		if (readl_poll_timeout_atomic(mac->xgs + REG_X_GEM_INDEX_DONE,
+					      val,
+					      val & REG_X_GEM_INDEX_DONE_BIT, 1,
+					      PMAC_X_TABLE_TIMEOUT_US)) {
+			dev_warn(mac->dev, "the XGEM port index table did not answer\n");
+			return;
+		}
+	}
+
+	pmac_gem_settle(mac);
+}
+
+static int pmac_tcont_open(struct pmac *mac, unsigned int tcont, u32 flags)
+{
+	int err;
+
+	if (test_bit(tcont, &mac->o.tconts))
+		return 0;
+
+	err = airoha_pon_tcont_open(mac->pon, tcont, flags);
+	if (err) {
+		dev_err(mac->dev, "cannot open T-CONT %u: %d\n", tcont, err);
+		return err;
+	}
+	__set_bit(tcont, &mac->o.tconts);
+	return 0;
+}
+
+static void pmac_tcont_close(struct pmac *mac, unsigned int tcont)
+{
+	if (!__test_and_clear_bit(tcont, &mac->o.tconts))
+		return;
+
+	airoha_pon_tcont_close(mac->pon, tcont);
+}
+
+/*
+ * A GPON ONU keeps the packet buffers on the fixed caps while the OLT
+ * provisions it over OMCI, and shares them out among its T-CONTs once the
+ * OMCI watch sees that end: the watch starts on reaching O5 and again on a
+ * MIB upload message, and every stop of the activation timers stops it.
+ */
+static void pmac_watch_start(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+
+	o->watch_state = PMAC_WATCH_ON;
+	o->watch_seen = false;
+	o->watch_ticks = 0;
+	o->watch_slot = 0;
+	o->watch_sum = 0;
+	memset(o->watch_got, 0, sizeof(o->watch_got));
+	o->watch_last = DEV_STATS_READ(mac->omci, rx_packets);
+	pmac_timer_arm(&o->watch, PMAC_WATCH_MS);
+}
+
+/* The share needs a T-CONT besides the default Alloc-ID's. */
+static void pmac_watch_end(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+
+	if (o->slots)
+		airoha_pon_buf_budget(mac->pon, false);
+	o->watch_state = PMAC_WATCH_DONE;
+}
+
+static void pmac_watch_tick(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	unsigned long now = DEV_STATS_READ(mac->omci, rx_packets);
+	unsigned long got = now - o->watch_last;
+
+	if (++o->watch_ticks > PMAC_WATCH_TICKS) {
+		pmac_watch_end(mac);
+		return;
+	}
+
+	if (!o->watch_seen) {
+		if (!got) {
+			if (o->watch_ticks > PMAC_WATCH_IDLE_TICKS)
+				pmac_watch_end(mac);
+			else
+				pmac_timer_arm(&o->watch, PMAC_WATCH_MS);
+			return;
+		}
+		o->watch_seen = true;
+		o->watch_ticks = 1;
+	}
+
+	if (o->watch_ticks > PMAC_WATCH_WINDOW)
+		o->watch_sum -= o->watch_got[o->watch_slot];
+	o->watch_sum += got;
+	o->watch_got[o->watch_slot] = got;
+	o->watch_last = now;
+	if (o->watch_ticks >= PMAC_WATCH_WINDOW && !o->watch_sum) {
+		pmac_watch_end(mac);
+		return;
+	}
+
+	o->watch_slot = (o->watch_slot + 1) % PMAC_WATCH_WINDOW;
+	pmac_timer_arm(&o->watch, PMAC_WATCH_MS);
+}
+
+/* Write T-CONT slot @slot: @alloc and valid, or free. */
+static void pmac_g_write_slot(struct pmac *mac, unsigned int slot, u16 alloc,
+			      bool valid)
+{
+	unsigned int shift;
+	u32 val;
+
+	if (slot < PMAC_G_LOWER_SLOTS) {
+		val = FIELD_PREP(REG_G_SLOT_ALLOC, alloc);
+		if (valid)
+			val |= REG_G_SLOT_VALID;
+		shift = (slot & 1) * 16;
+		pmac_g_rmw(mac, REG_G_SLOT_PAIR(slot), 0xffffU << shift,
+			   val << shift);
+		return;
+	}
+
+	val = REG_G_SLOT_UPPER_GO |
+	      FIELD_PREP(REG_G_SLOT_UPPER_NUM, slot - PMAC_G_LOWER_SLOTS) |
+	      FIELD_PREP(REG_G_SLOT_UPPER_ALLOC, alloc);
+	if (valid)
+		val |= REG_G_SLOT_UPPER_VALID;
+	writel(val, mac->gpon + REG_G_SLOT_UPPER);
+	if (readl_poll_timeout(mac->gpon + REG_G_SLOT_UPPER_DONE, val,
+			       val & REG_G_SLOT_UPPER_DONE_BIT, 1,
+			       PMAC_SLOT_TIMEOUT_US))
+		dev_warn(mac->dev, "T-CONT slot %u: the slot table did not answer\n",
+			 slot);
+}
+
+/* The current key into the MAC: key word 3 takes key bytes 0-3. */
+static void pmac_g_write_key(struct pmac *mac)
+{
+	unsigned int i;
+
+	for (i = 0; i < PMAC_KEY_LEN / 4; i++)
+		writel(get_unaligned_be32(mac->o.key + 4 * i),
+		       mac->gpon + REG_G_KEY(PMAC_KEY_LEN / 4 - 1 - i));
+}
+
+/* Whether downstream message @m is addressed to this ONU's own ONU-ID. */
+static bool pmac_g_to_us(struct pmac *mac, const u8 *m)
+{
+	return mac->o.onu_valid && OCT(m, 1) == mac->o.onu_id;
+}
+
+/*
+ * The open frame engine T-CONT that carries @alloc, or -ENOENT while the
+ * OLT has not assigned it.
+ */
+static int pmac_alloc_tcont(const struct pmac *mac, u16 alloc)
+{
+	const struct pmac_onu *o = &mac->o;
+	unsigned int slot;
+
+	for_each_set_bit(slot, &o->slots, PMAC_SLOTS)
+		if (o->alloc[slot] == alloc && test_bit(slot, &o->tconts))
+			return slot;
+
+	return -ENOENT;
+}
+
+/*
+ * The frame engine's GEM port table for the @n GEM ports of @cfg, each
+ * upstream GEM port on the T-CONT its Alloc-ID has now. One whose Alloc-ID
+ * is not assigned carries nothing upstream. NULL when out of memory.
+ */
+static struct airoha_pon_gem *pmac_build_gems(const struct pmac *mac,
+					      const struct pmac_gem_cfg *cfg,
+					      unsigned int n)
+{
+	struct airoha_pon_gem *gems;
+	unsigned int i;
+	int t;
+
+	gems = kcalloc(n, sizeof(*gems), GFP_KERNEL);
+	if (!gems)
+		return NULL;
+
+	for (i = 0; i < n; i++) {
+		const struct pmac_gem_cfg *c = &cfg[i];
+
+		gems[i].port_id = c->port;
+		gems[i].ifindex = c->ifindex;
+		if (c->dir & AIROHA_PON_MAC_DIRECTION_DOWNSTREAM)
+			gems[i].flags |= AIROHA_PON_GEM_DOWNSTREAM;
+		if (!(c->dir & AIROHA_PON_MAC_DIRECTION_UPSTREAM) ||
+		    !c->has_alloc)
+			continue;
+		t = pmac_alloc_tcont(mac, c->alloc);
+		if (t < 0)
+			continue;
+		gems[i].flags |= AIROHA_PON_GEM_UPSTREAM;
+		gems[i].tcont = t;
+		gems[i].queue = c->queue;
+	}
+
+	return gems;
+}
+
+/* Give the frame engine the GEM port table of the stored configuration. */
+static int pmac_push_gems(struct pmac *mac)
+{
+	struct airoha_pon_gem *gems;
+	int err;
+
+	gems = pmac_build_gems(mac, mac->gems, mac->num_gems);
+	if (!gems)
+		return -ENOMEM;
+
+	err = airoha_pon_set_gems(mac->pon, gems, mac->num_gems);
+	kfree(gems);
+	if (err)
+		dev_warn(mac->dev, "cannot set the GEM port table: %d\n", err);
+
+	return err;
+}
+
+/* How many Port-IDs the line the MAC runs has. */
+static unsigned int pmac_num_ports(struct pmac *mac)
+{
+	return READ_ONCE(mac->line) == PMAC_XGS ? PMAC_X_PORTS : PMAC_G_PORTS;
+}
+
+/* The GEM port @port of userspace's table, NULL when it has none. */
+static const struct pmac_gem_cfg *pmac_gem_find(struct pmac *mac,
+						unsigned int port)
+{
+	unsigned int i;
+
+	for (i = 0; i < mac->num_gems; i++)
+		if (mac->gems[i].port == port)
+			return &mac->gems[i];
+
+	return NULL;
+}
+
+/*
+ * An XGEM port is unicast when it carries upstream frames, multicast when it
+ * only carries downstream ones. Its upstream is encrypted when the OLT set
+ * unicast encryption both ways through OMCI (key ring 1). The other key
+ * rings encrypt only the downstream, whose XGEM headers name the key,
+ * so they write nothing.
+ */
+static bool pmac_x_port_unicast(struct pmac *mac, unsigned int port)
+{
+	const struct pmac_gem_cfg *c = pmac_gem_find(mac, port);
+
+	return c && (c->dir & AIROHA_PON_MAC_DIRECTION_UPSTREAM);
+}
+
+static bool pmac_x_port_up_crypt(struct pmac *mac, unsigned int port)
+{
+	const struct pmac_gem_cfg *c = pmac_gem_find(mac, port);
+
+	return c && c->key_ring == AIROHA_PON_MAC_KEY_RING_UNICAST;
+}
+
+/*
+ * Write GEM port @port into the MAC's port table, valid or not. A GPON port
+ * is encrypted when the OLT's Encrypted Port-ID said so; an XGEM port takes
+ * its type and upstream encryption from userspace's table.
+ */
+static int pmac_port_write(struct pmac *mac, unsigned int port, bool valid)
+{
+	bool unicast, up_crypt;
+	u32 flags = 0;
+	int err;
+
+	if (READ_ONCE(mac->line) != PMAC_XGS) {
+		if (valid)
+			flags = REG_G_PORT_CMD_VALID;
+		if (valid && test_bit(port, mac->o.crypt))
+			flags |= REG_G_PORT_CMD_CRYPT;
+		return pmac_g_port_cmd(mac, port, flags);
+	}
+
+	unicast = valid && pmac_x_port_unicast(mac, port);
+	up_crypt = valid && pmac_x_port_up_crypt(mac, port);
+	if (valid)
+		flags = REG_X_PORT_CMD_VALID;
+	if (unicast)
+		flags |= REG_X_PORT_CMD_UNICAST;
+	if (up_crypt)
+		flags |= REG_X_PORT_CMD_CRYPT;
+
+	err = pmac_x_port_cmd(mac, port, flags);
+	if (!err) {
+		assign_bit(port, mac->o.unicast, unicast);
+		assign_bit(port, mac->o.up_crypt, up_crypt);
+	}
+
+	return err;
+}
+
+/*
+ * Whether valid port @port lacks a flag userspace's tables now give it: an
+ * XGEM port that gained or lost its upstream, or its upstream encryption,
+ * since it was written.
+ */
+static bool pmac_port_stale(struct pmac *mac, unsigned int port)
+{
+	return READ_ONCE(mac->line) == PMAC_XGS &&
+	       (pmac_x_port_unicast(mac, port) !=
+		test_bit(port, mac->o.unicast) ||
+		pmac_x_port_up_crypt(mac, port) !=
+		test_bit(port, mac->o.up_crypt));
+}
+
+/*
+ * In O5, make the MAC's port table hold the GEM ports userspace set: each
+ * new one valid, each withdrawn one invalid, each stale one written again.
+ * The OMCC's port is the activation's own, and stays.
+ */
+static void pmac_sync_ports(struct pmac *mac)
+{
+	unsigned int i, port, num = pmac_num_ports(mac);
+	struct pmac_onu *o = &mac->o;
+	bool changed = false;
+	unsigned long *want;
+
+	if (READ_ONCE(mac->line) == PMAC_AUTO || o->state != PMAC_O5)
+		return;
+
+	want = bitmap_zalloc(num, GFP_KERNEL);
+	if (!want)
+		return;
+
+	for (i = 0; i < mac->num_gems; i++)
+		if (mac->gems[i].port < num)
+			__set_bit(mac->gems[i].port, want);
+	if (o->omcc_valid)
+		__clear_bit(o->omcc, want);
+
+	for_each_set_bit(port, o->ports, num) {
+		if (test_bit(port, want) || (o->omcc_valid && port == o->omcc))
+			continue;
+		if (!changed)
+			pmac_ports_changing(mac);
+		changed = true;
+		pmac_port_write(mac, port, false);
+		__clear_bit(port, o->ports);
+	}
+
+	for_each_set_bit(port, want, num) {
+		if (test_bit(port, o->ports) && !pmac_port_stale(mac, port))
+			continue;
+		if (!changed)
+			pmac_ports_changing(mac);
+		changed = true;
+		if (!pmac_port_write(mac, port, true))
+			__set_bit(port, o->ports);
+	}
+
+	if (changed)
+		pmac_ports_changed(mac);
+	bitmap_free(want);
+}
+
+/*
+ * Apply each T-CONT entry userspace set to the T-CONT its Alloc-ID has now,
+ * and take the rate limit off a T-CONT that has no entry any more.
+ */
+static void pmac_sync_tconts(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	unsigned long rated = 0;
+	unsigned int i, t;
+	int err, slot;
+
+	for (i = 0; i < mac->num_tconts; i++) {
+		const struct pmac_tcont_cfg *c = &mac->tconts[i];
+
+		slot = pmac_alloc_tcont(mac, c->alloc);
+		if (slot < 0)
+			continue;
+
+		if (c->sched) {
+			err = airoha_pon_tcont_sched(mac->pon, slot, c->strict,
+						     c->strict == AIROHA_PON_TCONT_QUEUES ?
+						     NULL : c->weights);
+			if (err)
+				dev_warn(mac->dev, "Alloc-ID %#x: cannot set the scheduler: %d\n",
+					 c->alloc, err);
+		}
+
+		err = airoha_pon_tcont_rate(mac->pon, slot, c->rate, c->burst);
+		if (err)
+			dev_warn(mac->dev, "Alloc-ID %#x: cannot set the rate: %d\n",
+				 c->alloc, err);
+		if (c->rate)
+			__set_bit(slot, &rated);
+	}
+
+	for_each_set_bit(t, &o->rated, AIROHA_PON_NUM_TCONTS)
+		if (!test_bit(t, &rated))
+			airoha_pon_tcont_rate(mac->pon, t, 0, 0);
+	o->rated = rated;
+}
+
+/*
+ * Take the ONU off the frame engine: carrier off, every T-CONT closed, and
+ * forget the ONU-ID, the Alloc-IDs, the OMCC and the MAC's port table.
+ * Every way from here back to O5 resets the MAC: a GPON block reset, which
+ * empties the table, or in XGS-PON clearing mac-enable. Whether the latter
+ * empties the table is not established. The exception is an XGS-PON Assign
+ * ONU-ID with another ONU-ID, which keeps the MAC running and so closes
+ * every port first (pmac_x_close_ports()).
+ */
+static void pmac_datapath_down(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	unsigned int t;
+
+	pmac_ports_changing(mac);
+	pmac_timer_stop(&o->index_refresh);
+	airoha_pon_set_carrier(mac->pon, false);
+	for_each_set_bit(t, &o->tconts, AIROHA_PON_NUM_TCONTS)
+		pmac_tcont_close(mac, t);
+
+	o->slots = 0;
+	o->onu_valid = false;
+	o->omcc_valid = false;
+	bitmap_zero(o->ports, PMAC_X_PORTS);
+	bitmap_zero(o->unicast, PMAC_X_PORTS);
+	bitmap_zero(o->up_crypt, PMAC_X_PORTS);
+	bitmap_zero(o->crypt, PMAC_X_PORTS);
+	pmac_omci_update(mac);
+	pmac_push_gems(mac);
+}
+
+/*
+ * Leave the activation: off the frame engine, upstream data off, the
+ * transmitter off, the timers stopped and the block reset. What follows
+ * is O1 or the standby bring-up.
+ */
+static void pmac_g_teardown(struct pmac *mac)
+{
+	pmac_datapath_down(mac);
+	/* device reset: GDM2 gives up every channel */
+	airoha_pon_retire_all(mac->pon);
+	pmac_g_rmw(mac, REG_G_UPSTREAM, REG_G_UPSTREAM_DATA, 0);
+	en7581_pon_phy_set_transmitter(mac->phy, false);
+	pmac_stop_timers(mac);
+	pmac_g_reset_block(mac);
+	mac->o.keyed = false;
+}
+
+/* Any entry to O2: the PHY's burst logic in standby, no bit delay. */
+static void pmac_g_enter_o2(struct pmac *mac)
+{
+	en7581_pon_phy_set_onu_state(mac->phy, EN7581_PON_ONU_STANDBY);
+	mac->o.sub_byte = 0;
+	en7581_pon_phy_set_bit_delay(mac->phy, 0);
+	pmac_g_set_state(mac, PMAC_O2);
+}
+
+/*
+ * O2 after a bring-up: the downstream is synchronised. Release the
+ * interfaces and set the MAC up to answer the OLT's serial number requests.
+ */
+static void pmac_g_standby(struct pmac *mac)
+{
+	static const u8 order[PMAC_STOPS] = { 0, 1, 2, 3 };
+
+	pmac_g_enter_o2(mac);
+
+	pmac_g_release(mac, order, 2);
+	fsleep(PMAC_RELEASE_US);
+	pmac_g_release(mac, order, PMAC_STOPS);
+
+	writel(~0U, mac->gpon + REG_G_ERR_LATCH(0));
+	writel(~0U, mac->gpon + REG_G_ERR_LATCH(1));
+	writel(~0U, mac->gpon + REG_G_IRQ_STATUS);
+	writel(G_IRQ_ENABLED, mac->gpon + REG_G_IRQ_ENABLE);
+
+	pmac_g_capture_off(mac);
+	pmac_g_rmw(mac, REG_G_PF_MODE, REG_G_PF_MODE_AUTO, 0);
+	pmac_g_rmw(mac, REG_G_IDLE_GEM, REG_G_IDLE_GEM_VAL,
+		   FIELD_PREP(REG_G_IDLE_GEM_VAL, G_IDLE_GEM));
+	pmac_g_rmw(mac, REG_G_CNT_MODE, REG_G_CNT_MODE_BIT, 0);
+	/* the DBA report unit: 2048 over the block size, bits reversed */
+	pmac_g_rmw(mac, REG_G_UPSTREAM, REG_G_UPSTREAM_DBRU,
+		   bitrev8(DIV_ROUND_CLOSEST(2048, G_DBA_BLOCK_BYTES)));
+	pmac_g_load_sleep_count(mac);
+	pmac_g_rmw(mac, REG_G_TOD, REG_G_TOD_PERIOD,
+		   FIELD_PREP(REG_G_TOD_PERIOD, G_TOD_PERIOD));
+	pmac_g_rmw(mac, REG_G_RESPONSE, REG_G_RESPONSE_VAL,
+		   FIELD_PREP(REG_G_RESPONSE_VAL, G_RESPONSE_TIME));
+	pmac_g_rmw(mac, REG_G_TRIM, REG_G_TRIM_VAL,
+		   FIELD_PREP(REG_G_TRIM_VAL, G_TRIM));
+	pmac_g_rmw(mac, REG_G_RDI_COUNT, REG_G_RDI_COUNT_VAL,
+		   FIELD_PREP(REG_G_RDI_COUNT_VAL, G_RDI_REPEATS));
+	pmac_g_rmw(mac, REG_G_RDI_CAUSE, 0, REG_G_RDI_CAUSE_ALL);
+	writel(REG_G_RDI_CAUSE_ALL |
+	       FIELD_PREP(REG_G_RDI_CAUSE_LIMIT, G_RDI_LIMIT),
+	       mac->gpon + REG_G_RDI_CAUSE);
+
+	writel(get_unaligned_be32(mac->sn), mac->gpon + REG_G_SN_HI);
+	writel(get_unaligned_be32(mac->sn + 4), mac->gpon + REG_G_SN_LO);
+	pmac_g_write_key(mac);
+
+	/*
+	 * The MAC queues downstream messages from the moment it is out of
+	 * reset and in sync, so the OLT's Upstream Overhead can arrive before
+	 * the status write above, which then acknowledges it, and no interrupt
+	 * would read it until the next message: read what is queued now.
+	 */
+	if (mac->o.running && !READ_ONCE(mac->pf))
+		pmac_g_ploam_drain(mac);
+}
+
+/* Back to O1, waiting for the PHY to find the downstream again. */
+static void pmac_g_to_o1(struct pmac *mac)
+{
+	pmac_g_teardown(mac);
+	pmac_g_set_state(mac, PMAC_O1);
+}
+
+/* Back to O2, without the ONU-ID. */
+static void pmac_g_to_o2(struct pmac *mac)
+{
+	pmac_g_teardown(mac);
+	pmac_g_standby(mac);
+}
+
+/* O5: upstream data may flow. The caller turns the carrier on. */
+static void pmac_g_operation(struct pmac *mac)
+{
+	en7581_pon_phy_set_onu_state(mac->phy, EN7581_PON_ONU_OPERATION);
+	/* the hardware drops later burst setup messages */
+	pmac_g_rmw(mac, REG_G_DROP, 0, REG_G_DROP_EBL);
+	pmac_g_rmw(mac, REG_G_DROP, 0, REG_G_DROP_UO);
+	pmac_g_set_state(mac, PMAC_O5);
+	mac->o.to1_left = PMAC_TO1_TRIES;
+	en7581_pon_phy_restart_counters(mac->phy, EN7581_PON_CNT_BIP);
+}
+
+/*
+ * Upstream Overhead, in O2: the burst overhead for the MAC and the PHY,
+ * the transmitter on, and on to O3 with TO1 running.
+ */
+static void pmac_g_overhead(struct pmac *mac, const u8 *m)
+{
+	struct en7581_pon_gpon_overhead oh = {
+		.guard_time = G_GUARD_BITS,
+		.type1_bits = OCT(m, 4),
+		.type2_bits = OCT(m, 5),
+		.type3_pattern = OCT(m, 6),
+		.delimiter = { OCT(m, 7), OCT(m, 8), OCT(m, 9) },
+	};
+	u32 pre;
+
+	if (mac->o.state != PMAC_O2)
+		return;
+
+	pre = FIELD_PREP(REG_G_PRE_EQD_VAL, get_unaligned_be16(&OCT(m, 11)));
+	if (OCT(m, 10) & UO_PRE_EQD)
+		pre |= REG_G_PRE_EQD_ON;
+
+	en7581_pon_phy_set_transmitter(mac->phy, true);
+	en7581_pon_phy_set_gpon_overhead(mac->phy, &oh);
+	pmac_g_rmw(mac, REG_G_GUARD, REG_G_GUARD_BITS,
+		   FIELD_PREP(REG_G_GUARD_BITS, G_GUARD_BITS));
+	pmac_g_rmw(mac, REG_G_PREAMBLE, REG_G_PREAMBLE_T1 | REG_G_PREAMBLE_T2,
+		   FIELD_PREP(REG_G_PREAMBLE_T1, OCT(m, 4)) |
+		   FIELD_PREP(REG_G_PREAMBLE_T2, OCT(m, 5)));
+	pmac_g_rmw(mac, REG_G_PRE_EQD, REG_G_PRE_EQD_ON | REG_G_PRE_EQD_VAL,
+		   pre);
+
+	en7581_pon_phy_set_onu_state(mac->phy, EN7581_PON_ONU_RANGING);
+	pmac_g_set_state(mac, PMAC_O3);
+	pmac_timer_arm(&mac->o.to1, PMAC_TO1_MS);
+}
+
+/* Extended Burst Length, while ranging: the type 3 preamble lengths. */
+static void pmac_g_extended_burst(struct pmac *mac, const u8 *m)
+{
+	if (mac->o.state != PMAC_O3 && mac->o.state != PMAC_O4)
+		return;
+
+	en7581_pon_phy_set_extended_burst(mac->phy, OCT(m, 3), OCT(m, 4));
+	pmac_g_rmw(mac, REG_G_TYPE3,
+		   REG_G_TYPE3_RANGING | REG_G_TYPE3_OPER | REG_G_TYPE3_VALID,
+		   FIELD_PREP(REG_G_TYPE3_RANGING, OCT(m, 3)) |
+		   FIELD_PREP(REG_G_TYPE3_OPER, OCT(m, 4)) | REG_G_TYPE3_VALID);
+}
+
+/*
+ * Assign ONU-ID naming our serial number, in O3: the ONU-ID, which is also
+ * the default Alloc-ID and the OMCC's, and on to O4 with TO1 running again.
+ * The OMCC's T-CONT opens at Configure Port-ID.
+ */
+static void pmac_g_assign_onu(struct pmac *mac, const u8 *m)
+{
+	struct pmac_onu *o = &mac->o;
+	u8 id = OCT(m, 3);
+
+	if (o->state != PMAC_O3 || id > PLOAM_MAX_ONU ||
+	    memcmp(&OCT(m, 4), mac->sn, PMAC_SN_LEN))
+		return;
+
+	en7581_pon_phy_set_onu_state(mac->phy, EN7581_PON_ONU_RANGING);
+	pmac_g_set_state(mac, PMAC_O4);
+	pmac_timer_arm(&o->to1, PMAC_TO1_MS);
+
+	pmac_g_rmw(mac, REG_G_ONU, REG_G_ONU_VALID | REG_G_ONU_NUM,
+		   REG_G_ONU_VALID | FIELD_PREP(REG_G_ONU_NUM, id));
+	o->onu_id = id;
+	o->onu_valid = true;
+
+	airoha_pon_buf_budget(mac->pon, true);
+}
+
+/*
+ * Ranging Time: the equalisation delay, the MAC taking whole bytes and the
+ * PHY the bits below. In O4 it completes ranging, and starts the OMCI watch
+ * unless it ranges again after a broadcast POPUP.
+ */
+static void pmac_g_ranging_time(struct pmac *mac, const u8 *m)
+{
+	struct pmac_onu *o = &mac->o;
+	u32 eqd = get_unaligned_be32(&OCT(m, 4));
+	bool rerange = o->rerange;
+
+	if (OCT(m, 3) & RT_PROTECTION)
+		return;
+	if (o->state != PMAC_O4 && o->state != PMAC_O5)
+		return;
+
+	writel(eqd & ~7U, mac->gpon + REG_G_DELAY_BYTES);
+	o->sub_byte = eqd & 7;
+	en7581_pon_phy_set_bit_delay(mac->phy, o->sub_byte);
+
+	if (o->state != PMAC_O4)
+		return;
+
+	pmac_timer_stop(&o->to1);
+	pmac_g_rmw(mac, REG_G_UPSTREAM, 0, REG_G_UPSTREAM_DATA);
+	pmac_g_operation(mac);
+	pmac_g_rmw(mac, REG_G_IF_STOP,
+		   REG_G_IF_STOP_HOLD | GENMASK(31, 30) | BIT(24) | BIT(16) |
+		   GENMASK(9, 8) | GENMASK(1, 0), 0);
+
+	if (rerange) {
+		pmac_g_write_key(mac);
+		o->rerange = false;
+	} else {
+		pmac_watch_start(mac);
+	}
+
+	writel(~0U, mac->gpon + REG_G_ERR_LATCH(0));
+	writel(~0U, mac->gpon + REG_G_ERR_LATCH(1));
+	airoha_pon_set_carrier(mac->pon, true);
+	pmac_sync_ports(mac);
+	/* back from O6 by a broadcast POPUP */
+	if (rerange)
+		pmac_g_resettle(mac);
+}
+
+/* Deactivate ONU-ID: back to O2, the ONU-ID gone. */
+static void pmac_g_deactivate(struct pmac *mac)
+{
+	if (mac->o.state < PMAC_O3 || mac->o.state > PMAC_O6)
+		return;
+
+	pmac_g_to_o2(mac);
+}
+
+/* O7: the OLT stopped this ONU; it keeps silent until let go again. */
+static void pmac_g_emergency_stop(struct pmac *mac)
+{
+	static const u8 order[] = { 0, 1 };
+	unsigned int i;
+	u32 val;
+
+	for (i = 0; i < ARRAY_SIZE(order); i++) {
+		const struct pmac_if_stop *s = &pmac_g_stops[order[i]];
+
+		pmac_g_rmw(mac, REG_G_IF_STOP, s->done, s->request);
+		readl_poll_timeout(mac->gpon + REG_G_IF_STOP, val,
+				   val & s->done, 10, PMAC_STOP_TIMEOUT_US);
+	}
+
+	pmac_datapath_down(mac);
+	/* serial number refused: GDM2 gives up every channel */
+	airoha_pon_retire_all(mac->pon);
+	pmac_stop_timers(mac);
+	pmac_g_set_state(mac, PMAC_O7);
+	en7581_pon_phy_set_transmitter(mac->phy, false);
+}
+
+/*
+ * Disable Serial Number, broadcast only: disabling takes O2 to O6 to O7,
+ * enabling takes O7 to O2. Neither is acknowledged.
+ */
+static void pmac_g_disable_sn(struct pmac *mac, const u8 *m)
+{
+	bool ours = !memcmp(&OCT(m, 4), mac->sn, PMAC_SN_LEN);
+	unsigned int state = mac->o.state;
+
+	if (OCT(m, 1) != PLOAM_BROADCAST)
+		return;
+
+	switch (OCT(m, 3)) {
+	case DSN_DISABLE:
+		if (!ours)
+			return;
+		fallthrough;
+	case DSN_DISABLE_ALL:
+		if (state >= PMAC_O2 && state <= PMAC_O6)
+			pmac_g_emergency_stop(mac);
+		break;
+	case DSN_ENABLE:
+		if (!ours)
+			return;
+		fallthrough;
+	case DSN_ENABLE_ALL:
+		if (state == PMAC_O7)
+			pmac_g_to_o2(mac);
+		break;
+	}
+}
+
+/*
+ * Assign Alloc-ID to our ONU-ID, in O5: a GEM Alloc-ID takes the lowest free
+ * T-CONT slot and opens the frame engine's T-CONT of that slot; a
+ * de-allocation closes it and frees the slot. The default Alloc-ID has no
+ * slot. Every one is acknowledged.
+ */
+static void pmac_g_assign_alloc(struct pmac *mac, const u8 *m)
+{
+	struct pmac_onu *o = &mac->o;
+	u16 alloc = (OCT(m, 3) << 4) | (OCT(m, 4) >> 4);
+	unsigned int slot;
+
+	if (o->state != PMAC_O5 || !pmac_g_to_us(mac, m))
+		return;
+
+	if (alloc == o->onu_id)
+		goto ack;
+
+	for_each_set_bit(slot, &o->slots, PMAC_SLOTS)
+		if (o->alloc[slot] == alloc)
+			break;
+
+	switch (OCT(m, 5)) {
+	case ALLOC_GEM:
+		if (slot < PMAC_SLOTS)
+			break;
+		slot = find_next_zero_bit(&o->slots, PMAC_SLOTS, 1);
+		if (slot >= PMAC_SLOTS) {
+			dev_warn(mac->dev, "no T-CONT slot left for Alloc-ID %#x\n",
+				 alloc);
+			break;
+		}
+		pmac_g_write_slot(mac, slot, alloc, true);
+		o->alloc[slot] = alloc;
+		__set_bit(slot, &o->slots);
+		/* past the OMCI watch: the fixed caps, shared out a second later */
+		if (!pmac_tcont_open(mac, slot, 0) &&
+		    o->watch_state == PMAC_WATCH_DONE) {
+			airoha_pon_buf_budget(mac->pon, true);
+			pmac_timer_arm(&o->buf_share, PMAC_BUF_SHARE_MS);
+		}
+		break;
+	case ALLOC_DEALLOCATE:
+		if (slot >= PMAC_SLOTS)
+			break;
+		pmac_tcont_close(mac, slot);
+		fsleep(PMAC_RETIRE_US);
+		pmac_g_write_slot(mac, slot, PMAC_G_SLOT_FREE, false);
+		__clear_bit(slot, &o->slots);
+		break;
+	default:
+		goto ack;
+	}
+
+	/* the GEM ports and T-CONT entries that name the Alloc-ID follow it */
+	pmac_push_gems(mac);
+	pmac_sync_tconts(mac);
+	pmac_nl_notify(mac);
+
+ack:
+	pmac_g_ack(mac, m);
+}
+
+/*
+ * Configure Port-ID to our ONU-ID, in O5: the OMCC's GEM port. Activating
+ * opens the OMCC's T-CONT, frame engine T-CONT 0, and on the first
+ * activation since a bring-up with no key made yet switches to the current
+ * key at once. Deactivating removes the port and closes the T-CONT.
+ *
+ * Activating another Port-ID while an OMCC is open moves the OMCC: the old
+ * port goes out of the port table unless it is also a GEM port of its own.
+ * A port left valid but no longer tracked would be missing from the index
+ * table, and every GEM
+ * port above it would read another port's counters.
+ */
+static void pmac_g_configure_port(struct pmac *mac, const u8 *m)
+{
+	struct pmac_onu *o = &mac->o;
+	u16 port = (OCT(m, 4) << 4) | (OCT(m, 5) >> 4);
+	bool known, moved;
+	u32 val;
+
+	if (o->state != PMAC_O5 || !pmac_g_to_us(mac, m))
+		return;
+
+	if (OCT(m, 3) & PORT_ACTIVATE) {
+		known = o->omcc_valid && o->omcc == port;
+		moved = o->omcc_valid && o->omcc != port &&
+			!test_bit(o->omcc, o->ports);
+		pmac_g_rmw(mac, REG_G_OMCC, REG_G_OMCC_VALID | REG_G_OMCC_ID,
+			   REG_G_OMCC_VALID | FIELD_PREP(REG_G_OMCC_ID, port));
+		pmac_tcont_open(mac, PMAC_OMCC_TCONT, AIROHA_PON_TCONT_NONBLOCK);
+		if (!known) {
+			pmac_ports_changing(mac);
+			if (moved)
+				pmac_g_port_cmd(mac, o->omcc, 0);
+			pmac_g_port_cmd(mac, port, REG_G_PORT_CMD_VALID);
+			pmac_ports_changed(mac);
+		}
+		if (!o->keyed) {
+			writel(REG_G_KEY_CMD_NOW, mac->gpon + REG_G_KEY_CMD);
+			readl_poll_timeout(mac->gpon + REG_G_KEY_CMD, val,
+					   val & REG_G_KEY_CMD_DONE, 1,
+					   PMAC_PORT_TIMEOUT_US);
+			o->keyed = true;
+		}
+		o->omcc = port;
+		o->omcc_valid = true;
+	} else {
+		pmac_ports_changing(mac);
+		pmac_g_rmw(mac, REG_G_OMCC, REG_G_OMCC_VALID, 0);
+		pmac_g_port_cmd(mac, port, 0);
+		pmac_tcont_close(mac, PMAC_OMCC_TCONT);
+		fsleep(PMAC_RETIRE_US);
+		__clear_bit(port, o->ports);
+		o->omcc_valid = false;
+		pmac_ports_changed(mac);
+	}
+	/* before the OMCI carrier: losing the OMCC waits out a grace period */
+	pmac_g_ack(mac, m);
+
+	pmac_omci_update(mac);
+	pmac_nl_notify(mac);
+}
+
+/* Encrypted Port-ID: whether a GEM port's downstream is encrypted. */
+static void pmac_g_encrypted_port(struct pmac *mac, const u8 *m)
+{
+	u16 port = (OCT(m, 4) << 4) | (OCT(m, 5) >> 4);
+	u32 flags = REG_G_PORT_CMD_VALID;
+	bool opens;
+
+	if (mac->o.state != PMAC_O5)
+		return;
+
+	if (OCT(m, 3) & PORT_ENCRYPT)
+		flags |= REG_G_PORT_CMD_CRYPT;
+	/* a GEM port userspace sets later keeps the OLT's choice */
+	__assign_bit(port, mac->o.crypt, flags & REG_G_PORT_CMD_CRYPT);
+	opens = !pmac_port_open(&mac->o, port);
+	if (opens)
+		pmac_ports_changing(mac);
+	if (!pmac_g_port_cmd(mac, port, flags))
+		__set_bit(port, mac->o.ports);
+	if (opens)
+		pmac_ports_changed(mac);
+	pmac_g_ack(mac, m);
+}
+
+static void pmac_g_request_password(struct pmac *mac)
+{
+	if (mac->o.state != PMAC_O5)
+		return;
+
+	pmac_g_send(mac, UP_PASSWORD, mac->password, PLOAM_REPEAT);
+}
+
+/*
+ * Request Key to our ONU-ID, in O5: a new key, into the MAC and up to the
+ * OLT in two halves, each in an Encryption Key message sent three times.
+ * The key index flips between 1 and 0, starting at 1.
+ */
+static void pmac_g_request_key(struct pmac *mac, const u8 *m)
+{
+	struct pmac_onu *o = &mac->o;
+	u8 data[PLOAM_NDATA];
+	unsigned int i;
+
+	if (o->state != PMAC_O5 || !pmac_g_to_us(mac, m))
+		return;
+
+	get_random_bytes(o->key, sizeof(o->key));
+	pmac_g_write_key(mac);
+	o->keyed = true;
+
+	o->key_index ^= 1;
+	for (i = 0; i < 2; i++) {
+		data[0] = o->key_index;
+		data[1] = i;
+		memcpy(data + 2, o->key + 8 * i, 8);
+		pmac_g_send(mac, UP_ENCRYPTION_KEY, data, PLOAM_REPEAT);
+	}
+	memzero_explicit(data, sizeof(data));
+}
+
+/* Key Switching Time: the superframe the new key takes effect at. */
+static void pmac_g_key_switching(struct pmac *mac, const u8 *m)
+{
+	u32 frame = get_unaligned_be32(&OCT(m, 3));
+
+	if (mac->o.state != PMAC_O5)
+		return;
+
+	pmac_g_rmw(mac, REG_G_KEY_AT, REG_G_KEY_AT_FRAME,
+		   FIELD_PREP(REG_G_KEY_AT_FRAME, frame));
+	pmac_g_ack(mac, m);
+}
+
+/*
+ * BER Interval: report the downstream BIP errors every interval, which the
+ * message gives in frames and the timer counts in whole 10 ms ticks.
+ */
+static void pmac_g_ber_interval(struct pmac *mac, const u8 *m)
+{
+	struct pmac_onu *o = &mac->o;
+	u64 us = (u64)get_unaligned_be32(&OCT(m, 3)) * PMAC_FRAME_US;
+	unsigned int ticks;
+
+	if (o->state != PMAC_O5)
+		return;
+
+	ticks = min_t(u64, div_u64(us, USEC_PER_MSEC * PMAC_BER_TICK_MS),
+		      UINT_MAX / PMAC_BER_TICK_MS);
+	o->ber_ms = ticks * PMAC_BER_TICK_MS;
+	if (o->ber_ms)
+		pmac_timer_arm(&o->ber, o->ber_ms);
+	else
+		pmac_timer_stop(&o->ber);
+
+	en7581_pon_phy_restart_counters(mac->phy, EN7581_PON_CNT_BIP);
+	pmac_g_ack(mac, m);
+}
+
+/*
+ * POPUP in O6: one to our ONU-ID goes straight back to O5; a broadcast one
+ * to O4, where a Ranging Time completes ranging again. Swift POPUP is the
+ * first kind for every ONU in O6. TO2 keeps running either way.
+ */
+static void pmac_g_popup(struct pmac *mac, bool to_o4)
+{
+	if (mac->o.state != PMAC_O6)
+		return;
+
+	if (!to_o4) {
+		pmac_g_operation(mac);
+		airoha_pon_set_carrier(mac->pon, true);
+		/* what userspace changed while the ONU was in O6 */
+		pmac_sync_ports(mac);
+		pmac_g_resettle(mac);
+		return;
+	}
+
+	en7581_pon_phy_set_onu_state(mac->phy, EN7581_PON_ONU_RANGING);
+	pmac_g_set_state(mac, PMAC_O4);
+	pmac_timer_arm(&mac->o.to1, PMAC_TO1_MS);
+	mac->o.rerange = true;
+}
+
+/*
+ * Ranging Adjustment: move the equalisation delay by a number of bits.
+ * The MAC holds the delay in whole bytes and the PHY the bits below; the
+ * change goes to both without recomputing the total, and a change that
+ * crosses into the next 32-bit word of the upstream frame moves the bytes
+ * by one word more.
+ */
+static void pmac_g_ranging_adjust(struct pmac *mac, const u8 *m)
+{
+	struct pmac_onu *o = &mac->o;
+	bool sub = OCT(m, 3) & RA_SUBTRACT;
+	s64 change = get_unaligned_be32(&OCT(m, 4));
+	s64 t, w, step, lo, rem;
+	u32 phase, eqd;
+
+	if (o->state != PMAC_O5)
+		return;
+
+	phase = FIELD_GET(REG_G_TX_PHASE_BYTES,
+			  readl(mac->gpon + REG_G_TX_PHASE));
+
+	if (!sub) {
+		t = change + o->sub_byte;
+		w = t / 8;
+		rem = t % 8;
+	} else {
+		t = change - o->sub_byte;
+		w = t >= 0 ? DIV_ROUND_UP_ULL(t, 8) : -(-t / 8);
+		rem = 8 * w - t;
+	}
+
+	lo = w & 3;
+	step = (w & ~3LL) - lo;
+	if (sub ? phase < lo : lo + phase > 3)
+		step += 8;
+
+	eqd = readl(mac->gpon + REG_G_DELAY_BYTES);
+	eqd = sub ? eqd - 8 * step : eqd + 8 * step;
+	writel(eqd, mac->gpon + REG_G_DELAY_BYTES);
+	o->sub_byte = rem;
+	en7581_pon_phy_set_bit_delay(mac->phy, o->sub_byte);
+
+	pmac_g_ack(mac, m);
+}
+
+/*
+ * Whether downstream message @m repeats the last one accepted and is
+ * dropped, unacknowledged. The PLOAM_REPEAT_PASS-th repeat in a row is
+ * accepted again.
+ */
+static bool pmac_g_repeat(struct pmac_onu *o, const u8 *m)
+{
+	size_t len = OCT(m, 2) == DN_RANGING_TIME ? PLOAM_RT_CMP : PLOAM_NBYTES;
+
+	if (o->last_valid && !memcmp(m, o->last, len) &&
+	    ++o->repeats < PLOAM_REPEAT_PASS)
+		return true;
+
+	memcpy(o->last, m, PLOAM_NBYTES);
+	o->last_valid = true;
+	o->repeats = 0;
+
+	return false;
+}
+
+static void pmac_g_ploam(struct pmac *mac, const u8 *m)
+{
+	struct pmac_onu *o = &mac->o;
+	bool bcast = OCT(m, 1) == PLOAM_BROADCAST;
+
+	if (!bcast && !pmac_g_to_us(mac, m))
+		return;
+	if (pmac_g_repeat(o, m))
+		return;
+
+	switch (OCT(m, 2)) {
+	case DN_UPSTREAM_OVERHEAD:
+		pmac_g_overhead(mac, m);
+		break;
+	case DN_EXTENDED_BURST_LENGTH:
+		pmac_g_extended_burst(mac, m);
+		break;
+	case DN_ASSIGN_ONU_ID:
+		pmac_g_assign_onu(mac, m);
+		break;
+	case DN_RANGING_TIME:
+		pmac_g_ranging_time(mac, m);
+		break;
+	case DN_DEACTIVATE_ONU_ID:
+		pmac_g_deactivate(mac);
+		break;
+	case DN_DISABLE_SERIAL_NUMBER:
+		pmac_g_disable_sn(mac, m);
+		break;
+	case DN_ASSIGN_ALLOC_ID:
+		pmac_g_assign_alloc(mac, m);
+		break;
+	case DN_CONFIGURE_PORT:
+		pmac_g_configure_port(mac, m);
+		break;
+	case DN_ENCRYPTED_PORT:
+		pmac_g_encrypted_port(mac, m);
+		break;
+	case DN_REQUEST_PASSWORD:
+		pmac_g_request_password(mac);
+		break;
+	case DN_REQUEST_KEY:
+		pmac_g_request_key(mac, m);
+		break;
+	case DN_KEY_SWITCHING:
+		pmac_g_key_switching(mac, m);
+		break;
+	case DN_BER_INTERVAL:
+		pmac_g_ber_interval(mac, m);
+		break;
+	case DN_POPUP:
+		pmac_g_popup(mac, bcast);
+		break;
+	case DN_SWIFT_POPUP:
+		pmac_g_popup(mac, false);
+		break;
+	case DN_RANGING_ADJUSTMENT:
+		pmac_g_ranging_adjust(mac, m);
+		break;
+	default:
+		/*
+		 * Serial Number Mask, PON-ID, PEE, PST, Change Power Level
+		 * and Sleep Allow need nothing from this ONU.
+		 */
+		break;
+	}
+}
+
+static void pmac_g_ploam_drain(struct pmac *mac)
+{
+	unsigned int budget = PLOAM_BUDGET;
+	u8 m[PLOAM_NBYTES];
+	unsigned int i;
+
+	while (budget-- &&
+	       FIELD_GET(REG_G_DOWN_WORDS,
+			 readl(mac->gpon + REG_G_DOWN_LEVEL)) >= PLOAM_NWORDS) {
+		for (i = 0; i < PLOAM_NWORDS; i++)
+			put_unaligned_be32(readl(mac->gpon + REG_G_DOWN_MSG),
+					   m + 4 * i);
+		pmac_g_ploam(mac, m);
+	}
+}
+
+static irqreturn_t pmac_gpon_irq(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	u32 status, pending;
+
+	mutex_lock(&o->lock);
+
+	status = readl(mac->gpon + REG_G_IRQ_STATUS);
+	pending = status & readl(mac->gpon + REG_G_IRQ_ENABLE);
+	if (!pending) {
+		mutex_unlock(&o->lock);
+		return IRQ_NONE;
+	}
+	writel(status, mac->gpon + REG_G_IRQ_STATUS);
+
+	/* this one is reported once */
+	if (pending & G_IRQ_STOP_TIME)
+		pmac_g_rmw(mac, REG_G_IRQ_ENABLE, G_IRQ_STOP_TIME, 0);
+	if (pending & (G_IRQ_STOP_TIME | G_IRQ_GRANT_CLASH))
+		dev_dbg_ratelimited(mac->dev, "upstream grant error %#x at superframe %u\n",
+				    pending, readl(mac->gpon + REG_G_SUPERFRAME));
+
+	if (o->running && !READ_ONCE(mac->pf) && (pending & G_IRQ_PLOAM))
+		pmac_g_ploam_drain(mac);
+
+	mutex_unlock(&o->lock);
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * XGS-PON activation (ITU-T G.9807.1). The 10G MAC sends Serial Number ONU
+ * and Registration in O2-3 and O4 by itself, and adds the MIC to every
+ * upstream message; the driver
+ * answers the rest of the OLT's messages.
+ */
+
+/* Whether downstream message @m is addressed to this ONU's own ONU-ID. */
+static bool pmac_x_to_us(struct pmac *mac, const u8 *m)
+{
+	return mac->o.onu_valid &&
+	       (get_unaligned_be16(m) & XPLOAM_ONU) == mac->o.onu_id;
+}
+
+/*
+ * Send the 40 octets of an upstream message; @set is the key index bit of
+ * the word before them, the key set the OLT is to check the MIC under.
+ */
+static void pmac_x_send(struct pmac *mac, const u8 *msg, u8 set)
+{
+	u64 *x = mac->o.x_msgs;
+	unsigned int i;
+
+	writel(set, mac->xgs + REG_X_UP_MSG);
+	for (i = 0; i < XPLOAM_UP_NBYTES / 4; i++)
+		writel(get_unaligned_be32(msg + 4 * i), mac->xgs + REG_X_UP_MSG);
+
+	switch (msg[2]) {
+	case XUP_REGISTRATION:
+		x[PMAC_XM_TX_REGISTRATION]++;
+		break;
+	case XUP_KEY_REPORT:
+		x[PMAC_XM_TX_KEY_REPORT]++;
+		break;
+	case XUP_ACK:
+		x[PMAC_XM_TX_ACK]++;
+		break;
+	}
+}
+
+/*
+ * The answer to downstream message @m, of @type: our ONU-ID, @m's sequence
+ * number and @len octets of @content, the rest zero.
+ */
+static void pmac_x_build(struct pmac *mac, const u8 *m, u8 type,
+			 const u8 *content, size_t len, u8 *msg)
+{
+	memset(msg, 0, XPLOAM_UP_NBYTES);
+	put_unaligned_be16(mac->o.onu_id, msg);
+	msg[2] = type;
+	msg[3] = OCT(m, 4);
+	if (len)
+		memcpy(msg + XPLOAM_CONTENT, content, len);
+}
+
+/* Acknowledge @m with completion code 0, OK. */
+static void pmac_x_ack(struct pmac *mac, const u8 *m)
+{
+	u8 msg[XPLOAM_UP_NBYTES];
+
+	pmac_x_build(mac, m, XUP_ACK, NULL, 0, msg);
+	pmac_x_send(mac, msg, mac->o.ploam_set);
+}
+
+/*
+ * O1 to O2-3, the downstream ready: the MAC out of reset with its
+ * interfaces released, the identity it sends by itself, the OMCI MIC
+ * checked downstream and added upstream, no key in use.
+ */
+static void pmac_x_standby(struct pmac *mac)
+{
+	/* the reset control (mac-enable) about to go on: retire all channels first */
+	airoha_pon_retire_all(mac->pon);
+	pmac_x_rmw(mac, REG_X_ENABLE, 0, REG_X_ENABLE_RUN);
+	pmac_x_rmw(mac, REG_X_IF_STOP, X_STOP_BUS, 0);
+	pmac_x_rmw(mac, REG_X_IF_STOP, X_STOP_PHY, 0);
+	en7581_pon_phy_set_receiver(mac->phy, true);
+	pmac_x_rmw(mac, REG_X_DS_FEC, REG_X_DS_FEC_MODE,
+		   FIELD_PREP(REG_X_DS_FEC_MODE, X_DS_FEC));
+	pmac_x_write_identity(mac);
+	pmac_x_rmw(mac, REG_X_OPTIONS, REG_X_OPTIONS_FILTER,
+		   REG_X_OPTIONS_OMCI_RX | REG_X_OPTIONS_OMCI_TX);
+	pmac_x_rmw(mac, REG_X_DYING_GASP, REG_X_DYING_GASP_MASK,
+		   X_DYING_GASP);
+	pmac_x_rmw(mac, REG_X_MIC_DROP, REG_X_MIC_DROP_ON, 0);
+	pmac_x_rmw(mac, REG_X_DS_KEYS, REG_X_DS_KEYS_ALL, 0);
+	pmac_x_rmw(mac, REG_X_US_KEY, REG_X_US_KEY_VALID, 0);
+	pmac_x_rmw(mac, REG_X_IDLE, REG_X_IDLE_VAL,
+		   FIELD_PREP(REG_X_IDLE_VAL, X_IDLE));
+	pmac_x_rmw(mac, REG_X_CNT_MODE, 0, REG_X_CNT_MODE_BIT);
+	en7581_pon_phy_set_fec_decode(mac->phy, EN7581_PON_FEC_DECODE_ON);
+	pmac_x_rmw(mac, REG_X_CNT_CLEAR, 0, REG_X_CNT_CLEAR_FIRST);
+	pmac_x_rmw(mac, REG_X_CNT_CLEAR, 0, REG_X_CNT_CLEAR_SECOND);
+	pmac_xcnt_begin(mac);
+	pmac_x_set_state(mac, PMAC_O2);
+
+	if (!(readl(mac->xgs + REG_X_US_SYNC) & REG_X_US_SYNC_ON))
+		dev_dbg(mac->dev, "the transmitter is not in sync yet\n");
+}
+
+/*
+ * End the key exchange as key timer A running out does: Key Report stops,
+ * both keys go, an earlier confirmed one too, and Key Control starts from
+ * none. Leaving activation does this too: otherwise a
+ * key reported when the ONU left would keep the exchange reported with
+ * timer A stopped, or Key Report would go on under an ONU-ID the ONU no
+ * longer holds.
+ */
+static void pmac_x_keys_drop(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+
+	pmac_timer_stop(&o->key_a);
+	pmac_timer_stop(&o->key_b);
+	memzero_explicit(o->report, sizeof(o->report));
+	pmac_x_rmw(mac, REG_X_DS_KEYS, REG_X_DS_KEYS_ALL, 0);
+	pmac_x_put_key(mac, REG_X_KEY(0), NULL);
+	pmac_x_put_key(mac, REG_X_KEY(1), NULL);
+	memzero_explicit(o->x_key, sizeof(o->x_key));
+	o->x_keys = PMAC_X_KEYS_NONE;
+}
+
+/*
+ * Leave the activation: off the frame engine, the timers stopped, the key
+ * exchange ended, every T-CONT slot free, the MAC stopped and in reset, O1
+ * and no ONU-ID.
+ */
+static void pmac_x_teardown(struct pmac *mac)
+{
+	pmac_datapath_down(mac);
+	pmac_stop_timers(mac);
+	pmac_x_keys_drop(mac);
+	pmac_x_free_slots(mac);
+	pmac_x_stop_mac(mac);
+	pmac_x_set_state(mac, PMAC_O1);
+	pmac_x_rmw(mac, REG_X_ONU, REG_X_ONU_VALID | REG_X_ONU_NUM,
+		   REG_X_ONU_NONE);
+	mac->o.await_loss = false;
+}
+
+/*
+ * Write every port the driver holds open, the OMCC's included, invalid: for
+ * the paths that forget them with the MAC running, which keeps its port
+ * table. A port left valid would still take downstream frames, and the
+ * index table, which counts every valid port, would count one more below it
+ * than the driver writes.
+ */
+static void pmac_x_close_ports(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	unsigned int port;
+
+	pmac_ports_changing(mac);
+	for_each_set_bit(port, o->ports, PMAC_X_PORTS)
+		pmac_x_port_cmd(mac, port, 0);
+	if (o->omcc_valid && !test_bit(o->omcc, o->ports))
+		pmac_x_port_cmd(mac, o->omcc, 0);
+}
+
+/* Tear down, and straight on to O2-3 when the downstream is in sync. */
+static void pmac_x_restart(struct pmac *mac)
+{
+	bool ready, light;
+
+	pmac_x_teardown(mac);
+	if (!en7581_pon_phy_link(mac->phy, &ready, &light) && ready)
+		pmac_x_standby(mac);
+}
+
+/* O5: the carrier on, the port table filled, the BER interval running. */
+static void pmac_x_operation(struct pmac *mac)
+{
+	pmac_x_set_state(mac, PMAC_O5);
+	airoha_pon_set_carrier(mac->pon, true);
+	pmac_sync_ports(mac);
+	pmac_x_ber_start(mac);
+
+	if (!(readl(mac->xgs + REG_X_US_SYNC) & REG_X_US_SYNC_ON))
+		dev_dbg(mac->dev, "the transmitter is not in sync\n");
+}
+
+/* Run one of the hardware's key derivations and wait for it. */
+static int pmac_x_derive(struct pmac *mac, u32 start)
+{
+	void __iomem *status = mac->xgs + REG_X_IRQ_STATUS;
+	u32 val;
+	int err;
+
+	writel(X_IRQ_KEY_DONE, status);
+	writel(start, mac->xgs + REG_X_KEY_START);
+	err = readl_poll_timeout(status, val, val & X_IRQ_KEY_DONE, 1,
+				 PMAC_X_DERIVE_TIMEOUT_US);
+	writel(X_IRQ_KEY_DONE, status);
+
+	return err;
+}
+
+/* Multiply an AES-CMAC subkey by x in GF(2^128) (RFC 4493). */
+static void pmac_cmac_double(u8 *k)
+{
+	u8 msb = k[0] & 0x80;
+	unsigned int i;
+
+	for (i = 0; i < AES_BLOCK_SIZE - 1; i++)
+		k[i] = k[i] << 1 | k[i + 1] >> 7;
+	k[i] = k[i] << 1 ^ (msb ? 0x87 : 0);
+}
+
+/*
+ * The AES-CMAC (RFC 4493) under @key of the @na octets at @a followed by
+ * the @nb octets at @b, all 16 octets of it into @tag. G.9807.1 derives
+ * its keys and computes its MICs with it.
+ */
+static void pmac_cmac(const u8 *key, const u8 *a, size_t na,
+		      const u8 *b, size_t nb, u8 *tag)
+{
+	u8 x[AES_BLOCK_SIZE] = {}, k[AES_BLOCK_SIZE] = {};
+	struct crypto_aes_ctx aes;
+	size_t i, n = 0;
+
+	aes_expandkey(&aes, key, AES_KEYSIZE_128);
+	aes_encrypt(&aes, k, x);
+	pmac_cmac_double(k);
+	for (i = 0; i < na + nb; i++) {
+		if (n == AES_BLOCK_SIZE) {
+			aes_encrypt(&aes, tag, x);
+			memcpy(x, tag, AES_BLOCK_SIZE);
+			n = 0;
+		}
+		x[n++] ^= i < na ? a[i] : b[i - na];
+	}
+	/* a short or empty last block is padded and takes the second subkey */
+	if (n < AES_BLOCK_SIZE) {
+		x[n] ^= 0x80;
+		pmac_cmac_double(k);
+	}
+	for (i = 0; i < AES_BLOCK_SIZE; i++)
+		x[i] ^= k[i];
+	aes_encrypt(&aes, tag, x);
+	memzero_explicit(&aes, sizeof(aes));
+	memzero_explicit(k, sizeof(k));
+	memzero_explicit(x, sizeof(x));
+}
+
+/*
+ * Whether the @mic_len octets at @mic are the MIC of the downstream message
+ * of @len octets at @msg under integrity key @key: the first octets of the
+ * AES-CMAC of the downstream direction code and the message.
+ */
+static bool pmac_x_mic_ok(const u8 *key, const u8 *msg, size_t len,
+			  const u8 *mic, size_t mic_len)
+{
+	static const u8 dir = X_MIC_DOWNSTREAM;
+	u8 tag[AES_BLOCK_SIZE];
+
+	pmac_cmac(key, &dir, 1, msg, len, tag);
+
+	return !crypto_memneq(tag, mic, mic_len);
+}
+
+/*
+ * The integrity keys from master key @msk and the PON-TAG at @tag, as
+ * G.9807.1 derives them: the session key, the AES-CMAC of the serial
+ * number, the PON-TAG and "SessionK"; under it, the OMCI integrity key
+ * into @omci and, when @ploam is not NULL, the PLOAM integrity key.
+ */
+static void pmac_x_derive_ik(struct pmac *mac, const u8 *msk, const u8 *tag,
+			     u8 *omci, u8 *ploam)
+{
+	u8 ctx[PMAC_SN_LEN + X_PON_TAG_LEN], sk[AES_KEYSIZE_128];
+
+	memcpy(ctx, mac->sn, PMAC_SN_LEN);
+	memcpy(ctx + PMAC_SN_LEN, tag, X_PON_TAG_LEN);
+	pmac_cmac(msk, ctx, sizeof(ctx), "SessionK", 8, sk);
+	pmac_cmac(sk, NULL, 0, "OMCIIntegrityKey", 16, omci);
+	/* G.9807.1 spells the label so */
+	if (ploam)
+		pmac_cmac(sk, NULL, 0, "PLOAMIntegrtyKey", 16, ploam);
+	memzero_explicit(sk, sizeof(sk));
+}
+
+/* Say when a key the MAC derived differs from the driver's own. */
+static void pmac_x_check_key(struct pmac *mac, u32 reg, const u8 *key,
+			     const char *name)
+{
+	u8 hw[AES_KEYSIZE_128];
+
+	pmac_x_get_key(mac, reg, hw);
+	if (crypto_memneq(hw, key, sizeof(hw)))
+		dev_dbg(mac->dev, "the MAC's %s differs from the driver's\n",
+			name);
+	memzero_explicit(hw, sizeof(hw));
+}
+
+/*
+ * From the master key: the session key, then the OMCI integrity key, the
+ * PLOAM integrity key and the key encryption key of @set, each derived in
+ * turn and copied. Set B keeps the default PLOAM integrity key. The key
+ * encryption key is also kept, for Key Report. A derivation that does not
+ * finish ends it there, its result not copied.
+ */
+static int pmac_x_derive_set(struct pmac *mac, unsigned int set)
+{
+	int err;
+
+	err = pmac_x_derive(mac, REG_X_KEY_START_SK);
+	if (err)
+		return err;
+	err = pmac_x_derive(mac, REG_X_KEY_START_OMCI);
+	if (err)
+		return err;
+	pmac_x_copy_key(mac, REG_X_DERIVED, REG_X_OMCI_IK(set));
+	if (set == X_KEY_SET_B) {
+		pmac_x_put_key(mac, REG_X_PLOAM_IK(set), pmac_x_default_ik);
+	} else {
+		err = pmac_x_derive(mac, REG_X_KEY_START_PLOAM);
+		if (err)
+			return err;
+		pmac_x_copy_key(mac, REG_X_DERIVED, REG_X_PLOAM_IK(set));
+	}
+	err = pmac_x_derive(mac, REG_X_KEY_START_KEK);
+	if (err)
+		return err;
+	pmac_x_copy_key(mac, REG_X_DERIVED, REG_X_KEK(set));
+	pmac_x_get_key(mac, REG_X_DERIVED, mac->o.kek[set]);
+
+	return 0;
+}
+
+/*
+ * Both key sets, once the PON-TAG (at @tag) is in: set B from the default
+ * master key, then set A from the master key the hardware derives from the
+ * registration ID it holds. The driver derives the integrity keys too, from
+ * the same inputs, to check downstream MICs with; the master key of set A
+ * is the AES-CMAC under the default PLOAM integrity key of the
+ * registration ID. A derivation that does not finish leaves both sets
+ * zeroed and the keys not derived, until a later Burst Profile in O2-3.
+ * A master session key from the last activation is dropped
+ * (pmac_x_set_msk()).
+ */
+static void pmac_x_derive_keys(struct pmac *mac, const u8 *tag)
+{
+	struct pmac_onu *o = &mac->o;
+	u8 *omci_a = o->omci_mic_key[X_KEY_SET_A];
+	u8 *omci_b = o->omci_mic_key[X_KEY_SET_B];
+	u8 msk[AES_KEYSIZE_128];
+	int err;
+
+	o->ik_valid = false;
+	pmac_x_drop_msk(o);
+	pmac_x_put_key(mac, REG_X_MASTER, pmac_x_default_msk);
+	err = pmac_x_derive_set(mac, X_KEY_SET_B);
+	if (!err)
+		err = pmac_x_derive(mac, REG_X_KEY_START_MSK);
+	if (!err) {
+		pmac_x_copy_key(mac, REG_X_DERIVED_MSK, REG_X_MASTER);
+		err = pmac_x_derive_set(mac, X_KEY_SET_A);
+	}
+	if (err) {
+		dev_err(mac->dev, "a key derivation did not finish: no keys\n");
+		pmac_x_wipe_sets(mac);
+		return;
+	}
+
+	pmac_x_derive_ik(mac, pmac_x_default_msk, tag, omci_b, NULL);
+	pmac_cmac(pmac_x_default_ik, mac->reg_id, PMAC_REG_ID_LEN, NULL, 0, msk);
+	pmac_x_derive_ik(mac, msk, tag, omci_a, o->ploam_mic_key);
+	memzero_explicit(msk, sizeof(msk));
+	o->ik_valid = true;
+
+	pmac_x_check_key(mac, REG_X_OMCI_IK(X_KEY_SET_B), omci_b,
+			 "set B OMCI integrity key");
+	pmac_x_check_key(mac, REG_X_OMCI_IK(X_KEY_SET_A), omci_a,
+			 "set A OMCI integrity key");
+	pmac_x_check_key(mac, REG_X_PLOAM_IK(X_KEY_SET_A), o->ploam_mic_key,
+			 "set A PLOAM integrity key");
+}
+
+/*
+ * A master session key @msk from the management side (G.988 9.13.11's
+ * authentication, through sysfs master_session_key): its OMCI integrity key
+ * goes into the key set the driver's OMCI index does not name, and its
+ * PLOAM integrity key and key encryption key into the set the PLOAM index
+ * does not name, each derived by the MAC in turn. OMCI moves to its new set
+ * at once: the MAC signs upstream OMCI under the set key-set-select names,
+ * and a downstream MIC is checked under either set. PLOAM and the key
+ * encryption key move at the next Request Registration
+ * (pmac_x_request_registration()), as G.9807.1 switches PLOAM keys at a
+ * Registration exchange. The key set again unchanged is a no-op.
+ *
+ * Where it departs from the vendor module, it follows G.9807.1: the OMCI
+ * index moves to the set its new key went into, where the vendor module
+ * takes the set opposite the one the MAC's key-index reports (the two agree
+ * whenever the MAC reports the driver's own OMCI set); and PLOAM moves
+ * once, at the first Request Registration after the key, where the vendor
+ * module toggles both indexes at every Request Registration from then until
+ * it is unloaded, which would put a second Registration exchange back on
+ * the old keys. The key lasts until the keys are derived again at the next
+ * activation, as with the vendor module: an authentication belongs to the
+ * OMCC session it ran in, and the management side sets a new key after the
+ * next one.
+ *
+ * Only once this activation's keys are derived (-EAGAIN before); a
+ * derivation that does not finish leaves the key unset (-EIO), with the
+ * sets it reached holding what the MAC had derived so far.
+ */
+static int pmac_x_set_msk(struct pmac *mac, const u8 *msk)
+{
+	struct pmac_onu *o = &mac->o;
+	u8 omci = !o->omci_set, ploam = !o->ploam_set;
+	u8 tag[X_PON_TAG_LEN], omci_key[AES_KEYSIZE_128];
+	int err;
+
+	lockdep_assert_held(&o->lock);
+
+	if (!o->ik_valid)
+		return -EAGAIN;
+	if (o->msk_valid && !crypto_memneq(o->msk, msk, sizeof(o->msk)))
+		return 0;
+
+	pmac_x_drop_msk(o);
+	pmac_x_put_key(mac, REG_X_MASTER, msk);
+	err = pmac_x_derive(mac, REG_X_KEY_START_SK);
+	if (!err)
+		err = pmac_x_derive(mac, REG_X_KEY_START_OMCI);
+	if (!err) {
+		pmac_x_copy_key(mac, REG_X_DERIVED, REG_X_OMCI_IK(omci));
+		err = pmac_x_derive(mac, REG_X_KEY_START_PLOAM);
+	}
+	if (!err) {
+		pmac_x_copy_key(mac, REG_X_DERIVED, REG_X_PLOAM_IK(ploam));
+		err = pmac_x_derive(mac, REG_X_KEY_START_KEK);
+	}
+	if (err) {
+		dev_err(mac->dev, "a master session key derivation did not finish\n");
+		return -EIO;
+	}
+	pmac_x_copy_key(mac, REG_X_DERIVED, REG_X_KEK(ploam));
+	pmac_x_get_key(mac, REG_X_DERIVED, o->kek[ploam]);
+
+	put_unaligned_be32(readl(mac->xgs + REG_X_PON_TAG_HI), tag);
+	put_unaligned_be32(readl(mac->xgs + REG_X_PON_TAG_LO), tag + 4);
+	pmac_x_derive_ik(mac, msk, tag, omci_key, o->msk_ploam_key);
+	memcpy(o->omci_mic_key[omci], omci_key, sizeof(omci_key));
+	pmac_x_check_key(mac, REG_X_OMCI_IK(omci), omci_key,
+			 "master session OMCI integrity key");
+	pmac_x_check_key(mac, REG_X_PLOAM_IK(ploam), o->msk_ploam_key,
+			 "master session PLOAM integrity key");
+	memzero_explicit(omci_key, sizeof(omci_key));
+
+	o->omci_set = omci;
+	pmac_x_rmw(mac, REG_X_KEY_SET, REG_X_KEY_SET_OMCI_B,
+		   omci == X_KEY_SET_B ? REG_X_KEY_SET_OMCI_B : 0);
+	memcpy(o->msk, msk, sizeof(o->msk));
+	o->msk_set = ploam;
+	o->msk_switch = true;
+	o->msk_valid = true;
+
+	return 0;
+}
+
+/*
+ * Burst Profile: the profile to the PHY, then the profile's version, valid
+ * bit and overhead and the PON-TAG. In O2-3 it also derives the keys, which
+ * need the PON-TAG. Only one to our own ONU-ID is acknowledged.
+ */
+static void pmac_x_burst_profile(struct pmac *mac, const u8 *m)
+{
+	struct en7581_pon_burst_profile bp = {
+		.fec = OCT(m, 6) & BP_FEC,
+		.delimiter_len = OCT(m, 7),
+		.preamble_len = OCT(m, 16),
+		.preamble_repeat = OCT(m, 17),
+	};
+	unsigned int n = FIELD_GET(BP_INDEX, OCT(m, 5));
+	unsigned int state = mac->o.state;
+	u32 len, shift;
+	int err;
+
+	if (state != PMAC_O2 && state != PMAC_O4 && state != PMAC_O5)
+		return;
+
+	memcpy(bp.delimiter, &OCT(m, 8), sizeof(bp.delimiter));
+	memcpy(bp.preamble, &OCT(m, 18), sizeof(bp.preamble));
+	len = bp.preamble_len * bp.preamble_repeat + bp.delimiter_len;
+
+	/*
+	 * The PHY first, as it can refuse the profile: one it refused is
+	 * neither marked valid nor acknowledged, and the PHY and the MAC keep
+	 * the profile they had.
+	 */
+	err = en7581_pon_phy_set_burst_profile(mac->phy, n, &bp);
+	if (err) {
+		dev_warn(mac->dev, "burst profile %u: the PHY refused it: %d\n",
+			 n, err);
+		return;
+	}
+
+	shift = 8 * n;
+	pmac_x_rmw(mac, REG_X_PROFILE,
+		   (REG_X_PROFILE_VERSION | REG_X_PROFILE_VALID) << shift,
+		   (FIELD_PREP(REG_X_PROFILE_VERSION,
+			       FIELD_GET(BP_VERSION, OCT(m, 5))) |
+		    REG_X_PROFILE_VALID) << shift);
+	shift = 16 * (n % 2);
+	pmac_x_rmw(mac, REG_X_PROFILE_LEN(n), 0xffffU << shift,
+		   (len & 0xffff) << shift);
+	writel(get_unaligned_be32(&OCT(m, 30)), mac->xgs + REG_X_PON_TAG_LO);
+	writel(get_unaligned_be32(&OCT(m, 26)), mac->xgs + REG_X_PON_TAG_HI);
+
+	if (state == PMAC_O2)
+		pmac_x_derive_keys(mac, &OCT(m, 26));
+	if (pmac_x_to_us(mac, m))
+		pmac_x_ack(mac, m);
+}
+
+/*
+ * Assign ONU-ID naming our serial number. In O2-3: the ONU-ID, and the OMCC,
+ * the XGEM port of the same number, then O4 with TO1 running; an OMCC still
+ * open from before TO1 took O4 back to O2-3, for another ONU-ID, is closed.
+ * In O4 or O5, another ONU-ID than ours: the ports are closed, the T-CONTs
+ * and the key exchange go and the ONU waits in O1, the MAC running and the
+ * old ONU-ID still in it, until the downstream is lost and found again.
+ */
+static void pmac_x_assign_onu(struct pmac *mac, const u8 *m)
+{
+	struct pmac_onu *o = &mac->o;
+	u16 id = get_unaligned_be16(&OCT(m, 5)) & XPLOAM_ONU;
+
+	if (memcmp(&OCT(m, 7), mac->sn, PMAC_SN_LEN))
+		return;
+
+	switch (o->state) {
+	case PMAC_O2:
+		if (id > XPLOAM_MAX_ONU)
+			return;
+		pmac_x_rmw(mac, REG_X_ONU, REG_X_ONU_VALID | REG_X_ONU_NUM,
+			   REG_X_ONU_VALID | FIELD_PREP(REG_X_ONU_NUM, id));
+		o->onu_id = id;
+		o->onu_valid = true;
+
+		pmac_ports_changing(mac);
+		if (o->omcc_valid && o->omcc != id)
+			pmac_x_port_cmd(mac, o->omcc, 0);
+		pmac_x_port_cmd(mac, id, REG_X_PORT_CMD_VALID |
+					 REG_X_PORT_CMD_UNICAST);
+		o->omcc = id;
+		o->omcc_valid = true;
+		pmac_ports_changed(mac);
+		pmac_tcont_open(mac, PMAC_OMCC_TCONT, AIROHA_PON_TCONT_NONBLOCK);
+
+		pmac_x_set_state(mac, PMAC_O4);
+		pmac_timer_arm(&o->to1, PMAC_TO1_MS);
+		break;
+	case PMAC_O4:
+	case PMAC_O5:
+		if (id == o->onu_id)
+			return;
+		pmac_x_close_ports(mac);
+		pmac_datapath_down(mac);
+		pmac_x_keys_drop(mac);
+		pmac_x_free_slots(mac);
+		pmac_x_set_state(mac, PMAC_O1);
+		o->await_loss = true;
+		break;
+	}
+}
+
+/*
+ * Ranging Time to our ONU-ID. The MAC counts the equalisation delay in
+ * quarters of the message's unit. An absolute delay in O4 completes
+ * ranging; one in O5 replaces the delay. A step in O5 moves the delay.
+ * All three are acknowledged, as G.9807.1 asks of a Ranging Time to our
+ * ONU-ID in O5. An OLT that hears no
+ * acknowledgment may send the step again, under a new sequence number,
+ * and the step would be applied twice.
+ */
+static void pmac_x_ranging_time(struct pmac *mac, const u8 *m)
+{
+	struct pmac_onu *o = &mac->o;
+	u32 delay = 4 * get_unaligned_be32(&OCT(m, 6));
+	u32 eqd;
+
+	if (!pmac_x_to_us(mac, m))
+		return;
+
+	if (!(OCT(m, 5) & XRT_ABSOLUTE)) {
+		if (o->state != PMAC_O5)
+			return;
+		eqd = readl(mac->xgs + REG_X_EQD);
+		eqd = OCT(m, 5) & XRT_NEGATIVE ? eqd - delay : eqd + delay;
+		writel(eqd, mac->xgs + REG_X_EQD);
+		pmac_x_ack(mac, m);
+		return;
+	}
+
+	if (o->state != PMAC_O4 && o->state != PMAC_O5)
+		return;
+
+	writel(delay, mac->xgs + REG_X_EQD);
+	if (o->state == PMAC_O4)
+		pmac_x_operation(mac);
+	pmac_x_ack(mac, m);
+}
+
+/* Deactivate ONU-ID: the ONU-ID gone, and back to O2-3 if it can. */
+static void pmac_x_deactivate(struct pmac *mac)
+{
+	if (mac->o.state != PMAC_O4 && mac->o.state != PMAC_O5)
+		return;
+
+	pmac_x_restart(mac);
+}
+
+/*
+ * Disable Serial Number. Disabling this ONU, or every ONU, takes O2-3, O4
+ * or O5 to O7 with the laser off and the key exchange ended, and nothing
+ * else; enabling it takes O7 through a teardown back to O2-3 with the
+ * laser on. 0x3f in O2-3 turns the laser off and nothing else, and nothing
+ * but O7 and back turns it on again.
+ */
+static void pmac_x_disable_sn(struct pmac *mac, const u8 *m)
+{
+	bool ours = !memcmp(&OCT(m, 6), mac->sn, PMAC_SN_LEN);
+	unsigned int state = mac->o.state;
+
+	switch (OCT(m, 5)) {
+	case XDSN_DISABLE:
+		if (!ours)
+			return;
+		fallthrough;
+	case XDSN_DISABLE_ALL:
+		if (state != PMAC_O2 && state != PMAC_O4 && state != PMAC_O5)
+			return;
+		airoha_pon_set_carrier(mac->pon, false);
+		pmac_x_set_state(mac, PMAC_O7);
+		en7581_pon_phy_set_transmitter(mac->phy, false);
+		pmac_x_keys_drop(mac);
+		break;
+	case XDSN_ENABLE:
+		if (!ours)
+			return;
+		fallthrough;
+	case XDSN_ENABLE_ALL:
+		if (state != PMAC_O7)
+			return;
+		pmac_x_restart(mac);
+		en7581_pon_phy_set_transmitter(mac->phy, true);
+		break;
+	case XDSN_DISCOVERY_OFF:
+		if (state == PMAC_O2)
+			en7581_pon_phy_set_transmitter(mac->phy, false);
+		break;
+	}
+}
+
+/*
+ * Request Registration, in O5 only (G.9807.1 Table C.12.4 ignores it in
+ * O4, where a ranging grant brings the Registration): the registration ID,
+ * once. If no ranging grant in O4 has checked the key sets since the probe,
+ * the driver moves to key set A here instead, and only once. After a master
+ * session key, PLOAM and the key encryption key move to its set here
+ * instead, the MAC told the PLOAM one, and only at the first Request
+ * Registration after the key (pmac_x_set_msk()).
+ * Registration uses key index 0 rather than the negotiated PLOAM key set.
+ */
+static void pmac_x_request_registration(struct pmac *mac, const u8 *m)
+{
+	struct pmac_onu *o = &mac->o;
+	u8 msg[XPLOAM_UP_NBYTES];
+
+	if (o->state != PMAC_O5)
+		return;
+
+	if (o->msk_switch) {
+		o->ploam_set = o->msk_set;
+		o->kek_set = o->msk_set;
+		pmac_x_rmw(mac, REG_X_KEY_SET, REG_X_KEY_SET_PLOAM_B,
+			   o->msk_set == X_KEY_SET_B ? REG_X_KEY_SET_PLOAM_B : 0);
+		o->msk_switch = false;
+		o->set_checked = true;
+	} else if (!o->set_checked) {
+		pmac_x_use_set(mac, X_KEY_SET_A);
+		o->set_checked = true;
+	}
+
+	pmac_x_build(mac, m, XUP_REGISTRATION, mac->reg_id, PMAC_REG_ID_LEN,
+		     msg);
+	pmac_x_send(mac, msg, X_KEY_SET_A);
+	memzero_explicit(msg, sizeof(msg));
+}
+
+/*
+ * Assign Alloc-ID to our ONU-ID, in O5, acknowledged first. An XGEM Alloc-ID
+ * takes the lowest free T-CONT slot, opens the frame engine's T-CONT of
+ * that slot and shares the packet buffers out among the open T-CONTs; a
+ * de-allocation closes it and frees the slot, and leaves the share as it
+ * was. The default Alloc-ID, the ONU-ID, has no slot.
+ */
+static void pmac_x_assign_alloc(struct pmac *mac, const u8 *m)
+{
+	struct pmac_onu *o = &mac->o;
+	u16 alloc = get_unaligned_be16(&OCT(m, 5)) & REG_X_TCONT_CMD_ALLOC;
+	unsigned int slot;
+
+	if (o->state != PMAC_O5)
+		return;
+
+	pmac_x_ack(mac, m);
+	if (alloc == o->onu_id)
+		return;
+
+	for_each_set_bit(slot, &o->slots, PMAC_SLOTS)
+		if (o->alloc[slot] == alloc)
+			break;
+
+	switch (OCT(m, 7)) {
+	case XALLOC_XGEM:
+		if (slot < PMAC_SLOTS)
+			return;
+		slot = find_next_zero_bit(&o->slots, PMAC_SLOTS, 1);
+		if (slot >= PMAC_SLOTS) {
+			dev_warn(mac->dev, "no T-CONT slot left for Alloc-ID %#x\n",
+				 alloc);
+			return;
+		}
+		pmac_x_write_slot(mac, slot, alloc, true);
+		o->alloc[slot] = alloc;
+		__set_bit(slot, &o->slots);
+		if (!pmac_tcont_open(mac, slot, 0))
+			airoha_pon_buf_budget(mac->pon, false);
+		break;
+	case XALLOC_DEALLOCATE:
+		if (slot >= PMAC_SLOTS)
+			return;
+		pmac_tcont_close(mac, slot);
+		fsleep(PMAC_RETIRE_US);
+		pmac_x_write_slot(mac, slot, PMAC_X_SLOT_FREE, false);
+		__clear_bit(slot, &o->slots);
+		break;
+	default:
+		return;
+	}
+
+	/* the GEM ports and T-CONT entries that name the Alloc-ID follow it */
+	pmac_push_gems(mac);
+	pmac_sync_tconts(mac);
+	pmac_nl_notify(mac);
+}
+
+/*
+ * Key Control generating key @k: a random key into the MAC and up to the
+ * OLT in Key Report, encrypted under the key encryption key of the
+ * driver's key set and sent under its PLOAM key set, again every 20 ms
+ * until the OLT confirms it. The 100 ms timer runs from here.
+ */
+static void pmac_x_key_generate(struct pmac *mac, const u8 *m, unsigned int k)
+{
+	struct pmac_onu *o = &mac->o;
+	u8 content[4 + AES_BLOCK_SIZE] = {};
+	u8 key[AES_KEYSIZE_128];
+	struct crypto_aes_ctx aes;
+
+	/*
+	 * A key not yet confirmed is not replaced: Key Report goes again with
+	 * this message's sequence number and key index but the key already
+	 * reported, and the 100 ms timer runs on.
+	 */
+	if (o->x_keys == PMAC_X_KEYS_REPORTED) {
+		o->report[3] = OCT(m, 4);
+		o->report[XPLOAM_CONTENT + 1] = k + 1;
+		goto report;
+	}
+
+	pmac_timer_arm(&o->key_a, PMAC_X_KEY_A_MS);
+
+	get_random_bytes(key, sizeof(key));
+	pmac_x_put_key(mac, REG_X_KEY(k), key);
+	memcpy(o->x_key[k], key, sizeof(key));
+
+	/* a new key, its index, fragment 0 */
+	content[1] = k + 1;
+	aes_expandkey(&aes, o->kek[o->kek_set], sizeof(o->kek[0]));
+	aes_encrypt(&aes, content + 4, key);
+	memzero_explicit(&aes, sizeof(aes));
+	memzero_explicit(key, sizeof(key));
+
+	pmac_x_build(mac, m, XUP_KEY_REPORT, content, sizeof(content),
+		     o->report);
+	memzero_explicit(content, sizeof(content));
+	o->x_keys = PMAC_X_KEYS_REPORTED;
+
+report:
+	o->report_set = o->ploam_set;
+	pmac_x_send(mac, o->report, o->report_set);
+
+	pmac_x_rmw(mac, REG_X_DS_KEYS, 0, BIT(k));
+	pmac_timer_arm(&o->key_b, PMAC_X_KEY_B_MS);
+}
+
+/*
+ * The name of key @k, for Key Report: MIC engine A's AES-CMAC of the key
+ * followed by the 16 ASCII digits below, using the driver's key encryption
+ * key set. A wait that runs out leaves whatever the result holds, and Key
+ * Report is still sent.
+ */
+static void pmac_x_key_name(struct pmac *mac, unsigned int k, u8 *name)
+{
+	static const char name_tail[AES_KEYSIZE_128] __nonstring = "3141592653589793";
+	void __iomem *status = mac->xgs + REG_X_IRQ_STATUS;
+	u8 *res = mac->mic + PMAC_X_MIC_RESULT;
+	u32 val;
+
+	memcpy(mac->mic, mac->o.x_key[k], AES_KEYSIZE_128);
+	memcpy(mac->mic + AES_KEYSIZE_128, name_tail, sizeof(name_tail));
+	memset(res, 0, PMAC_X_MIC_RESULT_LEN);
+
+	pmac_x_rmw(mac, REG_X_MIC_CFG, REG_X_MIC_CFG_KEY | REG_X_MIC_CFG_MODE,
+		   FIELD_PREP(REG_X_MIC_CFG_KEY,
+			      X_MIC_KEY_KEK(mac->o.kek_set)));
+	writel(FIELD_PREP(REG_X_MIC_LEN_MSG, PMAC_X_MIC_MSG_LEN) |
+	       FIELD_PREP(REG_X_MIC_LEN_RESULT, PMAC_X_MIC_RESULT_LEN),
+	       mac->xgs + REG_X_MIC_LEN);
+	writel(X_MIC_ADDR(mac->mic_dma), mac->xgs + REG_X_MIC_MSG);
+	writel(X_MIC_ADDR(mac->mic_dma + PMAC_X_MIC_RESULT),
+	       mac->xgs + REG_X_MIC_RESULT);
+	writel(X_IRQ_MIC_DONE, status);
+	pmac_x_rmw(mac, REG_X_MIC_START, 0, REG_X_MIC_START_GO);
+
+	if (readl_poll_timeout(status, val, val & X_IRQ_MIC_DONE, 1,
+			       PMAC_X_MIC_TIMEOUT_US)) {
+		dev_warn(mac->dev, "the key name was not computed\n");
+	} else {
+		writel(X_IRQ_MIC_DONE, status);
+		if (read_poll_timeout(READ_ONCE, val, val == 1, 1,
+				      PMAC_X_MIC_TIMEOUT_US, false,
+				      res[PMAC_X_MIC_RESULT_LEN - 1]))
+			dev_warn(mac->dev, "the key name was not written\n");
+		dma_rmb();
+	}
+	memcpy(name, res, AES_KEYSIZE_128);
+	memzero_explicit(mac->mic, PMAC_X_MIC_MSG_LEN);
+}
+
+/*
+ * Key Control confirming key @k: Key Report stops, the upstream switches to
+ * the key, and the other key goes. Wait a fixed 3 ms whether or not the
+ * MAC reports the switch. Then the
+ * key's name goes up in one Key Report, and the 100 ms timer stops.
+ */
+static void pmac_x_key_confirm(struct pmac *mac, const u8 *m, unsigned int k)
+{
+	void __iomem *status = mac->xgs + REG_X_IRQ_STATUS;
+	struct pmac_onu *o = &mac->o;
+	u8 content[4 + AES_KEYSIZE_128] = {};
+	u8 msg[XPLOAM_UP_NBYTES];
+
+	pmac_timer_stop(&o->key_b);
+	memzero_explicit(o->report, sizeof(o->report));
+	writel(X_IRQ_KEY_SWITCHED, status);
+	pmac_x_rmw(mac, REG_X_US_KEY, REG_X_US_KEY_SECOND,
+		   k ? REG_X_US_KEY_SECOND : 0);
+	pmac_x_rmw(mac, REG_X_US_KEY, 0, REG_X_US_KEY_VALID);
+	fsleep(PMAC_X_KEY_SWITCH_US);
+	writel(X_IRQ_KEY_SWITCHED, status);
+
+	pmac_x_rmw(mac, REG_X_DS_KEYS, REG_X_DS_KEYS_ALL, BIT(k));
+	pmac_x_put_key(mac, REG_X_KEY(!k), NULL);
+	memzero_explicit(o->x_key[!k], sizeof(o->x_key[0]));
+
+	/* the name of an existing key, its index, fragment 0 */
+	content[0] = 1;
+	content[1] = k + 1;
+	pmac_x_key_name(mac, k, content + 4);
+	pmac_x_build(mac, m, XUP_KEY_REPORT, content, sizeof(content), msg);
+	pmac_x_send(mac, msg, o->ploam_set);
+	pmac_timer_stop(&o->key_a);
+	o->x_keys = PMAC_X_KEYS_CONFIRMED;
+}
+
+static void pmac_x_key_control(struct pmac *mac, const u8 *m)
+{
+	unsigned int idx = OCT(m, 7);
+
+	if (mac->o.state != PMAC_O5 || idx < 1 || idx > XKC_KEYS)
+		return;
+
+	switch (OCT(m, 6)) {
+	case XKC_GENERATE:
+		/* no key encryption key to send it under */
+		if (!mac->o.ik_valid) {
+			dev_warn_ratelimited(mac->dev, "Key Control: the keys were not derived, no key made\n");
+			break;
+		}
+		pmac_x_key_generate(mac, m, idx - 1);
+		break;
+	case XKC_CONFIRM:
+		/* with no key reported since the last one ran out */
+		if (mac->o.x_keys != PMAC_X_KEYS_NONE)
+			pmac_x_key_confirm(mac, m, idx - 1);
+		break;
+	}
+}
+
+/*
+ * Reboot ONU: rebooting is the management side's, which reboot-ntf tells.
+ * A broadcast one naming another ONU's serial number is passed on all the
+ * same, but marked: G.9807.1 inspects the serial
+ * number only in a broadcast, and one of zero addresses every ONU.
+ */
+static void pmac_x_reboot(struct pmac *mac, const u8 *m)
+{
+	static const u8 any[PMAC_SN_LEN];
+	u16 dest = get_unaligned_be16(m) & XPLOAM_ONU;
+	bool other;
+
+	if (OCT(m, 13) > XREBOOT_DEPTH || OCT(m, 14) > XREBOOT_IMAGE ||
+	    OCT(m, 15) > XREBOOT_STATE)
+		return;
+
+	other = (dest == XPLOAM_BROADCAST || dest == XPLOAM_BROADCAST_ALT) &&
+		memcmp(&OCT(m, 5), any, PMAC_SN_LEN) &&
+		memcmp(&OCT(m, 5), mac->sn, PMAC_SN_LEN);
+
+	dev_notice(mac->dev, "the OLT asks for a reboot: depth %u, image %u, state condition %u%s\n",
+		   OCT(m, 13), OCT(m, 14), OCT(m, 15),
+		   other ? ", of another ONU" : "");
+	pmac_nl_reboot(mac, m, other);
+}
+
+/*
+ * Whether downstream message @m carries the MIC G.9807.1 asks for: under
+ * the default PLOAM integrity key, or, sent to our own ONU-ID once the keys
+ * are derived, under our own. Which of the two the OLT uses for a message
+ * to us after Registration, the driver does not track; either passes, and
+ * a broadcast message passes only under the default key. So does the
+ * master session key's, once one is set: the OLT moves to it at a
+ * Registration exchange the driver does not see the end of.
+ */
+static bool pmac_x_ploam_mic_ok(struct pmac *mac, const u8 *m)
+{
+	const u8 *mic = m + XPLOAM_UP_NBYTES;
+	struct pmac_onu *o = &mac->o;
+
+	if (pmac_x_mic_ok(pmac_x_default_ik, m, XPLOAM_UP_NBYTES, mic,
+			  XPLOAM_MIC_LEN))
+		return true;
+
+	if (!o->ik_valid || !pmac_x_to_us(mac, m))
+		return false;
+
+	return pmac_x_mic_ok(o->ploam_mic_key, m, XPLOAM_UP_NBYTES, mic,
+			     XPLOAM_MIC_LEN) ||
+	       (o->msk_valid &&
+		pmac_x_mic_ok(o->msk_ploam_key, m, XPLOAM_UP_NBYTES, mic,
+			      XPLOAM_MIC_LEN));
+}
+
+/*
+ * Count a downstream message of @type that passed the destination and MIC
+ * checks, for G.988's XG-PON downstream management PM: each type the class
+ * counts, whether broadcast or to this ONU, and whatever the driver then
+ * does with it.
+ */
+static void pmac_x_count_down(struct pmac *mac, u8 type)
+{
+	static const u8 counted[] = {
+		[XDN_BURST_PROFILE] = PMAC_XM_RX_PROFILE + 1,
+		[XDN_ASSIGN_ONU_ID] = PMAC_XM_RX_ASSIGN_ONU + 1,
+		[XDN_RANGING_TIME] = PMAC_XM_RX_RANGING_TIME + 1,
+		[XDN_DEACTIVATE_ONU_ID] = PMAC_XM_RX_DEACTIVATE + 1,
+		[XDN_DISABLE_SERIAL_NUMBER] = PMAC_XM_RX_DISABLE_SN + 1,
+		[XDN_REQUEST_REGISTRATION] = PMAC_XM_RX_REQUEST_REG + 1,
+		[XDN_ASSIGN_ALLOC_ID] = PMAC_XM_RX_ASSIGN_ALLOC + 1,
+		[XDN_KEY_CONTROL] = PMAC_XM_RX_KEY_CONTROL + 1,
+		[XDN_SLEEP_ALLOW] = PMAC_XM_RX_SLEEP_ALLOW + 1,
+	};
+
+	if (type < ARRAY_SIZE(counted) && counted[type])
+		mac->o.x_msgs[counted[type] - 1]++;
+}
+
+/*
+ * One downstream message. The MAC's own MIC check (ploam-mic-drop) stays
+ * off; the driver checks the MIC of every message
+ * addressed to it, and drops one that fails.
+ */
+static void pmac_x_ploam(struct pmac *mac, const u8 *m)
+{
+	u16 dest = get_unaligned_be16(m) & XPLOAM_ONU;
+
+	if (dest != XPLOAM_BROADCAST && dest != XPLOAM_BROADCAST_ALT &&
+	    !pmac_x_to_us(mac, m))
+		return;
+
+	if (!pmac_x_ploam_mic_ok(mac, m)) {
+		dev_warn_ratelimited(mac->dev,
+				     "PLOAM type %#x to ONU-ID %#x: bad MIC, dropped\n",
+				     OCT(m, 3), dest);
+		return;
+	}
+
+	pmac_x_count_down(mac, OCT(m, 3));
+
+	switch (OCT(m, 3)) {
+	case XDN_BURST_PROFILE:
+		pmac_x_burst_profile(mac, m);
+		break;
+	case XDN_ASSIGN_ONU_ID:
+		pmac_x_assign_onu(mac, m);
+		break;
+	case XDN_RANGING_TIME:
+		pmac_x_ranging_time(mac, m);
+		break;
+	case XDN_DEACTIVATE_ONU_ID:
+		pmac_x_deactivate(mac);
+		break;
+	case XDN_DISABLE_SERIAL_NUMBER:
+		pmac_x_disable_sn(mac, m);
+		break;
+	case XDN_REQUEST_REGISTRATION:
+		if (pmac_x_to_us(mac, m))
+			pmac_x_request_registration(mac, m);
+		break;
+	case XDN_ASSIGN_ALLOC_ID:
+		if (pmac_x_to_us(mac, m))
+			pmac_x_assign_alloc(mac, m);
+		break;
+	case XDN_KEY_CONTROL:
+		if (pmac_x_to_us(mac, m))
+			pmac_x_key_control(mac, m);
+		break;
+	case XDN_REBOOT_ONU:
+		pmac_x_reboot(mac, m);
+		break;
+	default:
+		/*
+		 * Sleep Allow needs nothing from this ONU, nor do the
+		 * wavelength, protection, power and rate messages in XGS-PON.
+		 */
+		break;
+	}
+}
+
+static void pmac_x_ploam_drain(struct pmac *mac)
+{
+	unsigned int budget = PLOAM_BUDGET;
+	u8 m[XPLOAM_NBYTES];
+	unsigned int i;
+
+	while (budget-- &&
+	       FIELD_GET(REG_X_DOWN_WORDS,
+			 readl(mac->xgs + REG_X_DOWN_LEVEL)) >= XPLOAM_DOWN_WORDS) {
+		for (i = 0; i < XPLOAM_NBYTES / 4; i++)
+			put_unaligned_be32(readl(mac->xgs + REG_X_DOWN_MSG),
+					   m + 4 * i);
+		/* the status word: what its bits say is not known */
+		readl(mac->xgs + REG_X_DOWN_MSG);
+		pmac_x_ploam(mac, m);
+	}
+}
+
+/*
+ * A ranging grant in O4: the key sets the MAC reports, PLOAM and OMCI. If
+ * both differ from the driver's, all three of the driver's go to set A;
+ * otherwise none moves. Either way Request Registration no longer moves
+ * them. What the MAC reports here is not known without an OLT.
+ */
+static void pmac_x_ranging_grant(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	u32 idx;
+
+	if (o->state != PMAC_O4)
+		return;
+
+	idx = readl(mac->xgs + REG_X_KEY_INDEX);
+	if (FIELD_GET(REG_X_KEY_INDEX_PLOAM, idx) != o->ploam_set &&
+	    FIELD_GET(REG_X_KEY_INDEX_OMCI, idx) != o->omci_set)
+		pmac_x_use_set(mac, X_KEY_SET_A);
+	o->set_checked = true;
+}
+
+static irqreturn_t pmac_xgs_irq(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	u32 pending;
+
+	mutex_lock(&o->lock);
+
+	pending = readl(mac->xgs + REG_X_IRQ_STATUS) &
+		  readl(mac->xgs + REG_X_IRQ_ENABLE);
+	if (!pending) {
+		mutex_unlock(&o->lock);
+		return IRQ_NONE;
+	}
+	writel(pending, mac->xgs + REG_X_IRQ_STATUS);
+
+	writel(~0U, mac->xgs + REG_X_QUEUE_ERR);
+	writel(~0U, mac->xgs + REG_X_TX_ERR);
+	writel(~0U, mac->xgs + REG_X_RX_ERR);
+	writel(~0U, mac->xgs + REG_X_MAP_ERR);
+
+	if (o->running && !READ_ONCE(mac->pf)) {
+		/* one each: two sent before the handler ran count as one */
+		if (pending & X_IRQ_SN_SENT)
+			o->x_msgs[PMAC_XM_TX_SERIAL_NUMBER]++;
+		if (pending & X_IRQ_REG_SENT)
+			o->x_msgs[PMAC_XM_TX_REGISTRATION]++;
+		if (pending & X_IRQ_RANGING)
+			pmac_x_ranging_grant(mac);
+		if (pending & X_IRQ_PLOAM)
+			pmac_x_ploam_drain(mac);
+	}
+
+	mutex_unlock(&o->lock);
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * Mask the interrupts of the MAC that is not running, when it is the one
+ * holding the line. The other MAC may still be set up
+ * by an earlier start in this boot, or by the kernel that ran before this
+ * one, and the line is level-triggered. Its next start masks and enables
+ * them again.
+ */
+static irqreturn_t pmac_quiet_idle(struct pmac *mac, enum pmac_line line)
+{
+	void __iomem *base = line == PMAC_GPON ? mac->xgs : mac->gpon;
+	u32 enable = line == PMAC_GPON ? REG_X_IRQ_ENABLE : REG_G_IRQ_ENABLE;
+	u32 status = line == PMAC_GPON ? REG_X_IRQ_STATUS : REG_G_IRQ_STATUS;
+
+	if (!(readl(base + status) & readl(base + enable)))
+		return IRQ_NONE;
+
+	pmac_mask_irqs(base + enable, base + status);
+	dev_info(mac->dev, "masked the idle %s MAC's interrupts\n",
+		 pmac_line_names[line == PMAC_GPON ? PMAC_XGS : PMAC_GPON]);
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * The MAC interrupt. One line carries both MACs' interrupts, and the
+ * running MAC's handler takes it: the line is enabled only
+ * from after @line is set until pmac_halt().
+ */
+static irqreturn_t pmac_mac_irq(int irq, void *data)
+{
+	struct pmac *mac = data;
+	enum pmac_line line = READ_ONCE(mac->line);
+	irqreturn_t ret;
+
+	if (line == PMAC_GPON)
+		ret = pmac_gpon_irq(mac);
+	else if (line == PMAC_XGS)
+		ret = pmac_xgs_irq(mac);
+	else
+		return IRQ_NONE;
+
+	if (ret == IRQ_NONE)
+		ret = pmac_quiet_idle(mac, line);
+
+	return ret;
+}
+
+/*
+ * Loss of signal in O5 moves to O6 with TO2 running and the PHY side of the
+ * MAC's traffic stopped, and Key Report held: key timer B stops, timer A
+ * runs on. Before ranging completes it is back to O1, as G.9807.1 has it.
+ * In O1 after a new ONU-ID it is the loss the ONU waited for.
+ */
+static void pmac_x_lost(struct pmac *mac)
+{
+	mac->o.await_loss = false;
+
+	switch (mac->o.state) {
+	case PMAC_O5:
+		mac->o.x_msgs[PMAC_XM_LODS]++;
+		pmac_x_set_state(mac, PMAC_O6);
+		airoha_pon_set_carrier(mac->pon, false);
+		pmac_timer_stop(&mac->o.key_b);
+		pmac_timer_arm(&mac->o.to2, PMAC_TO2_MS);
+		pmac_x_stop_pair(mac, X_STOP_PHY, X_STOP_PHY_DONE);
+		/* PHY loss in O5: retire all channels at the reset transition */
+		airoha_pon_retire_all(mac->pon);
+		break;
+	case PMAC_O2:
+	case PMAC_O4:
+		pmac_x_teardown(mac);
+		break;
+	}
+}
+
+/*
+ * The downstream ready: in O1 the bring-up to O2-3, unless the ONU waits
+ * for a loss first. In O6, before TO2 runs out, back to O5 under everything
+ * O5 had: TO2 stopped, the PHY-side stop requests released, O5.
+ * A key still reported then goes up
+ * again every 20 ms. A second loss in O6 changed nothing (pmac_x_lost()).
+ */
+static void pmac_x_ready(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+
+	if (o->state == PMAC_O1 && !o->await_loss) {
+		pmac_x_standby(mac);
+	} else if (o->state == PMAC_O6) {
+		o->x_msgs[PMAC_XM_LODS_RESTORED]++;
+		pmac_timer_stop(&o->to2);
+		pmac_x_rmw(mac, REG_X_IF_STOP, X_STOP_PHY, 0);
+		/* downstream ready in O6: retire all channels at the reset transition */
+		airoha_pon_retire_all(mac->pon);
+		pmac_x_operation(mac);
+		if (o->x_keys == PMAC_X_KEYS_REPORTED)
+			pmac_timer_arm(&o->key_b, PMAC_X_KEY_B_MS);
+	}
+}
+
+/* TO1: in O4 back to O2-3, and nothing else; in O5 nothing at all. */
+static void pmac_x_to1(struct pmac *mac)
+{
+	if (mac->o.state == PMAC_O4)
+		pmac_x_set_state(mac, PMAC_O2);
+}
+
+/*
+ * 100 ms after a key was made with no confirm (a confirm stops this
+ * timer): Key Report stops, and both keys go, an earlier confirmed one
+ * too.
+ */
+static void pmac_x_key_a_work(struct work_struct *work)
+{
+	struct pmac *mac = container_of(to_delayed_work(work), struct pmac,
+					o.key_a.work);
+	struct pmac_onu *o = &mac->o;
+
+	mutex_lock(&o->lock);
+	if (o->running && pmac_timer_expired(&o->key_a))
+		pmac_x_keys_drop(mac);
+	mutex_unlock(&o->lock);
+}
+
+/* Key Report again, until the OLT confirms the key. */
+static void pmac_x_key_b_work(struct work_struct *work)
+{
+	struct pmac *mac = container_of(to_delayed_work(work), struct pmac,
+					o.key_b.work);
+	struct pmac_onu *o = &mac->o;
+
+	mutex_lock(&o->lock);
+	if (o->running && pmac_timer_expired(&o->key_b)) {
+		pmac_x_send(mac, o->report, o->report_set);
+		pmac_timer_arm(&o->key_b, PMAC_X_KEY_B_MS);
+	}
+	mutex_unlock(&o->lock);
+}
+
+/*
+ * Loss of signal in O5 moves to O6 with TO2 running and restarts the MAC's
+ * logic with its interfaces stopped. Before ranging completes it is back
+ * to O1. Elsewhere it changes nothing.
+ */
+static void pmac_g_lost(struct pmac *mac)
+{
+	static const u8 release[PMAC_STOPS] = { 3, 1, 0, 2 };
+	unsigned int i;
+	u32 val;
+
+	switch (mac->o.state) {
+	case PMAC_O5:
+		pmac_g_rmw(mac, REG_G_CAP_CTRL, REG_G_CAP_CTRL_ALL, 0);
+		pmac_g_set_state(mac, PMAC_O6);
+		airoha_pon_set_carrier(mac->pon, false);
+		pmac_timer_arm(&mac->o.to2, PMAC_TO2_MS);
+
+		pmac_g_rmw(mac, REG_G_IF_STOP,
+			   GENMASK(31, 30) | BIT(24) | BIT(16) |
+			   GENMASK(9, 8) | GENMASK(1, 0), REG_G_IF_STOP_HOLD);
+		for (i = 0; i < PMAC_STOPS; i++) {
+			const struct pmac_if_stop *s =
+				&pmac_g_stops[pmac_g_lost_order[i]];
+
+			pmac_g_rmw(mac, REG_G_IF_STOP, s->done, s->request);
+			readl_poll_timeout(mac->gpon + REG_G_IF_STOP, val,
+					   val & s->done, 10,
+					   PMAC_STOP_TIMEOUT_US);
+		}
+		/*
+		 * What the logic reset does to the GEM port counters is not
+		 * known: count up to it, and from what they hold when O6 is
+		 * left for O5 (pmac_g_resettle()). Reading them takes
+		 * milliseconds a port, and TO2 is running.
+		 */
+		pmac_gem_fold(mac, true);
+		pmac_g_rmw(mac, REG_G_LOGIC, REG_G_LOGIC_RUN, 0);
+		udelay(PMAC_RESET_US);
+		pmac_g_rmw(mac, REG_G_LOGIC, 0, REG_G_LOGIC_RUN);
+		pmac_g_release(mac, release, PMAC_STOPS);
+		break;
+	case PMAC_O2:
+	case PMAC_O3:
+	case PMAC_O4:
+		pmac_g_to_o1(mac);
+		break;
+	}
+}
+
+static void pmac_link_work(struct work_struct *work)
+{
+	struct pmac *mac = container_of(work, struct pmac, o.link_work);
+	struct pmac_onu *o = &mac->o;
+	bool lost = xchg(&o->lost_seen, false);
+
+	mutex_lock(&o->lock);
+	if (!o->running || READ_ONCE(mac->pf)) {
+		mutex_unlock(&o->lock);
+		return;
+	}
+
+	if (READ_ONCE(mac->line) == PMAC_XGS) {
+		if (lost)
+			pmac_x_lost(mac);
+		if (READ_ONCE(mac->link) == PMAC_LINK_READY)
+			pmac_x_ready(mac);
+	} else {
+		if (lost)
+			pmac_g_lost(mac);
+		if (READ_ONCE(mac->link) == PMAC_LINK_READY &&
+		    o->state == PMAC_O1)
+			pmac_g_standby(mac);
+	}
+	mutex_unlock(&o->lock);
+}
+
+/*
+ * GPON TO1: ranging did not complete. Back to O2 with nothing else undone;
+ * the PMAC_TO1_TRIES-th time in a row the MAC starts over from its block
+ * reset.
+ */
+static void pmac_g_to1(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+
+	if (o->state != PMAC_O3 && o->state != PMAC_O4)
+		return;
+
+	if (--o->to1_left) {
+		pmac_g_enter_o2(mac);
+	} else {
+		o->to1_left = PMAC_TO1_TRIES;
+		pmac_g_to_o2(mac);
+	}
+}
+
+static void pmac_to1_work(struct work_struct *work)
+{
+	struct pmac *mac = container_of(to_delayed_work(work), struct pmac,
+					o.to1.work);
+	struct pmac_onu *o = &mac->o;
+
+	mutex_lock(&o->lock);
+	if (o->running && pmac_timer_expired(&o->to1)) {
+		if (READ_ONCE(mac->line) == PMAC_XGS)
+			pmac_x_to1(mac);
+		else
+			pmac_g_to1(mac);
+	}
+	mutex_unlock(&o->lock);
+}
+
+/*
+ * TO2: the OLT did not call the ONU back from O6. GPON: with the signal
+ * still lost, back to O1; with it back, straight on to O2 to range again.
+ * XGS-PON: the same, by whether the downstream is in sync.
+ */
+static void pmac_to2_work(struct work_struct *work)
+{
+	struct pmac *mac = container_of(to_delayed_work(work), struct pmac,
+					o.to2.work);
+	struct pmac_onu *o = &mac->o;
+	bool ready, light;
+
+	mutex_lock(&o->lock);
+	if (o->running && pmac_timer_expired(&o->to2) &&
+	    o->state == PMAC_O6) {
+		if (READ_ONCE(mac->line) == PMAC_XGS) {
+			o->x_msgs[PMAC_XM_LODS_REACTIVATED]++;
+			pmac_x_restart(mac);
+		} else if (!en7581_pon_phy_link(mac->phy, &ready, &light) &&
+			   light) {
+			pmac_g_to_o2(mac);
+		} else {
+			pmac_g_to_o1(mac);
+		}
+	}
+	mutex_unlock(&o->lock);
+}
+
+static void pmac_index_work(struct work_struct *work)
+{
+	struct pmac *mac = container_of(to_delayed_work(work), struct pmac,
+					o.index_refresh.work);
+	struct pmac_onu *o = &mac->o;
+
+	mutex_lock(&o->lock);
+	if (o->running && pmac_timer_expired(&o->index_refresh)) {
+		if (READ_ONCE(mac->line) == PMAC_XGS)
+			pmac_x_write_index(mac);
+		else
+			pmac_g_write_index(mac);
+	}
+	mutex_unlock(&o->lock);
+}
+
+static void pmac_watch_work(struct work_struct *work)
+{
+	struct pmac *mac = container_of(to_delayed_work(work), struct pmac,
+					o.watch.work);
+	struct pmac_onu *o = &mac->o;
+
+	mutex_lock(&o->lock);
+	if (o->running && pmac_timer_expired(&o->watch) &&
+	    o->watch_state == PMAC_WATCH_ON)
+		pmac_watch_tick(mac);
+	mutex_unlock(&o->lock);
+}
+
+static void pmac_buf_share_work(struct work_struct *work)
+{
+	struct pmac *mac = container_of(to_delayed_work(work), struct pmac,
+					o.buf_share.work);
+	struct pmac_onu *o = &mac->o;
+
+	mutex_lock(&o->lock);
+	if (o->running && pmac_timer_expired(&o->buf_share))
+		airoha_pon_buf_budget(mac->pon, false);
+	mutex_unlock(&o->lock);
+}
+
+/*
+ * A GPON MIB upload message from the OLT: the fixed packet buffer caps, and
+ * the OMCI watch started again unless it is running.
+ */
+static void pmac_mib_work(struct work_struct *work)
+{
+	struct pmac *mac = container_of(work, struct pmac, o.mib_work);
+	struct pmac_onu *o = &mac->o;
+
+	mutex_lock(&o->lock);
+	if (o->running && READ_ONCE(mac->line) != PMAC_XGS &&
+	    READ_ONCE(mac->omci_port) != PMAC_OMCI_NONE) {
+		airoha_pon_buf_budget(mac->pon, true);
+		if (o->watch_state != PMAC_WATCH_ON)
+			pmac_watch_start(mac);
+	}
+	mutex_unlock(&o->lock);
+}
+
+static void pmac_set_lines(struct gpio_descs *descs, bool on)
+{
+	DECLARE_BITMAP(values, 2);
+
+	if (!descs)
+		return;
+
+	bitmap_fill(values, descs->ndescs);
+	if (!on)
+		bitmap_zero(values, descs->ndescs);
+	gpiod_set_array_value_cansleep(descs->ndescs, descs->desc,
+				       descs->info, values);
+}
+
+/* Power only the optic of @line and route the fibre to it. */
+static void pmac_select_optic(struct pmac *mac, enum pmac_line line)
+{
+	DECLARE_BITMAP(power, 2);
+
+	if (!mac->power)
+		return;
+
+	bitmap_zero(power, 2);
+	if (line == PMAC_GPON)
+		__set_bit(OPTIC_GPON, power);
+	else if (line == PMAC_XGS)
+		__set_bit(OPTIC_XGS, power);
+	gpiod_set_array_value_cansleep(mac->power->ndescs, mac->power->desc,
+				       mac->power->info, power);
+	pmac_set_lines(mac->select, line == PMAC_XGS);
+}
+
+/*
+ * Start the laser driver with @line's calibration, when the board has one.
+ * Start with the optic powered, before the PHY and the MAC.
+ */
+static int pmac_laser_start(struct pmac *mac, enum pmac_line line)
+{
+	int err;
+
+	if (!mac->laser)
+		return 0;
+
+	err = phy_set_mode_ext(mac->laser, PHY_MODE_ETHERNET,
+			       line == PMAC_GPON ? EN7581_PON_GPON :
+						   EN7581_PON_XGSPON);
+	if (!err)
+		err = phy_power_on(mac->laser);
+	if (err) {
+		dev_err(mac->dev, "cannot start the laser driver for %s: %d\n",
+			pmac_line_names[line], err);
+		return err;
+	}
+
+	mac->laser_started = true;
+	return 0;
+}
+
+/* Stop the laser driver if it runs; that writes nothing to it. */
+static void pmac_laser_stop(struct pmac *mac)
+{
+	if (!mac->laser_started)
+		return;
+
+	phy_power_off(mac->laser);
+	mac->laser_started = false;
+}
+
+/* XGS-PON's rate select, set once the 10G MAC is up. */
+static int pmac_laser_xgs_rate(struct pmac *mac)
+{
+	int err;
+
+	if (!mac->laser)
+		return 0;
+
+	err = en7572_phy_set_xgspon_rate(mac->laser);
+	if (err)
+		dev_err(mac->dev, "cannot set the laser driver's rate: %d\n",
+			err);
+	return err;
+}
+
+/*
+ * Pick the line mode from the optic that sees light: power both optics
+ * with the fibre on the GPON optic, let them settle, start the laser driver
+ * for GPON, route the fibre to the XGS-PON optic, start the laser driver
+ * again for XGS-PON, read both loss-of-signal lines, the last of several
+ * readings counting, and stop the laser driver. Read the lines
+ * only with its laser driver started; whether they mean anything without it
+ * is not known. Light on the XGS-PON optic picks XGS-PON, then light
+ * on the GPON optic picks GPON. With no light anywhere pick XGS-PON,
+ * unless a line that lost its light is being
+ * tested: that line is kept. @dark says no optic saw light.
+ */
+static int pmac_detect(struct pmac *mac, enum pmac_line *line, bool *dark)
+{
+	DECLARE_BITMAP(power, 2);
+	DECLARE_BITMAP(los, 2);
+	unsigned int i;
+	int err;
+
+	if (!mac->power || !mac->los) {
+		dev_err(mac->dev, "no optics lines to choose a line mode from\n");
+		return -EINVAL;
+	}
+
+	bitmap_fill(power, 2);
+	gpiod_set_array_value_cansleep(mac->power->ndescs, mac->power->desc,
+				       mac->power->info, power);
+	pmac_set_lines(mac->select, false);
+	msleep(PMAC_DETECT_SETTLE_MS);
+	err = pmac_laser_start(mac, PMAC_GPON);
+	if (err)
+		return err;
+	pmac_set_lines(mac->select, true);
+	pmac_laser_stop(mac);
+	err = pmac_laser_start(mac, PMAC_XGS);
+	if (err)
+		return err;
+
+	for (i = 0; i < PMAC_DETECT_SAMPLES; i++) {
+		if (i)
+			msleep(PMAC_DETECT_INTERVAL_MS);
+		err = gpiod_get_array_value_cansleep(mac->los->ndescs,
+						     mac->los->desc,
+						     mac->los->info, los);
+		if (err)
+			break;
+	}
+	pmac_laser_stop(mac);
+	if (err)
+		return err;
+
+	*dark = test_bit(OPTIC_XGS, los) && test_bit(OPTIC_GPON, los);
+	if (*dark && mac->dark_line != PMAC_AUTO)
+		*line = mac->dark_line;
+	else if (!test_bit(OPTIC_XGS, los) || *dark)
+		*line = PMAC_XGS;
+	else
+		*line = PMAC_GPON;
+
+	if (!*dark)
+		dev_info(mac->dev, "light on the %s optic\n",
+			 pmac_line_names[*line]);
+	else if (!mac->guess)
+		dev_info(mac->dev, "light on neither optic, starting %s\n",
+			 pmac_line_names[*line]);
+
+	return 0;
+}
+
+/*
+ * Runs with the PHY's state locked, so the state machine, which calls back
+ * into the PHY, takes the report from a work item.
+ */
+static void pmac_link_report(void *data, enum en7581_pon_link_report report,
+			     bool polled)
+{
+	struct pmac *mac = data;
+	enum pmac_link link;
+
+	link = report == EN7581_PON_REPORT_READY ? PMAC_LINK_READY :
+						   PMAC_LINK_LOST;
+	if (link == PMAC_LINK_READY)
+		WRITE_ONCE(mac->lit, true);
+	if (link == PMAC_LINK_LOST)
+		WRITE_ONCE(mac->o.lost_seen, true);
+	if (READ_ONCE(mac->link) != link) {
+		WRITE_ONCE(mac->link, link);
+		pmac_lamp_update(mac);
+		sysfs_notify(&mac->dev->kobj, NULL, "link");
+		/* @redetect looks at a lit line that stays lost */
+		if (link == PMAC_LINK_LOST && READ_ONCE(mac->lit)) {
+			WRITE_ONCE(mac->lost_at, jiffies);
+			schedule_delayed_work(&mac->redetect,
+					      pmac_redetect_period(mac));
+		}
+	}
+
+	if (READ_ONCE(mac->line) != PMAC_AUTO)
+		queue_work(system_wq, &mac->o.link_work);
+}
+
+/* Read the FEC counters; add what they moved to the sums when @add. */
+static void pmac_fec_read(struct pmac *mac, bool add)
+{
+	struct pmac_fec *f = &mac->fec;
+	struct en7581_pon_fec_stats st;
+	u32 now[PMAC_FEC_NUM];
+	unsigned int i;
+
+	lockdep_assert_held(&f->lock);
+
+	if (en7581_pon_phy_fec_stats(mac->phy, &st))
+		return;
+
+	now[PMAC_FEC_BYTES] = st.corrected_bytes;
+	now[PMAC_FEC_FIXED] = st.corrected_words;
+	now[PMAC_FEC_LOST] = st.uncorrectable_words;
+	now[PMAC_FEC_WORDS] = st.total_words;
+	now[PMAC_FEC_SECS] = st.errored_seconds;
+
+	for (i = 0; i < PMAC_FEC_NUM; i++) {
+		if (add)
+			f->sum[i] += (u32)(now[i] - f->last[i]);
+		f->last[i] = now[i];
+	}
+}
+
+static void pmac_fec_work(struct work_struct *work)
+{
+	struct pmac *mac = container_of(to_delayed_work(work), struct pmac,
+					fec.work);
+
+	mutex_lock(&mac->fec.lock);
+	if (mac->fec.on) {
+		pmac_fec_read(mac, true);
+		schedule_delayed_work(&mac->fec.work,
+				      msecs_to_jiffies(PMAC_FEC_FOLD_MS));
+	}
+	mutex_unlock(&mac->fec.lock);
+}
+
+/*
+ * The PHY was powered on: count from what its registers hold now, whatever
+ * the power cycle did to them.
+ */
+static void pmac_fec_begin(struct pmac *mac)
+{
+	mutex_lock(&mac->fec.lock);
+	memset(mac->fec.last, 0, sizeof(mac->fec.last));
+	pmac_fec_read(mac, false);
+	mac->fec.on = true;
+	schedule_delayed_work(&mac->fec.work, msecs_to_jiffies(PMAC_FEC_FOLD_MS));
+	mutex_unlock(&mac->fec.lock);
+}
+
+/* The PHY is about to be powered off: keep what it counted. */
+static void pmac_fec_end(struct pmac *mac)
+{
+	cancel_delayed_work_sync(&mac->fec.work);
+
+	mutex_lock(&mac->fec.lock);
+	if (mac->fec.on)
+		pmac_fec_read(mac, true);
+	mac->fec.on = false;
+	mutex_unlock(&mac->fec.lock);
+}
+
+/* The FEC sums, brought up to date first. Takes mac->fec.lock. */
+static void pmac_fec_sums(struct pmac *mac, u64 *sum)
+{
+	struct pmac_fec *f = &mac->fec;
+
+	mutex_lock(&f->lock);
+	if (f->on)
+		pmac_fec_read(mac, true);
+	memcpy(sum, f->sum, sizeof(f->sum));
+	mutex_unlock(&f->lock);
+}
+
+/*
+ * An XGS-PON BER sample from the FEC sums at the start and the end of the
+ * interval: the bytes corrected, and PMAC_X_FEC_LOST_BYTES for each
+ * codeword that could not be, over the bits of the codewords received. A
+ * byte in error is one bit in error at least, so the count is a lower bound.
+ */
+static void pmac_x_ber_sample(const u64 *mark, const u64 *now, u32 *errors,
+			      u64 *bits)
+{
+	u64 e = now[PMAC_FEC_BYTES] - mark[PMAC_FEC_BYTES] +
+		(now[PMAC_FEC_LOST] - mark[PMAC_FEC_LOST]) *
+		PMAC_X_FEC_LOST_BYTES;
+
+	*errors = min_t(u64, e, U32_MAX);
+	*bits = (now[PMAC_FEC_WORDS] - mark[PMAC_FEC_WORDS]) *
+		PMAC_X_FEC_WORD_BITS;
+}
+
+/* XGS-PON O5: start the BER interval over from the FEC counters now. */
+static void pmac_x_ber_start(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+
+	pmac_fec_sums(mac, o->ber_mark);
+	o->ber_at = ktime_get();
+	pmac_timer_arm(&o->ber, PMAC_X_BER_MS);
+}
+
+/*
+ * GPON: a Remote Error Indication with the BIP errors since the last one
+ * and a 4-bit sequence number.
+ */
+static void pmac_g_ber(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	u8 data[PLOAM_NDATA] = {};
+	u32 errors;
+
+	if (!en7581_pon_phy_bip_errors(mac->phy, &errors)) {
+		put_unaligned_be32(errors, data);
+		data[4] = o->err_seq++ & 0xf;
+		pmac_g_send(mac, UP_REI, data, 1);
+		o->ber_seq++;
+		o->ber_errors = errors;
+		o->ber_bits = 0;
+		o->ber_last_ms = o->ber_ms;
+		pmac_nl_ber(mac);
+	}
+	pmac_timer_arm(&o->ber, o->ber_ms);
+}
+
+/*
+ * XGS-PON: the sample, and nothing to the OLT, as G.9807.1 has no Remote
+ * Error Indication. An interval that received no codeword has nothing to
+ * sample.
+ */
+static void pmac_x_ber(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	u64 now[PMAC_FEC_NUM];
+	ktime_t at = ktime_get();
+	u32 errors;
+	u64 bits;
+
+	pmac_fec_sums(mac, now);
+	pmac_x_ber_sample(o->ber_mark, now, &errors, &bits);
+	if (bits) {
+		o->ber_seq++;
+		o->ber_errors = errors;
+		o->ber_bits = bits;
+		o->ber_last_ms = clamp_t(s64, ktime_ms_delta(at, o->ber_at), 1,
+					 U32_MAX);
+		pmac_nl_ber(mac);
+	}
+	memcpy(o->ber_mark, now, sizeof(now));
+	o->ber_at = at;
+	pmac_timer_arm(&o->ber, PMAC_X_BER_MS);
+}
+
+/* The BER interval, in O5 only. */
+static void pmac_ber_work(struct work_struct *work)
+{
+	struct pmac *mac = container_of(to_delayed_work(work), struct pmac,
+					o.ber.work);
+	struct pmac_onu *o = &mac->o;
+
+	mutex_lock(&o->lock);
+	if (o->running && pmac_timer_expired(&o->ber) &&
+	    o->state == PMAC_O5) {
+		if (READ_ONCE(mac->line) == PMAC_XGS)
+			pmac_x_ber(mac);
+		else
+			pmac_g_ber(mac);
+	}
+	mutex_unlock(&o->lock);
+}
+
+/* Stop the state machine and wait out everything that runs it. */
+static void pmac_halt(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	struct pmac_timer *timers[] = {
+		&o->to1, &o->to2, &o->ber, &o->index_refresh, &o->key_a,
+		&o->key_b, &o->watch, &o->buf_share,
+	};
+	unsigned int i;
+
+	mutex_lock(&o->lock);
+	o->running = false;
+	mutex_unlock(&o->lock);
+
+	disable_irq(mac->irq);
+	cancel_work_sync(&o->link_work);
+	for (i = 0; i < ARRAY_SIZE(timers); i++) {
+		cancel_delayed_work_sync(&timers[i]->work);
+		timers[i]->armed = false;
+	}
+
+	mutex_lock(&o->lock);
+	o->watch_state = PMAC_WATCH_OFF;
+	pmac_datapath_down(mac);
+	mutex_unlock(&o->lock);
+	/* queued by OMCI frames, which the datapath going down stopped */
+	cancel_work_sync(&o->mib_work);
+}
+
+static void pmac_stop_locked(struct pmac *mac)
+{
+	/* not waited for: @redetect stops the line itself */
+	mac->guess = false;
+	mac->dark_line = PMAC_AUTO;
+	cancel_delayed_work(&mac->redetect);
+
+	if (mac->line == PMAC_AUTO)
+		return;
+
+	airoha_pon_set_carrier(mac->pon, false);
+	pmac_halt(mac);
+
+	/* no key stays in the MAC's registers or the driver's memory */
+	if (mac->line == PMAC_GPON) {
+		memzero_explicit(mac->o.key, sizeof(mac->o.key));
+		pmac_g_write_key(mac);
+		pmac_stop_interfaces(mac, mac->gpon + REG_G_IF_STOP,
+				     pmac_g_stops);
+		reset_control_assert(mac->reset);
+	} else {
+		pmac_x_keys_drop(mac);
+		pmac_x_wipe_sets(mac);
+		/* disconnect the active MAC */
+		pmac_x_free_slots(mac);
+		pmac_x_stop_mac(mac);
+		pmac_x_rmw(mac, REG_X_STATE, REG_X_STATE_NUM, PMAC_O1);
+		pmac_x_rmw(mac, REG_X_ONU, REG_X_ONU_VALID | REG_X_ONU_NUM,
+			   REG_X_ONU_NONE);
+	}
+
+	pmac_fec_end(mac);
+	phy_power_off(mac->phy);
+	en7581_pon_phy_set_link_handler(mac->phy, NULL, NULL);
+	cancel_work_sync(&mac->o.link_work);
+	phy_exit(mac->phy);
+	pmac_laser_stop(mac);
+	pmac_select_optic(mac, PMAC_AUTO);
+
+	WRITE_ONCE(mac->line, PMAC_AUTO);
+	WRITE_ONCE(mac->link, PMAC_LINK_NONE);
+	pmac_lamp_update(mac);
+
+	mutex_lock(&mac->o.lock);
+	pmac_nl_notify(mac);
+	mutex_unlock(&mac->o.lock);
+}
+
+/* A fresh state machine, at O1 once the MAC has connected. */
+static void pmac_onu_begin(struct pmac *mac, enum pmac_line line)
+{
+	struct pmac_onu *o = &mac->o;
+
+	mutex_lock(&o->lock);
+	o->onu_valid = false;
+	o->onu_id = line == PMAC_XGS ? REG_X_ONU_NONE : PLOAM_BROADCAST;
+	o->await_loss = false;
+	memzero_explicit(o->kek, sizeof(o->kek));
+	pmac_x_drop_msk(o);
+	memzero_explicit(o->x_key, sizeof(o->x_key));
+	o->x_keys = PMAC_X_KEYS_NONE;
+	memzero_explicit(o->report, sizeof(o->report));
+	o->sub_byte = 0;
+	o->slots = 0;
+	o->tconts = 0;
+	o->omcc_valid = false;
+	memzero_explicit(o->key, sizeof(o->key));
+	o->key_index = 0;
+	o->keyed = false;
+	o->err_seq = 0;
+	o->to1_left = PMAC_TO1_TRIES;
+	o->last_valid = false;
+	o->repeats = 0;
+	o->rerange = false;
+	o->ber_ms = 0;
+	o->lost_seen = false;
+	bitmap_zero(o->ports, PMAC_X_PORTS);
+	bitmap_zero(o->unicast, PMAC_X_PORTS);
+	bitmap_zero(o->up_crypt, PMAC_X_PORTS);
+	bitmap_zero(o->crypt, PMAC_X_PORTS);
+	o->running = true;
+	pmac_nl_notify(mac);
+	mutex_unlock(&o->lock);
+
+	/* act on a ready report that came before the state machine ran */
+	queue_work(system_wq, &o->link_work);
+}
+
+static int pmac_start_locked(struct pmac *mac)
+{
+	enum pmac_line line = mac->mode;
+	bool dark = false;
+	int err;
+
+	if (mac->line != PMAC_AUTO)
+		return 0;
+
+	if (!mac->sn_set) {
+		dev_err(mac->dev, "no serial number set\n");
+		mac->guess = false;
+		return -EINVAL;
+	}
+
+	if (line == PMAC_AUTO) {
+		err = pmac_detect(mac, &line, &dark);
+		if (err)
+			goto err_optics;
+		pmac_select_optic(mac, line);
+	} else {
+		/*
+		 * A fixed line powers its optic from off, and the laser driver
+		 * does not answer until the optic has been powered a while:
+		 * wait as pmac_detect() does between
+		 * powering an optic and starting the laser driver.
+		 */
+		pmac_select_optic(mac, line);
+		if (mac->power && mac->laser)
+			msleep(PMAC_DETECT_SETTLE_MS);
+	}
+
+	err = pmac_laser_start(mac, line);
+	if (err)
+		goto err_optics;
+
+	err = phy_init(mac->phy);
+	if (err)
+		goto err_laser;
+
+	err = phy_set_mode_ext(mac->phy, PHY_MODE_ETHERNET,
+			       line == PMAC_GPON ? EN7581_PON_GPON :
+						       EN7581_PON_XGSPON);
+	if (err)
+		goto err_phy_exit;
+
+	WRITE_ONCE(mac->lit, false);
+	err = en7581_pon_phy_set_link_handler(mac->phy, pmac_link_report,
+					      mac);
+	if (err)
+		goto err_phy_exit;
+
+	/*
+	 * The vendor's module never leaves the GPON MAC's block reset held:
+	 * its GPON MAC only pulses it and touches nothing meanwhile, and its
+	 * 10G MAC never writes it. A stop here leaves it held, so release it
+	 * before the first access to either MAC. Whether a held block answers
+	 * a bus access at all is not known: a PBUS access to REG_G_IF_STOP,
+	 * the GPON start's last access to the held block, timed out.
+	 */
+	err = reset_control_deassert(mac->reset);
+	if (err)
+		goto err_handler;
+
+	if (line == PMAC_GPON) {
+		pmac_gpon_connect(mac);
+	} else {
+		err = pmac_xgs_connect(mac);
+		if (!err)
+			err = pmac_laser_xgs_rate(mac);
+		if (err)
+			goto err_handler;
+	}
+
+	err = phy_power_on(mac->phy);
+	if (err)
+		goto err_handler;
+
+	pmac_fec_begin(mac);
+	WRITE_ONCE(mac->line, line);
+	/*
+	 * The 10G MAC takes its interrupt mask once, unlike the GPON one, and
+	 * before the state machine runs: a message latched once it brought
+	 * the MAC up must still be pending when the handler is enabled.
+	 */
+	if (line == PMAC_XGS) {
+		writel(~0U, mac->xgs + REG_X_IRQ_STATUS);
+		writel(X_IRQ_ENABLED, mac->xgs + REG_X_IRQ_ENABLE);
+	}
+	pmac_onu_begin(mac, line);
+	enable_irq(mac->irq);
+
+	mac->guess = dark;
+	if (mac->guess)
+		schedule_delayed_work(&mac->redetect,
+				      pmac_redetect_period(mac));
+	else
+		mac->dark_line = PMAC_AUTO;
+
+	return 0;
+
+err_handler:
+	en7581_pon_phy_set_link_handler(mac->phy, NULL, NULL);
+err_phy_exit:
+	phy_exit(mac->phy);
+err_laser:
+	pmac_laser_stop(mac);
+err_optics:
+	pmac_select_optic(mac, PMAC_AUTO);
+	mac->guess = false;
+	return err;
+}
+
+/*
+ * Whether the running @line saw light, has reported the link lost for
+ * @redetect's period since, and its optic sees no light now. While the link
+ * stays lost and that is not yet so, look again later.
+ */
+static bool pmac_lost_dark(struct pmac *mac, enum pmac_line line)
+{
+	DECLARE_BITMAP(los, 2);
+	unsigned long due;
+
+	if (!READ_ONCE(mac->lit) || READ_ONCE(mac->link) != PMAC_LINK_LOST)
+		return false;
+
+	due = READ_ONCE(mac->lost_at) + pmac_redetect_period(mac);
+	if (time_before(jiffies, due)) {
+		schedule_delayed_work(&mac->redetect, due - jiffies);
+		return false;
+	}
+
+	if (!mac->los ||
+	    gpiod_get_array_value_cansleep(mac->los->ndescs, mac->los->desc,
+					   mac->los->info, los))
+		return false;
+
+	if (!test_bit(line == PMAC_GPON ? OPTIC_GPON : OPTIC_XGS, los)) {
+		/* light without the link: the line's own recovery's */
+		schedule_delayed_work(&mac->redetect,
+				      pmac_redetect_period(mac));
+		return false;
+	}
+
+	return true;
+}
+
+/*
+ * Picking the line only once per boot leaves a unit that starts before
+ * the fibre is lit with its guess, even if the fibre later moves to the
+ * other mode's OLT. Here a start
+ * that found no light tests the optics again until the PHY reports light,
+ * and so does a line that lost its light (pmac_lost_dark()): while no
+ * optic sees light that one is kept, so a fibre pulled and put back comes
+ * back on it.
+ * Only the running line's optic is powered and has the fibre, so a test
+ * stops the line first; while it is dark there is no service to lose. None
+ * runs in a line mode the user fixed, nor once a power failure hit: its
+ * thread stops the line.
+ */
+static void pmac_redetect_work(struct work_struct *work)
+{
+	struct pmac *mac = container_of(to_delayed_work(work), struct pmac,
+					redetect);
+	enum pmac_line line, keep;
+	int err = 0;
+
+	mutex_lock(&mac->lock);
+	line = mac->line;
+	keep = mac->dark_line;
+	if (line == PMAC_AUTO || mac->mode != PMAC_AUTO ||
+	    READ_ONCE(mac->pf)) {
+		mac->guess = false;
+		goto out;
+	}
+
+	if (!mac->guess || READ_ONCE(mac->lit)) {
+		mac->guess = false;
+		mac->dark_line = PMAC_AUTO;
+		if (!pmac_lost_dark(mac, line))
+			goto out;
+		dev_info(mac->dev,
+			 "no light on the %s optic since the link was lost, testing the optics\n",
+			 pmac_line_names[line]);
+		keep = line;
+	}
+
+	pmac_stop_locked(mac);
+	mac->guess = true;
+	mac->dark_line = keep;
+	err = pmac_start_locked(mac);
+	if (err)
+		dev_err(mac->dev,
+			"cannot start again after testing the optics: %d\n",
+			err);
+out:
+	mutex_unlock(&mac->lock);
+
+	if (err)
+		sysfs_notify(&mac->dev->kobj, NULL, "enable");
+}
+
+/*
+ * Power failure handling. What cannot wait runs here: upstream grants
+ * filtered and, in GPON, every cause cleared, cause 1 enabled and one Dying
+ * Gasp queued. The
+ * 10G MAC is left to send its own Dying Gasp, as dying-gasp-control set it
+ * up at the bring-up. The thread clears the latch, turns the transmitter
+ * off 10 ms after the interrupt and stops the line.
+ *
+ * Power failure constraints:
+ * - The thread clears the latch in the system controller, whose regmap
+ *   lock may sleep, so not in hard interrupt context. The line stays
+ *   masked until the thread returns (IRQF_ONESHOT).
+ * - Linux has no PON power-failure notifier chain. The log line and the
+ *   line stopping are the report.
+ * - Both optics' power lines are driven off once and the line is
+ *   stopped as clearing enable stops it, so nothing powers an optic or the
+ *   transmitter again until userspace starts the MAC. Should the supply
+ *   come back, that start is the recovery.
+ */
+static irqreturn_t pmac_pf_irq(int irq, void *data)
+{
+	struct pmac *mac = data;
+	enum pmac_line line = READ_ONCE(mac->line);
+	static const u8 none[PLOAM_NDATA];
+
+	if (line == PMAC_GPON)
+		pmac_g_rmw(mac, REG_G_GRANT_FILTER, 0, REG_G_GRANT_FILTER_PF);
+	else if (line == PMAC_XGS)
+		pmac_x_rmw(mac, REG_X_GRANT_FILTER, 0, REG_X_GRANT_FILTER_PF);
+
+	mac->pf_line = line;
+	/* stopped: the thread only clears the latch */
+	if (line == PMAC_AUTO)
+		return IRQ_WAKE_THREAD;
+
+	if (line == PMAC_GPON) {
+		writel(~0U, mac->gpon + REG_G_IRQ_STATUS);
+		pmac_g_rmw(mac, REG_G_IRQ_ENABLE, 0, G_IRQ_UNUSED_1);
+		pmac_g_send(mac, UP_DYING_GASP, none, 1);
+	}
+
+	mac->pf_at = ktime_get();
+	WRITE_ONCE(mac->pf, true);
+
+	return IRQ_WAKE_THREAD;
+}
+
+static irqreturn_t pmac_pf_thread(int irq, void *data)
+{
+	struct pmac *mac = data;
+	s64 left;
+
+	/* written back set even though it reads set */
+	regmap_write_bits(mac->scu, SCU_PF_LATCH_REG, SCU_PF_LATCH,
+			  SCU_PF_LATCH);
+	if (mac->pf_line == PMAC_AUTO)
+		return IRQ_HANDLED;
+
+	left = PMAC_PF_TX_OFF_US - ktime_us_delta(ktime_get(), mac->pf_at);
+	if (left > 0)
+		usleep_range(left, left + 100);
+
+	en7581_pon_phy_set_transmitter(mac->phy, false);
+	if (mac->pf_line == PMAC_GPON)
+		/* the last of the four interfaces, without waiting for it */
+		pmac_g_rmw(mac, REG_G_IF_STOP, 0,
+			   pmac_g_stops[PMAC_STOPS - 1].request);
+	else
+		/* every burst profile invalid */
+		writel(0, mac->xgs + REG_X_PROFILE);
+	pmac_set_lines(mac->power, false);
+
+	dev_emerg(mac->dev, "power failure: transmitter and optics off\n");
+
+	mutex_lock(&mac->lock);
+	pmac_stop_locked(mac);
+	WRITE_ONCE(mac->pf, false);
+	mutex_unlock(&mac->lock);
+	sysfs_notify(&mac->dev->kobj, NULL, "enable");
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * Parse @buf as @len bytes: 2 * @len hex digits, or at most @len
+ * characters taken as they are, zero-padded.
+ */
+static int pmac_parse_bytes(const char *buf, size_t count, u8 *out,
+			    size_t len)
+{
+	count = min(count, strcspn(buf, "\n"));
+
+	if (count == 2 * len)
+		return hex2bin(out, buf, len);
+
+	if (count > len)
+		return -EINVAL;
+
+	memset(out, 0, len);
+	memcpy(out, buf, count);
+
+	return 0;
+}
+
+static ssize_t pmac_sn_show(struct device *dev,
+			    struct device_attribute *attr, char *buf)
+{
+	struct pmac *mac = dev_get_drvdata(dev);
+	ssize_t ret;
+
+	mutex_lock(&mac->lock);
+	if (mac->sn_set)
+		ret = sysfs_emit(buf, "%.4s%02x%02x%02x%02x\n", mac->sn,
+				 mac->sn[4], mac->sn[5], mac->sn[6], mac->sn[7]);
+	else
+		ret = sysfs_emit(buf, "\n");
+	mutex_unlock(&mac->lock);
+
+	return ret;
+}
+
+/*
+ * The serial number is written as the vendor ID, four printable characters,
+ * followed by the vendor-specific part as eight hex digits.
+ */
+static ssize_t pmac_sn_store(struct device *dev,
+			     struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct pmac *mac = dev_get_drvdata(dev);
+	u8 sn[PMAC_SN_LEN];
+	unsigned int i;
+	int err;
+
+	if (strcspn(buf, "\n") != 12)
+		return -EINVAL;
+
+	for (i = 0; i < 4; i++) {
+		if (!isgraph(buf[i]))
+			return -EINVAL;
+		sn[i] = buf[i];
+	}
+
+	if (hex2bin(sn + 4, buf + 4, 4))
+		return -EINVAL;
+
+	mutex_lock(&mac->lock);
+	err = mac->line == PMAC_AUTO ? 0 : -EBUSY;
+	if (!err) {
+		memcpy(mac->sn, sn, sizeof(sn));
+		mac->sn_set = true;
+	}
+	mutex_unlock(&mac->lock);
+
+	return err ? err : count;
+}
+
+static struct device_attribute pmac_attr_sn =
+	__ATTR(serial_number, 0644, pmac_sn_show, pmac_sn_store);
+
+static ssize_t pmac_store_secret(struct pmac *mac, const char *buf,
+				 size_t count, u8 *out, size_t len)
+{
+	u8 val[PMAC_REG_ID_LEN];
+	int err;
+
+	err = pmac_parse_bytes(buf, count, val, len);
+	if (err)
+		return -EINVAL;
+
+	mutex_lock(&mac->lock);
+	err = mac->line == PMAC_AUTO ? 0 : -EBUSY;
+	if (!err)
+		memcpy(out, val, len);
+	mutex_unlock(&mac->lock);
+	memzero_explicit(val, sizeof(val));
+
+	return err ? err : count;
+}
+
+static ssize_t pmac_password_store(struct device *dev,
+				   struct device_attribute *attr, const char *buf,
+				   size_t count)
+{
+	struct pmac *mac = dev_get_drvdata(dev);
+
+	return pmac_store_secret(mac, buf, count, mac->password,
+				 PMAC_PASSWORD_LEN);
+}
+
+static struct device_attribute pmac_attr_password =
+	__ATTR(password, 0200, NULL, pmac_password_store);
+
+static ssize_t pmac_reg_id_store(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct pmac *mac = dev_get_drvdata(dev);
+
+	return pmac_store_secret(mac, buf, count, mac->reg_id,
+				 PMAC_REG_ID_LEN);
+}
+
+static struct device_attribute pmac_attr_reg_id =
+	__ATTR(registration_id, 0200, NULL, pmac_reg_id_store);
+
+/*
+ * The master session key of XGS-PON, 32 hex digits, which the management
+ * side has from G.988's enhanced security control: pmac_x_set_msk(). Only
+ * on a running XGS-PON line.
+ */
+static ssize_t pmac_msk_store(struct device *dev,
+			      struct device_attribute *attr, const char *buf,
+			      size_t count)
+{
+	struct pmac *mac = dev_get_drvdata(dev);
+	u8 msk[AES_KEYSIZE_128];
+	int err;
+
+	if (strcspn(buf, "\n") != 2 * sizeof(msk) ||
+	    hex2bin(msk, buf, sizeof(msk)))
+		return -EINVAL;
+
+	mutex_lock(&mac->lock);
+	if (mac->line != PMAC_XGS) {
+		err = mac->line == PMAC_AUTO ? -ENETDOWN : -EOPNOTSUPP;
+	} else {
+		mutex_lock(&mac->o.lock);
+		err = pmac_x_set_msk(mac, msk);
+		mutex_unlock(&mac->o.lock);
+	}
+	mutex_unlock(&mac->lock);
+	memzero_explicit(msk, sizeof(msk));
+
+	return err ? err : count;
+}
+
+static struct device_attribute pmac_attr_msk =
+	__ATTR(master_session_key, 0200, NULL, pmac_msk_store);
+
+static ssize_t pmac_mode_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct pmac *mac = dev_get_drvdata(dev);
+	ssize_t len = 0;
+	unsigned int i;
+
+	mutex_lock(&mac->lock);
+	for (i = 0; i < ARRAY_SIZE(pmac_line_names); i++)
+		len += sysfs_emit_at(buf, len, i == mac->mode ? "%s[%s]" : "%s%s",
+				     i ? " " : "", pmac_line_names[i]);
+	mutex_unlock(&mac->lock);
+	len += sysfs_emit_at(buf, len, "\n");
+
+	return len;
+}
+
+static ssize_t pmac_mode_store(struct device *dev,
+			       struct device_attribute *attr, const char *buf,
+			       size_t count)
+{
+	struct pmac *mac = dev_get_drvdata(dev);
+	int mode, err;
+
+	mode = sysfs_match_string(pmac_line_names, buf);
+	if (mode < 0)
+		return mode;
+
+	mutex_lock(&mac->lock);
+	err = mac->line == PMAC_AUTO ? 0 : -EBUSY;
+	if (!err)
+		mac->mode = mode;
+	mutex_unlock(&mac->lock);
+
+	return err ? err : count;
+}
+
+static struct device_attribute pmac_attr_mode =
+	__ATTR(line_mode, 0644, pmac_mode_show, pmac_mode_store);
+
+static ssize_t pmac_line_show(struct device *dev, struct device_attribute *attr,
+			      char *buf)
+{
+	struct pmac *mac = dev_get_drvdata(dev);
+	enum pmac_line line;
+
+	mutex_lock(&mac->lock);
+	line = mac->line;
+	mutex_unlock(&mac->lock);
+
+	return sysfs_emit(buf, "%s\n", line == PMAC_AUTO ? "none" :
+				       pmac_line_names[line]);
+}
+
+static struct device_attribute pmac_attr_line =
+	__ATTR(line, 0444, pmac_line_show, NULL);
+
+static ssize_t pmac_enable_show(struct device *dev, struct device_attribute *attr,
+				char *buf)
+{
+	struct pmac *mac = dev_get_drvdata(dev);
+	bool on;
+
+	mutex_lock(&mac->lock);
+	on = mac->line != PMAC_AUTO;
+	mutex_unlock(&mac->lock);
+
+	return sysfs_emit(buf, "%d\n", on);
+}
+
+static ssize_t pmac_enable_store(struct device *dev, struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct pmac *mac = dev_get_drvdata(dev);
+	bool on;
+	int err;
+
+	err = kstrtobool(buf, &on);
+	if (err)
+		return err;
+
+	mutex_lock(&mac->lock);
+	if (on) {
+		err = pmac_start_locked(mac);
+	} else {
+		pmac_stop_locked(mac);
+		err = 0;
+	}
+	mutex_unlock(&mac->lock);
+
+	return err ? err : count;
+}
+
+static struct device_attribute pmac_attr_enable =
+	__ATTR(enable, 0644, pmac_enable_show, pmac_enable_store);
+
+/* The activation state as the running MAC holds it. */
+static ssize_t pmac_state_show(struct device *dev, struct device_attribute *attr,
+			       char *buf)
+{
+	struct pmac *mac = dev_get_drvdata(dev);
+	enum pmac_line line;
+	u32 state = 0;
+
+	mutex_lock(&mac->lock);
+	line = mac->line;
+	if (line == PMAC_GPON)
+		state = FIELD_GET(REG_G_STATE_NUM,
+				  readl(mac->gpon + REG_G_STATE));
+	else if (line == PMAC_XGS)
+		state = FIELD_GET(REG_X_STATE_NUM,
+				  readl(mac->xgs + REG_X_STATE));
+	mutex_unlock(&mac->lock);
+
+	if (!state)
+		return sysfs_emit(buf, "none\n");
+	if (state == PMAC_O2 && line == PMAC_XGS)
+		return sysfs_emit(buf, "O2-3\n");
+
+	return sysfs_emit(buf, "O%u\n", state);
+}
+
+static struct device_attribute pmac_attr_state =
+	__ATTR(state, 0444, pmac_state_show, NULL);
+
+static ssize_t pmac_onu_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct pmac *mac = dev_get_drvdata(dev);
+	u32 val = 0, id = 0;
+
+	mutex_lock(&mac->lock);
+	if (mac->line == PMAC_GPON) {
+		val = readl(mac->gpon + REG_G_ONU);
+		id = FIELD_GET(REG_G_ONU_NUM, val);
+		val &= REG_G_ONU_VALID;
+	} else if (mac->line == PMAC_XGS) {
+		val = readl(mac->xgs + REG_X_ONU);
+		id = FIELD_GET(REG_X_ONU_NUM, val);
+		val &= REG_X_ONU_VALID;
+	}
+	mutex_unlock(&mac->lock);
+
+	if (!val)
+		return sysfs_emit(buf, "none\n");
+
+	return sysfs_emit(buf, "%u\n", id);
+}
+
+static struct device_attribute pmac_attr_onu =
+	__ATTR(onu_id, 0444, pmac_onu_show, NULL);
+
+static ssize_t pmac_link_show(struct device *dev, struct device_attribute *attr,
+			      char *buf)
+{
+	static const char * const names[] = {
+		[PMAC_LINK_NONE] = "none",
+		[PMAC_LINK_READY] = "ready",
+		[PMAC_LINK_LOST] = "lost",
+	};
+	struct pmac *mac = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%s\n", names[READ_ONCE(mac->link)]);
+}
+
+static struct device_attribute pmac_attr_link =
+	__ATTR(link, 0444, pmac_link_show, NULL);
+
+static struct attribute *pmac_attrs[] = {
+	&pmac_attr_sn.attr,
+	&pmac_attr_password.attr,
+	&pmac_attr_reg_id.attr,
+	&pmac_attr_msk.attr,
+	&pmac_attr_mode.attr,
+	&pmac_attr_line.attr,
+	&pmac_attr_enable.attr,
+	&pmac_attr_state.attr,
+	&pmac_attr_onu.attr,
+	&pmac_attr_link.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(pmac);
+
+/*
+ * The length of the one OMCI message @skb holds, without its trailer, or 0
+ * when @skb is not one message with or without a trailer.
+ */
+static unsigned int pmac_omci_len(const struct sk_buff *skb)
+{
+	u8 buf[OMCI_EXT_HDR_LEN];
+	unsigned int len;
+	const u8 *hdr;
+
+	hdr = skb_header_pointer(skb, 0, sizeof(buf), buf);
+	if (!hdr)
+		return 0;
+
+	switch (hdr[OMCI_DEV_ID]) {
+	case OMCI_DEV_BASELINE:
+		len = OMCI_BASE_LEN;
+		break;
+	case OMCI_DEV_EXTENDED:
+		len = get_unaligned_be16(hdr + OMCI_EXT_CONTENTS_LEN);
+		if (len > OMCI_EXT_MAX_CONTENTS)
+			return 0;
+		len += OMCI_EXT_HDR_LEN;
+		break;
+	default:
+		return 0;
+	}
+
+	if (skb->len != len && skb->len != len + OMCI_TRAILER_LEN)
+		return 0;
+
+	return len;
+}
+
+/*
+ * Whether the trailer after the @len octets of the XGS-PON OMCI message in
+ * @skb is its MIC, under the OMCI integrity key of either key set: which
+ * one the OLT uses at a time, the driver does not track. The keys are
+ * written in O2-3 only, and no frame is delivered before O5.
+ */
+static bool pmac_omci_mic_ok(struct pmac *mac, struct sk_buff *skb,
+			     unsigned int len)
+{
+	struct pmac_onu *o = &mac->o;
+	unsigned int set;
+
+	if (!o->ik_valid)
+		return false;
+
+	for (set = X_KEY_SET_A; set <= X_KEY_SET_B; set++)
+		if (pmac_x_mic_ok(o->omci_mic_key[set], skb->data, len,
+				  skb->data + len, OMCI_TRAILER_LEN))
+			return true;
+
+	return false;
+}
+
+/*
+ * A control frame from the frame engine. Deliver it when it arrived on the
+ * OMCC and is one OMCI message. The GPON MAC checked and removed the CRC
+ * trailer, so a baseline message arrives as its 44 octets. A frame one
+ * trailer longer than its message is cut to the message: on an XGS-PON
+ * line once its MIC checks out, on a GPON line unchecked. The length a
+ * message arrives with on XGS-PON, and an extended one on GPON, is not
+ * known.
+ */
+static void pmac_omci_rx(void *priv, struct sk_buff *skb, u16 port_id,
+			 u32 flags)
+{
+	struct pmac *mac = priv;
+	struct net_device *ndev = mac->omci;
+	unsigned int len;
+	bool xgs;
+
+	if (!netif_running(ndev) || port_id != READ_ONCE(mac->omci_port) ||
+	    flags)
+		goto drop;
+
+	if (skb_linearize(skb))
+		goto drop;
+
+	len = pmac_omci_len(skb);
+	if (!len) {
+		DEV_STATS_INC(ndev, rx_length_errors);
+		goto error;
+	}
+
+	xgs = READ_ONCE(mac->line) == PMAC_XGS;
+	if (skb->len != len && xgs && !pmac_omci_mic_ok(mac, skb, len)) {
+		atomic64_inc(&mac->omci_x[PMAC_XO_MIC_ERRORS]);
+		DEV_STATS_INC(ndev, rx_crc_errors);
+		goto error;
+	}
+	if (xgs)
+		atomic64_inc(&mac->omci_x[skb->data[OMCI_DEV_ID] ==
+					  OMCI_DEV_BASELINE ?
+					  PMAC_XO_BASELINE : PMAC_XO_EXTENDED]);
+
+	__skb_trim(skb, len);
+
+	if (FIELD_GET(OMCI_MT_ACTION, skb->data[OMCI_MSG_TYPE]) ==
+	    OMCI_MIB_UPLOAD && READ_ONCE(mac->line) != PMAC_XGS)
+		schedule_work(&mac->o.mib_work);
+
+	skb->dev = ndev;
+	skb->protocol = htons(OMCI_PROTOCOL);
+	skb->pkt_type = PACKET_HOST;
+	skb_reset_mac_header(skb);
+	skb_reset_network_header(skb);
+
+	DEV_STATS_INC(ndev, rx_packets);
+	DEV_STATS_ADD(ndev, rx_bytes, len);
+	netif_receive_skb(skb);
+	return;
+
+error:
+	DEV_STATS_INC(ndev, rx_errors);
+drop:
+	DEV_STATS_INC(ndev, rx_dropped);
+	kfree_skb(skb);
+}
+
+static void pmac_omci_tx_wake(void *priv)
+{
+	struct pmac *mac = priv;
+
+	netif_wake_queue(mac->omci);
+}
+
+static const struct airoha_pon_ops pmac_pon_ops = {
+	.rx_ctrl = pmac_omci_rx,
+	.ctrl_tx_wake = pmac_omci_tx_wake,
+};
+
+/*
+ * Send one OMCI message on the OMCC. A trailer userspace appended is cut
+ * off: the GPON MAC appends the CRC.
+ *
+ * Every drop counts tx_dropped and one reason: tx_errors (no message),
+ * tx_carrier_errors (no OMCC), tx_aborted_errors (the trim failed) or
+ * tx_fifo_errors (airoha_pon_xmit_ctrl() failed, e.g. -ENETDOWN). The last
+ * two also log the errno, ratelimited.
+ */
+static netdev_tx_t pmac_omci_xmit(struct sk_buff *skb, struct net_device *ndev)
+{
+	struct pmac *mac = *(struct pmac **)netdev_priv(ndev);
+	u32 port = READ_ONCE(mac->omci_port);
+	unsigned int len;
+	int err;
+
+	len = pmac_omci_len(skb);
+	if (!len) {
+		DEV_STATS_INC(ndev, tx_errors);
+		goto drop;
+	}
+
+	if (port == PMAC_OMCI_NONE) {
+		DEV_STATS_INC(ndev, tx_carrier_errors);
+		goto drop;
+	}
+
+	err = pskb_trim(skb, len);
+	if (err) {
+		DEV_STATS_INC(ndev, tx_aborted_errors);
+		dev_warn_ratelimited(mac->dev, "OMCI frame not sent: cannot trim it: %d\n",
+				     err);
+		goto drop;
+	}
+
+	err = airoha_pon_xmit_ctrl(mac->pon, skb, port, 0);
+	if (err == -EBUSY) {
+		netif_stop_queue(ndev);
+		/* the ring may have drained before the queue stopped */
+		err = airoha_pon_xmit_ctrl(mac->pon, skb, port, 0);
+		if (err == -EBUSY) {
+			/* back to this queue for the requeue */
+			skb->dev = ndev;
+			skb_set_queue_mapping(skb, 0);
+			return NETDEV_TX_BUSY;
+		}
+		netif_wake_queue(ndev);
+	}
+	if (err) {
+		DEV_STATS_INC(ndev, tx_fifo_errors);
+		dev_warn_ratelimited(mac->dev, "OMCI frame not sent: the frame engine refused it: %d\n",
+				     err);
+		goto drop;
+	}
+
+	DEV_STATS_INC(ndev, tx_packets);
+	DEV_STATS_ADD(ndev, tx_bytes, len);
+	return NETDEV_TX_OK;
+
+drop:
+	DEV_STATS_INC(ndev, tx_dropped);
+	kfree_skb(skb);
+	return NETDEV_TX_OK;
+}
+
+static const struct net_device_ops pmac_omci_ops = {
+	.ndo_start_xmit = pmac_omci_xmit,
+};
+
+static void pmac_omci_setup(struct net_device *ndev)
+{
+	ndev->netdev_ops = &pmac_omci_ops;
+	ndev->type = ARPHRD_NONE;
+	ndev->flags = IFF_NOARP;
+	ndev->hard_header_len = 0;
+	ndev->addr_len = 0;
+	/* a message with its trailer: userspace may append one */
+	ndev->mtu = OMCI_MAX_LEN + OMCI_TRAILER_LEN;
+	ndev->min_mtu = OMCI_BASE_LEN;
+	ndev->max_mtu = OMCI_MAX_LEN + OMCI_TRAILER_LEN;
+}
+
+static void pmac_omci_free(void *data)
+{
+	free_netdev(data);
+}
+
+static void pmac_omci_unregister(void *data)
+{
+	unregister_netdev(data);
+}
+
+static void pmac_pon_unregister(void *data)
+{
+	airoha_pon_unregister(data);
+}
+
+/*
+ * The OMCI netdev, named as the OMCI agent expects it, then the frame
+ * engine's control callbacks, which deliver to it.
+ */
+static int pmac_omci_init(struct pmac *mac)
+{
+	struct net_device *ndev;
+	int err;
+
+	mac->omci_port = PMAC_OMCI_NONE;
+
+	ndev = alloc_netdev(sizeof(mac), "omci", NET_NAME_PREDICTABLE,
+			    pmac_omci_setup);
+	if (!ndev)
+		return -ENOMEM;
+
+	err = devm_add_action_or_reset(mac->dev, pmac_omci_free, ndev);
+	if (err)
+		return err;
+
+	*(struct pmac **)netdev_priv(ndev) = mac;
+	SET_NETDEV_DEV(ndev, mac->dev);
+	netif_carrier_off(ndev);
+	mac->omci = ndev;
+
+	err = register_netdev(ndev);
+	if (err)
+		return dev_err_probe(mac->dev, err,
+				     "cannot register the OMCI netdev\n");
+
+	err = devm_add_action_or_reset(mac->dev, pmac_omci_unregister, ndev);
+	if (err)
+		return err;
+
+	err = airoha_pon_register(mac->pon, &pmac_pon_ops, mac);
+	if (err)
+		return dev_err_probe(mac->dev, err,
+				     "cannot take the PON control path\n");
+
+	return devm_add_action_or_reset(mac->dev, pmac_pon_unregister,
+					mac->pon);
+}
+
+/*
+ * The airoha-pon-mac netlink family (Documentation/netlink/specs/
+ * airoha-pon-mac.yaml): the OMCI agent's view of the activation and its
+ * control of the datapath tables. An operation holds the device list,
+ * the device and the state machine locked, so a PLOAM message is handled
+ * either before it or after it.
+ */
+
+static enum airoha_pon_mac_line pmac_nl_line(enum pmac_line line)
+{
+	switch (line) {
+	case PMAC_GPON:
+		return AIROHA_PON_MAC_LINE_GPON;
+	case PMAC_XGS:
+		return AIROHA_PON_MAC_LINE_XGS_PON;
+	default:
+		return AIROHA_PON_MAC_LINE_NONE;
+	}
+}
+
+static const struct pmac_tcont_cfg *pmac_tcont_cfg_find(const struct pmac *mac,
+							u16 alloc)
+{
+	unsigned int i;
+
+	for (i = 0; i < mac->num_tconts; i++)
+		if (mac->tconts[i].alloc == alloc)
+			return &mac->tconts[i];
+
+	return NULL;
+}
+
+static bool pmac_alloc_assigned(const struct pmac *mac, u16 alloc)
+{
+	unsigned int slot;
+
+	for_each_set_bit(slot, &mac->o.slots, PMAC_SLOTS)
+		if (mac->o.alloc[slot] == alloc)
+			return true;
+
+	return false;
+}
+
+/* an upper bound of what pmac_nl_fill() puts in a message */
+static size_t pmac_nl_size(const struct pmac *mac)
+{
+	size_t u32_size = nla_total_size(sizeof(u32));
+	size_t tcont = nla_total_size((7 + AIROHA_PON_TCONT_QUEUES) * u32_size);
+	size_t entry = nla_total_size(4 * u32_size + nla_total_size(0));
+
+	size_t uint_size = nla_total_size_64bit(sizeof(u64));
+	/* a GEM port has two u32 more than a rule: six and a flag */
+	size_t gem = entry + 2 * u32_size + PMAC_GEM_NUM * uint_size;
+	size_t fec = nla_total_size(PMAC_FEC_NUM * uint_size);
+	size_t ber = nla_total_size(2 * uint_size + 2 * u32_size);
+	size_t xgs = nla_total_size(AIROHA_PON_MAC_A_XGS_MAX * uint_size);
+
+	return 6 * u32_size + nla_total_size(0) +
+	       (PMAC_SLOTS + mac->num_tconts) * tcont +
+	       mac->num_gems * gem + mac->num_rules * entry + fec + ber + xgs;
+}
+
+static int pmac_nl_put_tcont(struct sk_buff *msg, struct pmac *mac, u16 alloc,
+			     int slot, const struct pmac_tcont_cfg *c)
+{
+	unsigned int q, nw;
+	struct nlattr *nest;
+	u32 cpu, fwd;
+
+	nest = nla_nest_start(msg, AIROHA_PON_MAC_A_DEV_TCONT);
+	if (!nest)
+		return -EMSGSIZE;
+
+	if (nla_put_u32(msg, AIROHA_PON_MAC_A_TCONT_ALLOC_ID, alloc))
+		goto cancel;
+
+	if (slot >= 0) {
+		if (nla_put_u32(msg, AIROHA_PON_MAC_A_TCONT_INDEX, slot))
+			goto cancel;
+		if (test_bit(slot, &mac->o.tconts) &&
+		    !airoha_pon_tcont_counters(mac->pon, slot, &cpu, &fwd) &&
+		    (nla_put_u32(msg, AIROHA_PON_MAC_A_TCONT_CPU_PACKETS, cpu) ||
+		     nla_put_u32(msg, AIROHA_PON_MAC_A_TCONT_FWD_PACKETS, fwd)))
+			goto cancel;
+	}
+
+	if (c) {
+		if (c->sched) {
+			if (nla_put_u32(msg, AIROHA_PON_MAC_A_TCONT_STRICT,
+					c->strict))
+				goto cancel;
+			nw = c->strict == AIROHA_PON_TCONT_QUEUES ? 0 :
+			     AIROHA_PON_TCONT_QUEUES;
+			for (q = 0; q < nw; q++)
+				if (nla_put_u32(msg, AIROHA_PON_MAC_A_TCONT_WEIGHT,
+						c->weights[q]))
+					goto cancel;
+		}
+		if (nla_put_u32(msg, AIROHA_PON_MAC_A_TCONT_RATE, c->rate) ||
+		    nla_put_u32(msg, AIROHA_PON_MAC_A_TCONT_BURST, c->burst))
+			goto cancel;
+	}
+
+	nla_nest_end(msg, nest);
+	return 0;
+
+cancel:
+	nla_nest_cancel(msg, nest);
+	return -EMSGSIZE;
+}
+
+/*
+ * A GEM port and its counters: what the MAC counted while it had the port
+ * open, 0 for a port it never opened.
+ */
+static int pmac_nl_put_gem(struct sk_buff *msg, struct pmac *mac,
+			   const struct pmac_gem_cfg *c)
+{
+	static const u64 none[PMAC_GEM_NUM];
+	const struct pmac_gem_count *count = NULL;
+	struct nlattr *nest;
+	const u64 *sum;
+
+	nest = nla_nest_start(msg, AIROHA_PON_MAC_A_DEV_GEM);
+	if (!nest)
+		return -EMSGSIZE;
+
+	if (c->port < PMAC_X_PORTS)
+		count = xa_load(&mac->o.gem_counts, c->port);
+	sum = count ? count->sum : none;
+
+	if (nla_put_u32(msg, AIROHA_PON_MAC_A_GEM_PORT_ID, c->port) ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_GEM_DIRECTION, c->dir) ||
+	    (c->has_alloc &&
+	     nla_put_u32(msg, AIROHA_PON_MAC_A_GEM_ALLOC_ID, c->alloc)) ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_GEM_QUEUE, c->queue) ||
+	    (c->port < PMAC_X_PORTS && test_bit(c->port, mac->o.crypt) &&
+	     nla_put_flag(msg, AIROHA_PON_MAC_A_GEM_ENCRYPTED)) ||
+	    nla_put_uint(msg, AIROHA_PON_MAC_A_GEM_RX_FRAMES,
+			 sum[PMAC_GEM_RX_FRAMES]) ||
+	    nla_put_uint(msg, AIROHA_PON_MAC_A_GEM_RX_PAYLOAD_BYTES,
+			 sum[PMAC_GEM_RX_BYTES]) ||
+	    nla_put_uint(msg, AIROHA_PON_MAC_A_GEM_TX_FRAMES,
+			 sum[PMAC_GEM_TX_FRAMES]) ||
+	    nla_put_uint(msg, AIROHA_PON_MAC_A_GEM_TX_PAYLOAD_BYTES,
+			 sum[PMAC_GEM_TX_BYTES]) ||
+	    (c->ifindex &&
+	     nla_put_u32(msg, AIROHA_PON_MAC_A_GEM_ANI_IFINDEX, c->ifindex)) ||
+	    (c->key_ring &&
+	     nla_put_u32(msg, AIROHA_PON_MAC_A_GEM_KEY_RING, c->key_ring))) {
+		nla_nest_cancel(msg, nest);
+		return -EMSGSIZE;
+	}
+
+	nla_nest_end(msg, nest);
+	return 0;
+}
+
+/* The FEC counters, added up first. Takes mac->fec.lock. */
+static int pmac_nl_put_fec(struct sk_buff *msg, struct pmac *mac)
+{
+	struct pmac_fec *f = &mac->fec;
+	struct nlattr *nest;
+	int err = -EMSGSIZE;
+
+	nest = nla_nest_start(msg, AIROHA_PON_MAC_A_DEV_FEC);
+	if (!nest)
+		return -EMSGSIZE;
+
+	mutex_lock(&f->lock);
+	if (f->on)
+		pmac_fec_read(mac, true);
+	if (!nla_put_uint(msg, AIROHA_PON_MAC_A_FEC_CORRECTED_BYTES,
+			  f->sum[PMAC_FEC_BYTES]) &&
+	    !nla_put_uint(msg, AIROHA_PON_MAC_A_FEC_CORRECTED_WORDS,
+			  f->sum[PMAC_FEC_FIXED]) &&
+	    !nla_put_uint(msg, AIROHA_PON_MAC_A_FEC_UNCORRECTABLE_WORDS,
+			  f->sum[PMAC_FEC_LOST]) &&
+	    !nla_put_uint(msg, AIROHA_PON_MAC_A_FEC_WORDS,
+			  f->sum[PMAC_FEC_WORDS]) &&
+	    !nla_put_uint(msg, AIROHA_PON_MAC_A_FEC_ERRORED_SECONDS,
+			  f->sum[PMAC_FEC_SECS]))
+		err = 0;
+	mutex_unlock(&f->lock);
+
+	if (err)
+		nla_nest_cancel(msg, nest);
+	else
+		nla_nest_end(msg, nest);
+	return err;
+}
+
+static int pmac_nl_put_ber(struct sk_buff *msg, const struct pmac_onu *o)
+{
+	struct nlattr *nest;
+
+	if (!o->ber_seq)
+		return 0;
+
+	nest = nla_nest_start(msg, AIROHA_PON_MAC_A_DEV_BER);
+	if (!nest)
+		return -EMSGSIZE;
+
+	if (nla_put_uint(msg, AIROHA_PON_MAC_A_BER_SEQUENCE, o->ber_seq) ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_BER_ERRORS, o->ber_errors) ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_BER_INTERVAL, o->ber_last_ms) ||
+	    (o->ber_bits &&
+	     nla_put_uint(msg, AIROHA_PON_MAC_A_BER_BITS, o->ber_bits))) {
+		nla_nest_cancel(msg, nest);
+		return -EMSGSIZE;
+	}
+
+	nla_nest_end(msg, nest);
+	return 0;
+}
+
+static int pmac_nl_put_rule(struct sk_buff *msg, const struct airoha_pon_rule *r)
+{
+	struct nlattr *nest;
+
+	nest = nla_nest_start(msg, AIROHA_PON_MAC_A_DEV_RULE);
+	if (!nest)
+		return -EMSGSIZE;
+
+	if ((r->vid == AIROHA_PON_VID_UNTAGGED &&
+	     nla_put_flag(msg, AIROHA_PON_MAC_A_RULE_UNTAGGED)) ||
+	    (r->vid < VLAN_N_VID &&
+	     nla_put_u32(msg, AIROHA_PON_MAC_A_RULE_VID, r->vid)) ||
+	    (r->pcp != AIROHA_PON_PCP_ANY &&
+	     nla_put_u32(msg, AIROHA_PON_MAC_A_RULE_PCP, r->pcp)) ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_RULE_PORT_ID, r->port_id) ||
+	    (r->ifindex &&
+	     nla_put_u32(msg, AIROHA_PON_MAC_A_RULE_ANI_IFINDEX, r->ifindex))) {
+		nla_nest_cancel(msg, nest);
+		return -EMSGSIZE;
+	}
+
+	nla_nest_end(msg, nest);
+	return 0;
+}
+
+static u64 pmac_xf_sum(const struct pmac_xcnt *x, unsigned int first,
+		       unsigned int n)
+{
+	u64 sum = 0;
+
+	while (n--)
+		sum += x->sum[first++];
+	return sum;
+}
+
+/*
+ * The XGS-PON line counters, the MAC's added up first, filed as G.988 files
+ * them. Takes mac->xcnt.lock; the caller
+ * holds mac->o.lock.
+ */
+static int pmac_nl_put_xgs(struct sk_buff *msg, struct pmac *mac)
+{
+	const u64 *sw = mac->o.x_msgs;
+	struct pmac_xcnt *x = &mac->xcnt;
+	u64 val[AIROHA_PON_MAC_A_XGS_MAX + 1] = {};
+	struct nlattr *nest;
+	unsigned int i;
+
+	mutex_lock(&x->lock);
+	if (x->on)
+		pmac_xcnt_read(mac, true);
+	val[AIROHA_PON_MAC_A_XGS_PSBD_HEC_ERRORS] =
+		pmac_xf_sum(x, PMAC_XF_XGTC_HEC,
+			    PMAC_XF_PLOAM_MIC - PMAC_XF_XGTC_HEC);
+	val[AIROHA_PON_MAC_A_XGS_XGTC_HEC_ERRORS] =
+		pmac_xf_sum(x, PMAC_XF_XGTC_HEC, 3);
+	val[AIROHA_PON_MAC_A_XGS_XGEM_HEC_ERRORS] =
+		pmac_xf_sum(x, PMAC_XF_XGEM_HEC, 3);
+	val[AIROHA_PON_MAC_A_XGS_UNKNOWN_PROFILES] = x->sum[PMAC_XF_PROFILE];
+	val[AIROHA_PON_MAC_A_XGS_TX_XGEM_FRAMES] = x->sum[PMAC_XF_XGEM_UP];
+	val[AIROHA_PON_MAC_A_XGS_TX_XGEM_FRAGMENTS] = x->sum[PMAC_XF_FRAGMENTS];
+	val[AIROHA_PON_MAC_A_XGS_XGEM_HEC_LOST_WORDS] = x->sum[PMAC_XF_HEC_LOST];
+	val[AIROHA_PON_MAC_A_XGS_XGEM_KEY_ERRORS] = x->sum[PMAC_XF_KEY_ERR];
+	val[AIROHA_PON_MAC_A_XGS_TX_NONIDLE_BYTES] = x->sum[PMAC_XF_BYTES_UP];
+	val[AIROHA_PON_MAC_A_XGS_RX_NONIDLE_BYTES] = x->sum[PMAC_XF_BYTES_DOWN];
+	val[AIROHA_PON_MAC_A_XGS_RX_PLOAM_MIC_ERRORS] =
+		x->sum[PMAC_XF_PLOAM_MIC];
+	val[AIROHA_PON_MAC_A_XGS_RX_PLOAM] = x->sum[PMAC_XF_PLOAM_DOWN];
+	val[AIROHA_PON_MAC_A_XGS_RX_OMCI_MIC_ERRORS] = x->sum[PMAC_XF_OMCI_MIC];
+	val[AIROHA_PON_MAC_A_XGS_TX_PLOAM] = x->sum[PMAC_XF_PLOAM_UP];
+	mutex_unlock(&x->lock);
+
+	val[AIROHA_PON_MAC_A_XGS_RX_OMCI_MIC_ERRORS] +=
+		atomic64_read(&mac->omci_x[PMAC_XO_MIC_ERRORS]);
+	val[AIROHA_PON_MAC_A_XGS_RX_OMCI_BASELINE] =
+		atomic64_read(&mac->omci_x[PMAC_XO_BASELINE]);
+	val[AIROHA_PON_MAC_A_XGS_RX_OMCI_EXTENDED] =
+		atomic64_read(&mac->omci_x[PMAC_XO_EXTENDED]);
+
+	val[AIROHA_PON_MAC_A_XGS_LODS_EVENTS] = sw[PMAC_XM_LODS];
+	val[AIROHA_PON_MAC_A_XGS_LODS_RESTORED] = sw[PMAC_XM_LODS_RESTORED];
+	val[AIROHA_PON_MAC_A_XGS_LODS_REACTIVATIONS] =
+		sw[PMAC_XM_LODS_REACTIVATED];
+	val[AIROHA_PON_MAC_A_XGS_RX_PROFILE] = sw[PMAC_XM_RX_PROFILE];
+	val[AIROHA_PON_MAC_A_XGS_RX_RANGING_TIME] = sw[PMAC_XM_RX_RANGING_TIME];
+	val[AIROHA_PON_MAC_A_XGS_RX_DEACTIVATE_ONU_ID] =
+		sw[PMAC_XM_RX_DEACTIVATE];
+	val[AIROHA_PON_MAC_A_XGS_RX_DISABLE_SERIAL_NUMBER] =
+		sw[PMAC_XM_RX_DISABLE_SN];
+	val[AIROHA_PON_MAC_A_XGS_RX_REQUEST_REGISTRATION] =
+		sw[PMAC_XM_RX_REQUEST_REG];
+	val[AIROHA_PON_MAC_A_XGS_RX_ASSIGN_ALLOC_ID] =
+		sw[PMAC_XM_RX_ASSIGN_ALLOC];
+	val[AIROHA_PON_MAC_A_XGS_RX_KEY_CONTROL] = sw[PMAC_XM_RX_KEY_CONTROL];
+	val[AIROHA_PON_MAC_A_XGS_RX_SLEEP_ALLOW] = sw[PMAC_XM_RX_SLEEP_ALLOW];
+	val[AIROHA_PON_MAC_A_XGS_RX_ASSIGN_ONU_ID] = sw[PMAC_XM_RX_ASSIGN_ONU];
+	val[AIROHA_PON_MAC_A_XGS_TX_SERIAL_NUMBER] =
+		sw[PMAC_XM_TX_SERIAL_NUMBER];
+	val[AIROHA_PON_MAC_A_XGS_TX_REGISTRATION] = sw[PMAC_XM_TX_REGISTRATION];
+	val[AIROHA_PON_MAC_A_XGS_TX_KEY_REPORT] = sw[PMAC_XM_TX_KEY_REPORT];
+	val[AIROHA_PON_MAC_A_XGS_TX_ACKNOWLEDGE] = sw[PMAC_XM_TX_ACK];
+	/* no power saving, so no Sleep Request: tx-sleep-request stays 0 */
+
+	nest = nla_nest_start(msg, AIROHA_PON_MAC_A_DEV_XGS);
+	if (!nest)
+		return -EMSGSIZE;
+	for (i = 1; i <= AIROHA_PON_MAC_A_XGS_MAX; i++)
+		if (nla_put_uint(msg, i, val[i])) {
+			nla_nest_cancel(msg, nest);
+			return -EMSGSIZE;
+		}
+	nla_nest_end(msg, nest);
+	return 0;
+}
+
+/*
+ * The device's attributes. With @read the GEM port counters are added up
+ * first; without, they are the sums as last added up. A GPON counter read
+ * takes milliseconds a port, so a notification, sent from the state machine
+ * with the lock held, does not read them. The caller holds mac->o.lock.
+ */
+static int pmac_nl_fill(struct sk_buff *msg, struct pmac *mac, bool read)
+{
+	struct pmac_onu *o = &mac->o;
+	enum pmac_line line = READ_ONCE(mac->line);
+	bool running = line != PMAC_AUTO && o->running;
+	unsigned int i, slot;
+
+	if (nla_put_u32(msg, AIROHA_PON_MAC_A_DEV_IFINDEX,
+			airoha_pon_netdev(mac->pon)->ifindex) ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_DEV_LINE, pmac_nl_line(line)) ||
+	    (running &&
+	     nla_put_u32(msg, AIROHA_PON_MAC_A_DEV_STATE, o->state)) ||
+	    (running && o->onu_valid &&
+	     nla_put_u32(msg, AIROHA_PON_MAC_A_DEV_ONU_ID, o->onu_id)) ||
+	    (running && o->omcc_valid &&
+	     nla_put_u32(msg, AIROHA_PON_MAC_A_DEV_OMCC_PORT, o->omcc)) ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_DEV_OMCI_IFINDEX,
+			mac->omci->ifindex) ||
+	    /*
+	     * The GPON MAC checks and removes the CRC, and appends it; the 10G
+	     * MAC checks and adds the MIC under the OMCI integrity key, as
+	     * every bring-up has it do, and the driver checks a MIC that
+	     * arrives. Whether either MAC drops a message that fails, or only
+	     * flags it (a flagged frame is dropped), is not known.
+	     */
+	    (line != PMAC_AUTO &&
+	     nla_put_flag(msg, AIROHA_PON_MAC_A_DEV_OMCI_INTEGRITY)))
+		return -EMSGSIZE;
+
+	/* the Alloc-IDs the OLT assigned, then the configured ones it did not */
+	for_each_set_bit(slot, &o->slots, PMAC_SLOTS)
+		if (pmac_nl_put_tcont(msg, mac, o->alloc[slot], slot,
+				      pmac_tcont_cfg_find(mac, o->alloc[slot])))
+			return -EMSGSIZE;
+	for (i = 0; i < mac->num_tconts; i++)
+		if (!pmac_alloc_assigned(mac, mac->tconts[i].alloc) &&
+		    pmac_nl_put_tcont(msg, mac, mac->tconts[i].alloc, -1,
+				      &mac->tconts[i]))
+			return -EMSGSIZE;
+
+	if (read)
+		pmac_gem_fold(mac, false);
+	for (i = 0; i < mac->num_gems; i++)
+		if (pmac_nl_put_gem(msg, mac, &mac->gems[i]))
+			return -EMSGSIZE;
+
+	for (i = 0; i < mac->num_rules; i++)
+		if (pmac_nl_put_rule(msg, &mac->rules[i]))
+			return -EMSGSIZE;
+
+	if (line == PMAC_XGS && pmac_nl_put_xgs(msg, mac))
+		return -EMSGSIZE;
+
+	return pmac_nl_put_fec(msg, mac) ?: pmac_nl_put_ber(msg, o);
+}
+
+/* Tell the monitor group what changed. The caller holds mac->o.lock. */
+static void pmac_nl_notify(struct pmac *mac)
+{
+	struct net *net = dev_net(airoha_pon_netdev(mac->pon));
+	struct sk_buff *msg;
+	void *hdr;
+
+	if (!genl_has_listeners(&airoha_pon_mac_nl_family, net,
+				AIROHA_PON_MAC_NLGRP_MONITOR))
+		return;
+
+	msg = genlmsg_new(pmac_nl_size(mac), GFP_KERNEL);
+	if (!msg)
+		return;
+
+	hdr = genlmsg_put(msg, 0, 0, &airoha_pon_mac_nl_family, 0,
+			  AIROHA_PON_MAC_CMD_DEV_CHANGE_NTF);
+	if (!hdr || pmac_nl_fill(msg, mac, false)) {
+		nlmsg_free(msg);
+		return;
+	}
+	genlmsg_end(msg, hdr);
+
+	genlmsg_multicast_netns(&airoha_pon_mac_nl_family, net, msg, 0,
+				AIROHA_PON_MAC_NLGRP_MONITOR, GFP_KERNEL);
+}
+
+/* Send the last BER sample to the ber group. The caller holds mac->o.lock. */
+static void pmac_nl_ber(struct pmac *mac)
+{
+	struct net_device *ndev = airoha_pon_netdev(mac->pon);
+	struct net *net = dev_net(ndev);
+	struct sk_buff *msg;
+	void *hdr;
+
+	if (!genl_has_listeners(&airoha_pon_mac_nl_family, net,
+				AIROHA_PON_MAC_NLGRP_BER))
+		return;
+
+	msg = genlmsg_new(NLMSG_GOODSIZE, GFP_KERNEL);
+	if (!msg)
+		return;
+
+	hdr = genlmsg_put(msg, 0, 0, &airoha_pon_mac_nl_family, 0,
+			  AIROHA_PON_MAC_CMD_BER_NTF);
+	if (!hdr ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_DEV_IFINDEX, ndev->ifindex) ||
+	    pmac_nl_put_ber(msg, &mac->o)) {
+		nlmsg_free(msg);
+		return;
+	}
+	genlmsg_end(msg, hdr);
+
+	genlmsg_multicast_netns(&airoha_pon_mac_nl_family, net, msg, 0,
+				AIROHA_PON_MAC_NLGRP_BER, GFP_KERNEL);
+}
+
+/*
+ * Send an XGS-PON Reboot_ONU @m to the monitor group, with the activation
+ * state it arrived in; @other: it names another ONU's serial number. The
+ * caller holds mac->o.lock.
+ */
+static void pmac_nl_reboot(struct pmac *mac, const u8 *m, bool other)
+{
+	struct net_device *ndev = airoha_pon_netdev(mac->pon);
+	struct net *net = dev_net(ndev);
+	struct sk_buff *msg;
+	struct nlattr *nest;
+	void *hdr;
+
+	if (!genl_has_listeners(&airoha_pon_mac_nl_family, net,
+				AIROHA_PON_MAC_NLGRP_MONITOR))
+		return;
+
+	msg = genlmsg_new(NLMSG_GOODSIZE, GFP_KERNEL);
+	if (!msg)
+		return;
+
+	hdr = genlmsg_put(msg, 0, 0, &airoha_pon_mac_nl_family, 0,
+			  AIROHA_PON_MAC_CMD_REBOOT_NTF);
+	if (!hdr ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_DEV_IFINDEX, ndev->ifindex) ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_DEV_STATE, mac->o.state))
+		goto fail;
+
+	nest = nla_nest_start(msg, AIROHA_PON_MAC_A_DEV_REBOOT);
+	if (!nest ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_REBOOT_DEPTH, OCT(m, 13)) ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_REBOOT_IMAGE, OCT(m, 14)) ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_REBOOT_STATE_CONDITION, OCT(m, 15)) ||
+	    nla_put_u32(msg, AIROHA_PON_MAC_A_REBOOT_CALLS, OCT(m, 16) & 3) ||
+	    (other && nla_put_flag(msg, AIROHA_PON_MAC_A_REBOOT_OTHER_ONU)))
+		goto fail;
+	nla_nest_end(msg, nest);
+	genlmsg_end(msg, hdr);
+
+	genlmsg_multicast_netns(&airoha_pon_mac_nl_family, net, msg, 0,
+				AIROHA_PON_MAC_NLGRP_MONITOR, GFP_KERNEL);
+	return;
+
+fail:
+	nlmsg_free(msg);
+}
+
+static struct pmac *pmac_nl_find(struct net *net, u32 ifindex)
+{
+	struct pmac *mac;
+
+	lockdep_assert_held(&pmac_list_lock);
+
+	list_for_each_entry(mac, &pmac_list, node) {
+		struct net_device *ndev = airoha_pon_netdev(mac->pon);
+
+		if (ndev->ifindex == ifindex && net_eq(dev_net(ndev), net))
+			return mac;
+	}
+
+	return NULL;
+}
+
+int pmac_nl_pre_doit(const struct genl_split_ops *ops, struct sk_buff *skb,
+		     struct genl_info *info)
+{
+	struct pmac *mac;
+
+	if (GENL_REQ_ATTR_CHECK(info, AIROHA_PON_MAC_A_DEV_IFINDEX))
+		return -EINVAL;
+
+	mutex_lock(&pmac_list_lock);
+	mac = pmac_nl_find(genl_info_net(info),
+			   nla_get_u32(info->attrs[AIROHA_PON_MAC_A_DEV_IFINDEX]));
+	if (!mac) {
+		mutex_unlock(&pmac_list_lock);
+		NL_SET_BAD_ATTR(info->extack,
+				info->attrs[AIROHA_PON_MAC_A_DEV_IFINDEX]);
+		return -ENODEV;
+	}
+
+	mutex_lock(&mac->lock);
+	mutex_lock(&mac->o.lock);
+	info->user_ptr[0] = mac;
+
+	return 0;
+}
+
+void pmac_nl_post_doit(const struct genl_split_ops *ops, struct sk_buff *skb,
+		       struct genl_info *info)
+{
+	struct pmac *mac = info->user_ptr[0];
+
+	mutex_unlock(&mac->o.lock);
+	mutex_unlock(&mac->lock);
+	mutex_unlock(&pmac_list_lock);
+}
+
+/*
+ * The core sizes a dump's messages NLMSG_GOODSIZE until a read on the
+ * socket asked for more, and the first one is filled before any read: one
+ * device with a few T-CONTs and GEM ports does not fit, and the dump ends
+ * in -EMSGSIZE. Size each for the biggest device instead.
+ */
+int pmac_nl_pre_dumpit(struct netlink_callback *cb)
+{
+	struct net *net = sock_net(cb->skb->sk);
+	struct pmac *mac;
+	size_t size = 0;
+
+	mutex_lock(&pmac_list_lock);
+	list_for_each_entry(mac, &pmac_list, node) {
+		if (!net_eq(dev_net(airoha_pon_netdev(mac->pon)), net))
+			continue;
+		mutex_lock(&mac->lock);
+		size = max(size, pmac_nl_size(mac));
+		mutex_unlock(&mac->lock);
+	}
+	mutex_unlock(&pmac_list_lock);
+
+	cb->min_dump_alloc = nlmsg_total_size(GENL_HDRLEN + size);
+	return 0;
+}
+
+int airoha_pon_mac_nl_dev_get_doit(struct sk_buff *skb, struct genl_info *info)
+{
+	struct pmac *mac = info->user_ptr[0];
+	struct sk_buff *msg;
+	void *hdr;
+	int err;
+
+	msg = genlmsg_new(pmac_nl_size(mac), GFP_KERNEL);
+	if (!msg)
+		return -ENOMEM;
+
+	hdr = genlmsg_iput(msg, info);
+	if (!hdr) {
+		err = -EMSGSIZE;
+		goto err_free;
+	}
+
+	err = pmac_nl_fill(msg, mac, true);
+	if (err)
+		goto err_free;
+
+	genlmsg_end(msg, hdr);
+	return genlmsg_reply(msg, info);
+
+err_free:
+	nlmsg_free(msg);
+	return err;
+}
+
+int airoha_pon_mac_nl_dev_get_dumpit(struct sk_buff *skb,
+				     struct netlink_callback *cb)
+{
+	struct net *net = sock_net(skb->sk);
+	unsigned long idx = 0;
+	struct pmac *mac;
+	void *hdr;
+	int err = 0;
+
+	mutex_lock(&pmac_list_lock);
+	list_for_each_entry(mac, &pmac_list, node) {
+		if (!net_eq(dev_net(airoha_pon_netdev(mac->pon)), net))
+			continue;
+		if (idx++ < cb->args[0])
+			continue;
+
+		hdr = genlmsg_put(skb, NETLINK_CB(cb->skb).portid,
+				  cb->nlh->nlmsg_seq, &airoha_pon_mac_nl_family,
+				  NLM_F_MULTI, AIROHA_PON_MAC_CMD_DEV_GET);
+		if (!hdr) {
+			err = -EMSGSIZE;
+			break;
+		}
+
+		mutex_lock(&mac->lock);
+		mutex_lock(&mac->o.lock);
+		err = pmac_nl_fill(skb, mac, true);
+		mutex_unlock(&mac->o.lock);
+		mutex_unlock(&mac->lock);
+		if (err) {
+			genlmsg_cancel(skb, hdr);
+			break;
+		}
+
+		genlmsg_end(skb, hdr);
+		cb->args[0] = idx;
+	}
+	mutex_unlock(&pmac_list_lock);
+
+	return err;
+}
+
+static int pmac_nl_parse_tcont(struct genl_info *info, struct nlattr *attr,
+			       struct pmac_tcont_cfg *c)
+{
+	struct nlattr *tb[AIROHA_PON_MAC_A_TCONT_MAX + 1];
+	struct netlink_ext_ack *extack = info->extack;
+	unsigned int nw = 0;
+	struct nlattr *w;
+	int err, rem;
+
+	err = nla_parse_nested(tb, AIROHA_PON_MAC_A_TCONT_MAX, attr,
+			       airoha_pon_mac_tcont_nl_policy, extack);
+	if (err)
+		return err;
+
+	if (NL_REQ_ATTR_CHECK(extack, attr, tb, AIROHA_PON_MAC_A_TCONT_ALLOC_ID))
+		return -EINVAL;
+
+	if (tb[AIROHA_PON_MAC_A_TCONT_INDEX] ||
+	    tb[AIROHA_PON_MAC_A_TCONT_CPU_PACKETS] ||
+	    tb[AIROHA_PON_MAC_A_TCONT_FWD_PACKETS]) {
+		NL_SET_ERR_MSG_ATTR(extack, attr,
+				    "the T-CONT index and counters are reported only");
+		return -EINVAL;
+	}
+
+	memset(c, 0, sizeof(*c));
+	c->alloc = nla_get_u32(tb[AIROHA_PON_MAC_A_TCONT_ALLOC_ID]);
+	c->rate = nla_get_u32_default(tb[AIROHA_PON_MAC_A_TCONT_RATE], 0);
+	c->burst = nla_get_u32_default(tb[AIROHA_PON_MAC_A_TCONT_BURST], 0);
+
+	nla_for_each_nested_type(w, AIROHA_PON_MAC_A_TCONT_WEIGHT, attr, rem) {
+		if (nw == AIROHA_PON_TCONT_QUEUES) {
+			NL_SET_ERR_MSG_ATTR(extack, w, "more weights than queues");
+			return -EINVAL;
+		}
+		c->weights[nw++] = nla_get_u32(w);
+	}
+
+	if (!tb[AIROHA_PON_MAC_A_TCONT_STRICT]) {
+		if (nw) {
+			NL_SET_ERR_MSG_ATTR(extack, attr,
+					    "weights need a strict count");
+			return -EINVAL;
+		}
+		return 0;
+	}
+
+	c->sched = true;
+	c->strict = nla_get_u32(tb[AIROHA_PON_MAC_A_TCONT_STRICT]);
+	if (c->strict == AIROHA_PON_TCONT_QUEUES - 1) {
+		NL_SET_ERR_MSG_ATTR(extack, tb[AIROHA_PON_MAC_A_TCONT_STRICT],
+				    "one queue cannot share by weight alone");
+		return -EINVAL;
+	}
+	if (nw != (c->strict == AIROHA_PON_TCONT_QUEUES ? 0 :
+		   AIROHA_PON_TCONT_QUEUES)) {
+		NL_SET_ERR_MSG_ATTR(extack, attr,
+				    "one weight per queue, or none when all are strict");
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/* The ANI port device a GEM port or rule names, as the frame engine takes it */
+static int pmac_nl_parse_ifindex(struct genl_info *info, struct nlattr *attr,
+				 u32 *ifindex)
+{
+	struct pmac *mac = info->user_ptr[0];
+
+	*ifindex = attr ? nla_get_u32(attr) : 0;
+	if (airoha_pon_check_ifindex(mac->pon, *ifindex)) {
+		NL_SET_ERR_MSG_ATTR(info->extack, attr,
+				    "not an ANI port device of this PON interface");
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int pmac_nl_parse_gem(struct genl_info *info, struct nlattr *attr,
+			     struct pmac_gem_cfg *c)
+{
+	struct nlattr *tb[AIROHA_PON_MAC_A_GEM_MAX + 1];
+	struct netlink_ext_ack *extack = info->extack;
+	int err;
+
+	err = nla_parse_nested(tb, AIROHA_PON_MAC_A_GEM_MAX, attr,
+			       airoha_pon_mac_gem_nl_policy, extack);
+	if (err)
+		return err;
+
+	if (NL_REQ_ATTR_CHECK(extack, attr, tb, AIROHA_PON_MAC_A_GEM_PORT_ID))
+		return -EINVAL;
+
+	if (tb[AIROHA_PON_MAC_A_GEM_ENCRYPTED]) {
+		NL_SET_ERR_MSG_ATTR(extack, tb[AIROHA_PON_MAC_A_GEM_ENCRYPTED],
+				    "the OLT decides the encryption");
+		return -EINVAL;
+	}
+
+	if (tb[AIROHA_PON_MAC_A_GEM_RX_FRAMES] ||
+	    tb[AIROHA_PON_MAC_A_GEM_RX_PAYLOAD_BYTES] ||
+	    tb[AIROHA_PON_MAC_A_GEM_TX_FRAMES] ||
+	    tb[AIROHA_PON_MAC_A_GEM_TX_PAYLOAD_BYTES]) {
+		NL_SET_ERR_MSG_ATTR(extack, attr,
+				    "the GEM port counters are reported only");
+		return -EINVAL;
+	}
+
+	memset(c, 0, sizeof(*c));
+	c->port = nla_get_u32(tb[AIROHA_PON_MAC_A_GEM_PORT_ID]);
+	c->dir = nla_get_u32_default(tb[AIROHA_PON_MAC_A_GEM_DIRECTION], 0);
+	if (tb[AIROHA_PON_MAC_A_GEM_ALLOC_ID]) {
+		c->has_alloc = true;
+		c->alloc = nla_get_u32(tb[AIROHA_PON_MAC_A_GEM_ALLOC_ID]);
+	}
+	c->queue = nla_get_u32_default(tb[AIROHA_PON_MAC_A_GEM_QUEUE], 0);
+	c->key_ring = nla_get_u32_default(tb[AIROHA_PON_MAC_A_GEM_KEY_RING],
+					  AIROHA_PON_MAC_KEY_RING_NONE);
+	err = pmac_nl_parse_ifindex(info, tb[AIROHA_PON_MAC_A_GEM_ANI_IFINDEX],
+				    &c->ifindex);
+	if (err)
+		return err;
+
+	if ((c->dir & AIROHA_PON_MAC_DIRECTION_UPSTREAM) && !c->has_alloc) {
+		NL_SET_ERR_MSG_ATTR(extack, attr,
+				    "an upstream GEM port needs an Alloc-ID");
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int pmac_nl_parse_rule(struct genl_info *info, struct nlattr *attr,
+			      struct airoha_pon_rule *r)
+{
+	struct nlattr *tb[AIROHA_PON_MAC_A_RULE_MAX + 1];
+	struct netlink_ext_ack *extack = info->extack;
+	u32 ifindex;
+	int err;
+
+	err = nla_parse_nested(tb, AIROHA_PON_MAC_A_RULE_MAX, attr,
+			       airoha_pon_mac_rule_nl_policy, extack);
+	if (err)
+		return err;
+
+	if (NL_REQ_ATTR_CHECK(extack, attr, tb, AIROHA_PON_MAC_A_RULE_PORT_ID))
+		return -EINVAL;
+
+	if (tb[AIROHA_PON_MAC_A_RULE_UNTAGGED] && tb[AIROHA_PON_MAC_A_RULE_VID]) {
+		NL_SET_ERR_MSG_ATTR(extack, tb[AIROHA_PON_MAC_A_RULE_VID],
+				    "an untagged frame has no VLAN ID");
+		return -EINVAL;
+	}
+
+	if (tb[AIROHA_PON_MAC_A_RULE_UNTAGGED])
+		r->vid = AIROHA_PON_VID_UNTAGGED;
+	else
+		r->vid = nla_get_u32_default(tb[AIROHA_PON_MAC_A_RULE_VID],
+					     AIROHA_PON_VID_ANY);
+	r->pcp = nla_get_u32_default(tb[AIROHA_PON_MAC_A_RULE_PCP],
+				     AIROHA_PON_PCP_ANY);
+	r->port_id = nla_get_u32(tb[AIROHA_PON_MAC_A_RULE_PORT_ID]);
+
+	err = pmac_nl_parse_ifindex(info, tb[AIROHA_PON_MAC_A_RULE_ANI_IFINDEX],
+				    &ifindex);
+	if (err)
+		return err;
+
+	r->ifindex = ifindex;
+	return 0;
+}
+
+/* the three tables of one table-set request */
+struct pmac_tables {
+	unsigned int num_tconts;
+	struct pmac_tcont_cfg tconts[PMAC_SLOTS];
+	unsigned int num_gems;
+	struct pmac_gem_cfg gems[AIROHA_PON_MAX_GEMS];
+	unsigned int num_rules;
+	struct airoha_pon_rule rules[AIROHA_PON_MAX_RULES];
+};
+
+static int pmac_nl_add_tcont(struct genl_info *info, struct nlattr *attr,
+			     struct pmac_tables *t)
+{
+	struct pmac_tcont_cfg *c = &t->tconts[t->num_tconts];
+	unsigned int i;
+	int err;
+
+	if (t->num_tconts == PMAC_SLOTS) {
+		NL_SET_ERR_MSG_ATTR(info->extack, attr, "too many T-CONTs");
+		return -E2BIG;
+	}
+
+	err = pmac_nl_parse_tcont(info, attr, c);
+	if (err)
+		return err;
+
+	for (i = 0; i < t->num_tconts; i++)
+		if (t->tconts[i].alloc == c->alloc) {
+			NL_SET_ERR_MSG_ATTR(info->extack, attr,
+					    "the Alloc-ID repeats");
+			return -EINVAL;
+		}
+
+	t->num_tconts++;
+	return 0;
+}
+
+static int pmac_nl_add_gem(struct genl_info *info, struct nlattr *attr,
+			   struct pmac_tables *t)
+{
+	struct pmac_gem_cfg *c = &t->gems[t->num_gems];
+	unsigned int i;
+	int err;
+
+	if (t->num_gems == AIROHA_PON_MAX_GEMS) {
+		NL_SET_ERR_MSG_ATTR(info->extack, attr, "too many GEM ports");
+		return -E2BIG;
+	}
+
+	err = pmac_nl_parse_gem(info, attr, c);
+	if (err)
+		return err;
+
+	for (i = 0; i < t->num_gems; i++)
+		if (t->gems[i].port == c->port) {
+			NL_SET_ERR_MSG_ATTR(info->extack, attr,
+					    "the GEM port repeats");
+			return -EINVAL;
+		}
+
+	t->num_gems++;
+	return 0;
+}
+
+static int pmac_nl_add_rule(struct genl_info *info, struct nlattr *attr,
+			    struct pmac_tables *t)
+{
+	int err;
+
+	if (t->num_rules == AIROHA_PON_MAX_RULES) {
+		NL_SET_ERR_MSG_ATTR(info->extack, attr, "too many rules");
+		return -E2BIG;
+	}
+
+	err = pmac_nl_parse_rule(info, attr, &t->rules[t->num_rules]);
+	if (err)
+		return err;
+
+	t->num_rules++;
+	return 0;
+}
+
+/*
+ * Every check table-set makes: the frame engine refuses nothing these let
+ * through, so a check-only request fails where the real one would.
+ */
+static int pmac_nl_parse_tables(struct genl_info *info, struct pmac_tables *t)
+{
+	struct nlattr *attr;
+	int err = 0, rem;
+
+	nla_for_each_attr(attr, genlmsg_data(info->genlhdr),
+			  genlmsg_len(info->genlhdr), rem) {
+		switch (nla_type(attr)) {
+		case AIROHA_PON_MAC_A_DEV_TCONT:
+			err = pmac_nl_add_tcont(info, attr, t);
+			break;
+		case AIROHA_PON_MAC_A_DEV_GEM:
+			err = pmac_nl_add_gem(info, attr, t);
+			break;
+		case AIROHA_PON_MAC_A_DEV_RULE:
+			err = pmac_nl_add_rule(info, attr, t);
+			break;
+		}
+		if (err)
+			return err;
+	}
+
+	return 0;
+}
+
+int airoha_pon_mac_nl_table_set_doit(struct sk_buff *skb,
+				     struct genl_info *info)
+{
+	struct pmac *mac = info->user_ptr[0];
+	struct airoha_pon_gem *gems;
+	struct pmac_tables *t;
+	int err;
+
+	t = kzalloc(sizeof(*t), GFP_KERNEL);
+	if (!t)
+		return -ENOMEM;
+
+	err = pmac_nl_parse_tables(info, t);
+	if (err || info->attrs[AIROHA_PON_MAC_A_DEV_CHECK])
+		goto out;
+
+	/*
+	 * The GEM ports and the rules change in one update, and nothing
+	 * changes when it fails: only a lack of memory fails it, not an ANI
+	 * port device removed since the parse.
+	 */
+	gems = pmac_build_gems(mac, t->gems, t->num_gems);
+	if (!gems) {
+		err = -ENOMEM;
+		goto out;
+	}
+	err = airoha_pon_set_table(mac->pon, gems, t->num_gems,
+				   t->rules, t->num_rules);
+	kfree(gems);
+	if (err)
+		goto out;
+
+	memcpy(mac->tconts, t->tconts, t->num_tconts * sizeof(*t->tconts));
+	mac->num_tconts = t->num_tconts;
+	memcpy(mac->gems, t->gems, t->num_gems * sizeof(*t->gems));
+	mac->num_gems = t->num_gems;
+	memcpy(mac->rules, t->rules, t->num_rules * sizeof(*t->rules));
+	mac->num_rules = t->num_rules;
+
+	pmac_sync_tconts(mac);
+	pmac_sync_ports(mac);
+
+out:
+	kfree(t);
+	return err;
+}
+
+static void pmac_put_port(void *data)
+{
+	airoha_pon_put(data);
+}
+
+static int pmac_get_port(struct pmac *mac)
+{
+	struct device_node *np;
+
+	np = of_parse_phandle(mac->dev->of_node, "airoha,pon-port", 0);
+	if (!np)
+		return dev_err_probe(mac->dev, -EINVAL, "no airoha,pon-port\n");
+
+	mac->pon = airoha_pon_get(mac->dev, np);
+	of_node_put(np);
+	if (IS_ERR(mac->pon))
+		return dev_err_probe(mac->dev, PTR_ERR(mac->pon),
+				     "cannot take the PON port\n");
+
+	return devm_add_action_or_reset(mac->dev, pmac_put_port, mac->pon);
+}
+
+static int pmac_get_gpios(struct pmac *mac)
+{
+	struct device *dev = mac->dev;
+
+	/* both optics unpowered and the fibre on the GPON optic until a start */
+	mac->power = devm_gpiod_get_array_optional(dev, "optic-power",
+						   GPIOD_OUT_LOW);
+	if (IS_ERR(mac->power))
+		return dev_err_probe(dev, PTR_ERR(mac->power),
+				     "cannot take optic-power-gpios\n");
+
+	mac->select = devm_gpiod_get_array_optional(dev, "optic-select",
+						    GPIOD_OUT_LOW);
+	if (IS_ERR(mac->select))
+		return dev_err_probe(dev, PTR_ERR(mac->select),
+				     "cannot take optic-select-gpios\n");
+
+	mac->los = devm_gpiod_get_array_optional(dev, "los", GPIOD_IN);
+	if (IS_ERR(mac->los))
+		return dev_err_probe(dev, PTR_ERR(mac->los),
+				     "cannot take los-gpios\n");
+
+	if ((mac->power && mac->power->ndescs != 2) ||
+	    (mac->select && mac->select->ndescs > 2) ||
+	    (mac->los && mac->los->ndescs != 2))
+		return dev_err_probe(dev, -EINVAL,
+				     "wrong number of optics lines\n");
+
+	return 0;
+}
+
+/*
+ * The power-failure interrupt, the MAC block's second line. Its latch is in
+ * the system controller, and is cleared before the interrupt is requested.
+ */
+static int pmac_get_power_fail(struct platform_device *pdev, struct pmac *mac)
+{
+	struct device *dev = mac->dev;
+	struct device_node *np;
+	int err;
+
+	mac->pf_irq = platform_get_irq_byname(pdev, "power-fail");
+	if (mac->pf_irq < 0)
+		return mac->pf_irq;
+
+	np = of_parse_phandle(dev->of_node, "airoha,system-controller", 0);
+	if (!np)
+		return dev_err_probe(dev, -EINVAL,
+				     "no system controller for the power-fail latch\n");
+	mac->scu = device_node_to_regmap(np);
+	of_node_put(np);
+	if (IS_ERR(mac->scu))
+		return dev_err_probe(dev, PTR_ERR(mac->scu),
+				     "system controller not reachable\n");
+
+	err = regmap_write_bits(mac->scu, SCU_PF_LATCH_REG, SCU_PF_LATCH,
+				SCU_PF_LATCH);
+	if (err)
+		return err;
+
+	return devm_request_threaded_irq(dev, mac->pf_irq, pmac_pf_irq,
+					 pmac_pf_thread, IRQF_ONESHOT,
+					 "pon-mac-power-fail", mac);
+}
+
+static void pmac_gem_counts_free(void *data)
+{
+	struct pmac *mac = data;
+	struct pmac_gem_count *c;
+	unsigned long port;
+
+	xa_for_each(&mac->o.gem_counts, port, c)
+		kfree(c);
+	xa_destroy(&mac->o.gem_counts);
+}
+
+static int pmac_onu_init(struct pmac *mac)
+{
+	struct pmac_onu *o = &mac->o;
+	int err;
+
+	err = devm_mutex_init(mac->dev, &o->lock);
+	if (err)
+		return err;
+
+	INIT_WORK(&o->link_work, pmac_link_work);
+	INIT_DELAYED_WORK(&o->to1.work, pmac_to1_work);
+	INIT_DELAYED_WORK(&o->to2.work, pmac_to2_work);
+	INIT_DELAYED_WORK(&o->ber.work, pmac_ber_work);
+	INIT_DELAYED_WORK(&o->index_refresh.work, pmac_index_work);
+	INIT_DELAYED_WORK(&o->key_a.work, pmac_x_key_a_work);
+	INIT_DELAYED_WORK(&o->key_b.work, pmac_x_key_b_work);
+	INIT_DELAYED_WORK(&o->watch.work, pmac_watch_work);
+	INIT_DELAYED_WORK(&o->buf_share.work, pmac_buf_share_work);
+	INIT_WORK(&o->mib_work, pmac_mib_work);
+	xa_init(&o->gem_counts);
+
+	return devm_add_action_or_reset(mac->dev, pmac_gem_counts_free, mac);
+}
+
+static void pmac_lamp_unregister(void *data)
+{
+	led_trigger_unregister_simple(data);
+}
+
+/*
+ * One device per SoC, so one trigger name. A failed registration leaves
+ * @lamp NULL, which every event and the unregistration take as no trigger.
+ */
+static int pmac_lamp_init(struct pmac *mac)
+{
+	spin_lock_init(&mac->lamp_lock);
+	led_trigger_register_simple("pon-link", &mac->lamp);
+
+	return devm_add_action_or_reset(mac->dev, pmac_lamp_unregister,
+					mac->lamp);
+}
+
+static int pmac_redetect_ms_get(void *data, u64 *val)
+{
+	struct pmac *mac = data;
+
+	*val = READ_ONCE(mac->redetect_ms);
+	return 0;
+}
+
+/* the next period scheduled takes it; one already scheduled runs out */
+static int pmac_redetect_ms_set(void *data, u64 val)
+{
+	struct pmac *mac = data;
+
+	if (val < PMAC_REDETECT_MIN_MS || val > U32_MAX)
+		return -EINVAL;
+	WRITE_ONCE(mac->redetect_ms, val);
+	return 0;
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(pmac_redetect_ms_fops, pmac_redetect_ms_get,
+			 pmac_redetect_ms_set, "%llu\n");
+
+static void pmac_debugfs_remove(void *data)
+{
+	debugfs_remove(data);
+}
+
+/* debugfs <device>/redetect_ms; without debugfs the period stays fixed */
+static int pmac_debugfs_init(struct pmac *mac)
+{
+	struct dentry *dir;
+
+	mac->redetect_ms = PMAC_REDETECT_MS;
+	dir = debugfs_create_dir(dev_name(mac->dev), NULL);
+	debugfs_create_file_unsafe("redetect_ms", 0600, dir, mac,
+				   &pmac_redetect_ms_fops);
+
+	return devm_add_action_or_reset(mac->dev, pmac_debugfs_remove, dir);
+}
+
+static int pmac_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct pmac *mac;
+	int err;
+
+	mac = devm_kzalloc(dev, sizeof(*mac), GFP_KERNEL);
+	if (!mac)
+		return -ENOMEM;
+
+	mac->dev = dev;
+	mac->mode = PMAC_AUTO;
+	mac->line = PMAC_AUTO;
+	mac->dark_line = PMAC_AUTO;
+	raw_spin_lock_init(&mac->up_lock);
+	err = devm_mutex_init(dev, &mac->lock);
+	if (err)
+		return err;
+	mac->mic = dmam_alloc_coherent(dev, PMAC_X_MIC_LEN, &mac->mic_dma,
+				       GFP_KERNEL);
+	if (!mac->mic)
+		return -ENOMEM;
+	INIT_DELAYED_WORK(&mac->redetect, pmac_redetect_work);
+
+	err = pmac_debugfs_init(mac);
+	if (err)
+		return err;
+
+	err = pmac_lamp_init(mac);
+	if (err)
+		return err;
+
+	err = pmac_onu_init(mac);
+	if (err)
+		return err;
+
+	err = devm_mutex_init(dev, &mac->fec.lock);
+	if (err)
+		return err;
+	INIT_DELAYED_WORK(&mac->fec.work, pmac_fec_work);
+
+	err = devm_mutex_init(dev, &mac->xcnt.lock);
+	if (err)
+		return err;
+	INIT_DELAYED_WORK(&mac->xcnt.work, pmac_xcnt_work);
+
+	mac->gpon = devm_platform_ioremap_resource_byname(pdev, "gpon");
+	if (IS_ERR(mac->gpon))
+		return PTR_ERR(mac->gpon);
+
+	mac->xgs = devm_platform_ioremap_resource_byname(pdev, "xgspon");
+	if (IS_ERR(mac->xgs))
+		return PTR_ERR(mac->xgs);
+
+	mac->reset = devm_reset_control_get_exclusive(dev, NULL);
+	if (IS_ERR(mac->reset))
+		return dev_err_probe(dev, PTR_ERR(mac->reset),
+				     "cannot take the MAC reset\n");
+
+	mac->phy = devm_of_phy_get_by_index(dev, dev->of_node, 0);
+	if (IS_ERR(mac->phy))
+		return dev_err_probe(dev, PTR_ERR(mac->phy),
+				     "cannot take the PON PHY\n");
+
+	/* the laser driver, the second PHY when the board has one */
+	if (of_count_phandle_with_args(dev->of_node, "phys",
+				       "#phy-cells") > 1) {
+		mac->laser = devm_of_phy_get_by_index(dev, dev->of_node, 1);
+		if (IS_ERR(mac->laser))
+			return dev_err_probe(dev, PTR_ERR(mac->laser),
+					     "cannot take the laser driver\n");
+	}
+
+	err = pmac_get_gpios(mac);
+	if (err)
+		return err;
+
+	mac->irq = platform_get_irq_byname(pdev, "mac");
+	if (mac->irq < 0)
+		return mac->irq;
+
+	/* PLOAM handling opens and closes T-CONTs, which sleeps */
+	err = devm_request_threaded_irq(dev, mac->irq, NULL, pmac_mac_irq,
+					IRQF_ONESHOT | IRQF_NO_AUTOEN,
+					"pon-mac", mac);
+	if (err)
+		return err;
+
+	err = pmac_get_port(mac);
+	if (err)
+		return err;
+
+	err = pmac_omci_init(mac);
+	if (err)
+		return err;
+
+	airoha_pon_set_carrier(mac->pon, false);
+	platform_set_drvdata(pdev, mac);
+
+	/* last: its thread stops the line, which needs all of the above */
+	err = pmac_get_power_fail(pdev, mac);
+	if (err)
+		return err;
+
+	mutex_lock(&pmac_list_lock);
+	list_add_tail(&mac->node, &pmac_list);
+	mutex_unlock(&pmac_list_lock);
+
+	return 0;
+}
+
+static void pmac_remove(struct platform_device *pdev)
+{
+	struct pmac *mac = platform_get_drvdata(pdev);
+
+	/* waits out the netlink operation that holds the device */
+	mutex_lock(&pmac_list_lock);
+	list_del(&mac->node);
+	mutex_unlock(&pmac_list_lock);
+
+	mutex_lock(&mac->lock);
+	pmac_stop_locked(mac);
+	mutex_unlock(&mac->lock);
+	/* stopped, so a test that is running finds nothing to do */
+	cancel_delayed_work_sync(&mac->redetect);
+	memzero_explicit(mac->password, sizeof(mac->password));
+	memzero_explicit(mac->reg_id, sizeof(mac->reg_id));
+	memzero_explicit(mac->o.key, sizeof(mac->o.key));
+	memzero_explicit(mac->o.kek, sizeof(mac->o.kek));
+	pmac_x_drop_msk(&mac->o);
+	memzero_explicit(mac->o.x_key, sizeof(mac->o.x_key));
+}
+
+static const struct of_device_id pmac_of_match[] = {
+	{ .compatible = "airoha,en7581-pon-mac" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, pmac_of_match);
+
+static struct platform_driver pmac_driver = {
+	.probe = pmac_probe,
+	.remove = pmac_remove,
+	.driver = {
+		.name = "airoha-pon-mac",
+		.of_match_table = pmac_of_match,
+		.dev_groups = pmac_groups,
+	},
+};
+
+static int __init pmac_init(void)
+{
+	int err;
+
+	err = genl_register_family(&airoha_pon_mac_nl_family);
+	if (err)
+		return err;
+
+	err = platform_driver_register(&pmac_driver);
+	if (err)
+		genl_unregister_family(&airoha_pon_mac_nl_family);
+
+	return err;
+}
+module_init(pmac_init);
+
+static void __exit pmac_exit(void)
+{
+	platform_driver_unregister(&pmac_driver);
+	genl_unregister_family(&airoha_pon_mac_nl_family);
+}
+module_exit(pmac_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Airoha EN7581 GPON and XGS-PON MAC");
