diff --git a/drivers/net/ethernet/airoha/pon/Kconfig b/drivers/net/ethernet/airoha/pon/Kconfig
new file mode 100644
index 0000000..d7cdf39
--- /dev/null
+++ b/drivers/net/ethernet/airoha/pon/Kconfig
@@ -0,0 +1,26 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# PON MAC drivers for Airoha SoCs
+#
+
+config NET_AIROHA_PON_MAC
+	tristate "Airoha EN7581 GPON and XGS-PON MAC driver"
+	depends on NET_AIROHA
+	depends on PHY_EN7581_PON
+	depends on PHY_EN7572
+	depends on OF
+	select CRC32
+	select CRYPTO_LIB_AES
+	select CRYPTO_LIB_UTILS
+	help
+	  Say Y here to add support for the PON MACs of the Airoha EN7581
+	  SoC: the GPON (ITU-T G.984.3) and XGS-PON (ITU-T G.9807.1)
+	  transmission convergence blocks. It drives the PON PHY, the
+	  optics and their laser driver, and sends its traffic through the
+	  frame engine port that the devicetree marks as the PON interface.
+	  The OMCI channel is a netdev named omci for a userspace OMCI
+	  agent, which sets the GEM
+	  ports and T-CONTs through the airoha-pon-mac netlink family.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called airoha-pon-mac.
diff --git a/drivers/net/ethernet/airoha/pon/Makefile b/drivers/net/ethernet/airoha/pon/Makefile
new file mode 100644
index 0000000..b0cd60a
--- /dev/null
+++ b/drivers/net/ethernet/airoha/pon/Makefile
@@ -0,0 +1,4 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+obj-$(CONFIG_NET_AIROHA_PON_MAC)	+= airoha-pon-mac.o
+airoha-pon-mac-y			:= airoha_pon_mac.o airoha_pon_mac_nl.o
diff --git a/drivers/net/ethernet/airoha/pon/airoha_pon_mac.c b/drivers/net/ethernet/airoha/pon/airoha_pon_mac.c
new file mode 100644
index 0000000..04adf7b
--- /dev/null
+++ b/drivers/net/ethernet/airoha/pon/airoha_pon_mac.c
@@ -0,0 +1,7336 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Airoha EN7581 PON MAC: the GPON (ITU-T G.984.3) and XGS-PON (ITU-T
+ * G.9807.1) transmission convergence blocks, as one device.
+ *
+ * It takes the PON PHY, the MAC block reset and the frame engine's PON
+ * port, powers the optic of the line mode it runs, and holds the ONU
+ * identity the OLT checks: the serial number, and the password (GPON) or
+ * registration ID (XGS-PON). Userspace sets those and starts the MAC
+ * through the device's sysfs attributes; see
+ * Documentation/ABI/testing/sysfs-driver-airoha-pon-mac.
+ *
+ * A start leaves the chosen MAC at O1 with its traffic interfaces stopped
+ * and every interrupt masked, and powers the PHY on. The activation state
+ * machine of that line takes it from there: the PHY's downstream ready
+ * report moves it to O2 (O2-3 in XGS-PON), and the OLT's PLOAM messages
+ * through ranging to O5, where the OLT's Alloc-IDs become the frame
+ * engine's T-CONTs and the carrier goes on.
+ *
+ * The OMCI channel is a netdev without a hardware header, one bare OMCI
+ * message per frame, for the userspace OMCI agent, on the OMCC GEM port the
+ * OLT assigned. The MAC adds and removes the message's trailer: the CRC in
+ * GPON, the MIC under the OMCI integrity key in XGS-PON. An XGS-PON message
+ * that arrives with its MIC still on has it checked by the driver, which
+ * checks the MIC of every downstream PLOAM message as well.
+ */
+
+#include <crypto/aes.h>
+#include <crypto/utils.h>
+#include <linux/bitfield.h>
+#include <linux/bitmap.h>
+#include <linux/bitops.h>
+#include <linux/bitrev.h>
+#include <linux/bits.h>
+#include <linux/ctype.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/gpio/consumer.h>
+#include <linux/hex.h>
+#include <linux/if_arp.h>
+#include <linux/if_vlan.h>
+#include <linux/if_ether.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/ktime.h>
+#include <linux/leds.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/netdevice.h>
+#include <linux/of.h>
+#include <linux/phy/en7572.h>
+#include <linux/phy/en7581-pon.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/random.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+#include <linux/skbuff.h>
+#include <linux/soc/airoha/airoha_pon.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+#include <linux/xarray.h>
+#include <net/genetlink.h>
+#include <net/netlink.h>
+#include <net/sock.h>
+
+#include "airoha_pon_mac_nl.h"
+
+/* GPON MAC registers, from the start of its window */
+#define REG_G_ONU		0x000
+#define   REG_G_ONU_VALID	BIT(15)
+#define   REG_G_ONU_NUM		GENMASK(7, 0)
+#define REG_G_UPSTREAM		0x004
+#define   REG_G_UPSTREAM_DATA	BIT(16)
+#define   REG_G_UPSTREAM_DBRU	GENMASK(7, 0)
+#define REG_G_IRQ_STATUS	0x008
+#define REG_G_IRQ_ENABLE	0x00c
+/* T-CONT slot n is one 16-bit half of a word, the odd slot the upper */
+#define REG_G_SLOT_PAIR(n)	(0x020 + 4 * ((n) / 2))
+#define   REG_G_SLOT_VALID	BIT(15)
+#define   REG_G_SLOT_ALLOC	GENMASK(11, 0)
+#define REG_G_PORT_CMD		0x040
+#define   REG_G_PORT_CMD_GO	BIT(31)
+#define   REG_G_PORT_CMD_CRYPT	BIT(17)
+#define   REG_G_PORT_CMD_VALID	BIT(16)
+#define   REG_G_PORT_CMD_ID	GENMASK(11, 0)
+#define REG_G_PORT_DONE		0x044
+#define   REG_G_PORT_DONE_BIT	BIT(31)
+#define REG_G_OMCC		0x048
+#define   REG_G_OMCC_VALID	BIT(16)
+#define   REG_G_OMCC_ID		GENMASK(11, 0)
+#define REG_G_UP_MSG		0x054
+#define REG_G_DOWN_LEVEL	0x058
+#define   REG_G_DOWN_WORDS	GENMASK(7, 0)
+#define REG_G_DOWN_MSG		0x05c
+#define REG_G_KEY_AT		0x060
+#define   REG_G_KEY_AT_FRAME	GENMASK(29, 0)
+/* key word 3 holds key bytes 0-3 and word 0 bytes 12-15, byte 0 at the top */
+#define REG_G_KEY(n)		(0x074 + 4 * (n))
+#define REG_G_KEY_CMD		0x084
+#define   REG_G_KEY_CMD_NOW	BIT(0)
+#define   REG_G_KEY_CMD_DONE	BIT(31)
+#define REG_G_GUARD		0x094
+#define   REG_G_GUARD_BITS	GENMASK(7, 0)
+#define REG_G_PREAMBLE		0x098
+#define   REG_G_PREAMBLE_T1	GENMASK(7, 0)
+#define   REG_G_PREAMBLE_T2	GENMASK(15, 8)
+#define REG_G_TYPE3		0x09c
+#define   REG_G_TYPE3_RANGING	GENMASK(7, 0)
+#define   REG_G_TYPE3_OPER	GENMASK(15, 8)
+#define   REG_G_TYPE3_VALID	BIT(24)
+#define REG_G_PRE_EQD		0x0a4
+#define   REG_G_PRE_EQD_ON	BIT(31)
+#define   REG_G_PRE_EQD_VAL	GENMASK(15, 0)
+#define REG_G_DELAY_BYTES		0x0a8
+#define REG_G_RESPONSE		0x0ac
+#define   REG_G_RESPONSE_VAL	GENMASK(15, 0)
+#define REG_G_SN_HI		0x0b0
+#define REG_G_SN_LO		0x0b4
+#define REG_G_STATE		0x0bc
+#define   REG_G_STATE_NUM	GENMASK(2, 0)
+#define REG_G_TOD		0x0e4
+#define   REG_G_TOD_PERIOD	GENMASK(7, 0)
+/* one counter of one GEM port; bit 24 would clear it as it is read */
+#define REG_G_GEM_MIB		0x120
+#define   REG_G_GEM_MIB_DONE	BIT(30)
+#define   REG_G_GEM_MIB_COUNTER	GENMASK(18, 16)
+#define   REG_G_GEM_MIB_PORT	GENMASK(11, 0)
+#define REG_G_GEM_MIB_LO	0x124
+#define REG_G_GEM_MIB_HI	0x128
+/* the GEM port index table, one entry per block of 16 Port-IDs */
+#define REG_G_GEM_INDEX		0x140
+#define   REG_G_GEM_INDEX_WRITE	BIT(31)
+#define   REG_G_GEM_INDEX_NUM	GENMASK(23, 16)
+#define   REG_G_GEM_INDEX_VAL	GENMASK(8, 0)
+#define REG_G_GEM_INDEX_DONE	0x144
+#define   REG_G_GEM_INDEX_DONE_BIT	BIT(31)
+#define REG_G_IF_STOP		0x160
+#define   REG_G_IF_STOP_HOLD	BIT(4)
+/* T-CONT slots 16 to 31 are written one at a time through a select word */
+#define REG_G_SLOT_UPPER	0x180
+#define   REG_G_SLOT_UPPER_GO	BIT(31)
+#define   REG_G_SLOT_UPPER_VALID	BIT(27)
+#define   REG_G_SLOT_UPPER_NUM	GENMASK(19, 16)
+#define   REG_G_SLOT_UPPER_ALLOC	GENMASK(11, 0)
+#define REG_G_SLOT_UPPER_DONE	0x184
+#define   REG_G_SLOT_UPPER_DONE_BIT	BIT(31)
+#define REG_G_CNT_MODE		0x200
+#define   REG_G_CNT_MODE_BIT	BIT(26)
+#define REG_G_TRIM		0x208
+#define   REG_G_TRIM_VAL	GENMASK(15, 8)
+#define REG_G_IDLE_GEM		0x20c
+#define   REG_G_IDLE_GEM_VAL	GENMASK(15, 0)
+#define REG_G_PF_MODE		0x21c
+#define   REG_G_PF_MODE_AUTO	BIT(8)
+#define REG_G_GRANT_FILTER	0x220
+#define   REG_G_GRANT_FILTER_PF	(BIT(24) | BIT(17))
+#define REG_G_ERR_LATCH(n)	(0x228 + 4 * (n))
+#define REG_G_RDI_COUNT		0x264
+#define   REG_G_RDI_COUNT_VAL	GENMASK(31, 16)
+#define REG_G_RDI_CAUSE		0x268
+#define   REG_G_RDI_CAUSE_ALL	GENMASK(31, 27)
+#define   REG_G_RDI_CAUSE_LIMIT	GENMASK(3, 0)
+#define REG_G_SUPERFRAME	0x358
+#define REG_G_TX_PHASE		0x35c
+#define   REG_G_TX_PHASE_BYTES	GENMASK(1, 0)
+#define REG_G_DROP		0x360
+#define   REG_G_DROP_EBL	BIT(8)
+#define   REG_G_DROP_UO		BIT(0)
+#define REG_G_CAP_CTRL		0x368
+#define   REG_G_CAP_CTRL_ALL	(BIT(31) | GENMASK(3, 0))
+#define REG_G_CAP_MODE		0x37c
+#define   REG_G_CAP_MODE_BIT	BIT(27)
+#define REG_G_CAP_FLUSH		0x380
+#define   REG_G_CAP_FLUSH_ALL	GENMASK(2, 0)
+#define REG_G_LOGIC		0x3a0
+#define   REG_G_LOGIC_RUN	BIT(0)
+#define REG_G_SLEEP_CTRL	0x3a4
+#define   REG_G_SLEEP_LOAD	BIT(30)
+#define REG_G_SLEEP_COUNT	0x3a8
+
+/* GPON MAC interrupt causes the driver acts on */
+#define G_IRQ_PLOAM		BIT(0)
+#define G_IRQ_UNUSED_1		BIT(1)
+#define G_IRQ_GRANT_CLASH	BIT(18)
+#define G_IRQ_STOP_TIME		BIT(30)
+/* the causes enabled in standby and beyond */
+#define G_IRQ_ENABLED		0xf7ff89fd
+
+/* GPON MAC settings of the standby bring-up */
+#define G_DBA_BLOCK_BYTES	48
+#define G_RESPONSE_TIME		0x577
+#define G_TOD_PERIOD		0xa
+#define G_TRIM			0x0d
+#define G_IDLE_GEM		0x1a
+#define G_RDI_REPEATS		10000
+#define G_RDI_LIMIT		2
+/* the guard time the MAC and PHY use, whatever Upstream Overhead asks */
+#define G_GUARD_BITS		0x14
+
+/*
+ * 10G MAC registers, from the start of its window. A 128-bit key takes four
+ * words, the last holding octets 1-4 and the first octets 13-16, each word
+ * with its lowest-numbered octet in bits 31:24.
+ */
+#define REG_X_ENABLE		0x000
+#define   REG_X_ENABLE_RUN	BIT(0)
+#define REG_X_IF_STOP		0x004
+#define REG_X_SN_HI		0x00c
+#define REG_X_SN_LO		0x010
+#define REG_X_ONU		0x014
+#define   REG_X_ONU_VALID	BIT(15)
+#define   REG_X_ONU_NUM		GENMASK(9, 0)
+#define   REG_X_ONU_NONE	0x3ff
+/* octets 4n + 1 to 4n + 4 of the registration ID, the first at the top */
+#define REG_X_REG_ID(n)		(0x038 - 4 * (n))
+#define REG_X_IRQ_ENABLE		0x040
+#define REG_X_IRQ_STATUS		0x044
+/* error latches, emptied on every interrupt */
+#define REG_X_QUEUE_ERR		0x050
+#define REG_X_TX_ERR		0x054
+#define REG_X_RX_ERR		0x058
+#define REG_X_STATE		0x104
+#define   REG_X_STATE_NUM	GENMASK(3, 0)
+#define REG_X_RESPONSE		0x108
+#define   REG_X_RESPONSE_VAL	GENMASK(13, 0)
+#define REG_X_EQD		0x114
+/* one byte per burst profile, profile n in byte n */
+#define REG_X_PROFILE		0x11c
+#define   REG_X_PROFILE_VERSION	GENMASK(7, 4)
+#define   REG_X_PROFILE_VALID	BIT(0)
+/* each burst profile's overhead in octets, two profiles to a word */
