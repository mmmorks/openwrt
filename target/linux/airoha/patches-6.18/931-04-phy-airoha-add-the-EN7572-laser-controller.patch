+++ b/include/linux/phy/en7572.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Airoha EN7572 PON laser driver: what a PON MAC needs beyond the generic
+ * PHY API.
+ *
+ * The chip is a generic PHY. The MAC (or whatever picks the PON mode) selects
+ * the mode with phy_set_mode_ext(phy, PHY_MODE_ETHERNET, EN7581_PON_GPON or
+ * EN7581_PON_XGSPON) from <linux/phy/en7581-pon.h>, then phy_power_on()
+ * loads and starts the chip with that mode's calibration table. To change
+ * mode: phy_power_off(), phy_set_mode_ext() with the other mode,
+ * phy_power_on(). phy_power_off() writes nothing to the chip.
+ *
+ * In XGS-PON the chip also needs its rate select, which the MAC sets with
+ * en7572_phy_set_xgspon_rate() once its XGS-PON MAC is up.
+ *
+ * Context: every function here sleeps (the chip is on I2C).
+ */
+
+#ifndef __LINUX_PHY_EN7572_H
+#define __LINUX_PHY_EN7572_H
+
+struct phy;
+
+int en7572_phy_set_xgspon_rate(struct phy *phy);
+
+#endif /* __LINUX_PHY_EN7572_H */
