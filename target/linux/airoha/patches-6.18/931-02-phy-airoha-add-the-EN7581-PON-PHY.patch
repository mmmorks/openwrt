+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * EN7581 PON PHY: what the core and its generated sequence tables share.
+ */
+
+#ifndef _PHY_EN7581_PON_H
+#define _PHY_EN7581_PON_H
+
+#include <linux/array_size.h>
+#include <linux/types.h>
+
+#include "phy-en7581-pon-seq.h"
+
+/*
+ * The serdes is one 8 KiB register window: the analog half at its start and
+ * the PMA half 4 KiB in. A table step names its register by its offset in
+ * that window.
+ */
+#define SERDES_ANA		0x0000
+#define SERDES_PMA		0x1000
+
+/* A step whose register is this is a pause; its value is in microseconds. */
+#define PON_STEP_PAUSE		0xffff
+
+/* Columns of the sequence index, one per line mode. */
+#define PON_LINE_IDX_GPON	0
+#define PON_LINE_IDX_XGSPON	1
+#define PON_LINES		2
+
+/**
+ * struct pon_step - one step of a fixed serdes sequence
+ * @reg: register offset in the serdes window, or PON_STEP_PAUSE
+ * @hi: top bit written
+ * @lo: bottom bit written
+ * @val: what goes into bits @hi..@lo, or the pause in microseconds
+ *
+ * A field step reads the register, replaces bits @hi..@lo with @val and
+ * writes the word back, also when the field already held @val.
+ */
+struct pon_step {
+	u16 reg;
+	u8 hi;
+	u8 lo;
+	u32 val;
+};
+
+#define PON_SET(win, off, h, l, v) \
+	{ .reg = (win) + (off), .hi = (h), .lo = (l), .val = (v) }
+#define PON_WAIT(us) \
+	{ .reg = PON_STEP_PAUSE, .val = (us) }
+
+/**
+ * struct pon_seq - a fixed serdes sequence for one line mode
+ * @steps: the steps, in order
+ * @len: how many there are; 0 when the mode has no such sequence
+ */
+struct pon_seq {
+	const struct pon_step *steps;
+	unsigned int len;
+};
+
+extern const struct pon_seq pon_seqs[PON_SEQ_COUNT][PON_LINES];
+
+#endif /* _PHY_EN7581_PON_H */
diff --git a/include/linux/phy/en7581-pon.h b/include/linux/phy/en7581-pon.h
new file mode 100644
index 0000000..9bbe481
--- /dev/null
+++ b/include/linux/phy/en7581-pon.h
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Airoha EN7581 PON PHY: the operations a PON MAC driver needs beyond the
+ * generic PHY API.
+ *
+ * The MAC selects the line mode with phy_set_mode_ext(phy, PHY_MODE_ETHERNET,
+ * EN7581_PON_GPON or EN7581_PON_XGSPON) once phy_init() has run, ahead of
+ * phy_power_on(). The first selection programs the PHY, which then stays
+ * programmed across power-off and power-on; a later one does nothing, so a
+ * new line mode takes phy_exit() and phy_init(). phy_reset() resets and
+ * reprograms the whole PHY and leaves it powered on. Everything else is here.
+ *
+ * Context: unless a function says it sleeps, it only touches registers (or the
+ * optical module's transmit-disable line) and may be called from any context,
+ * including hard interrupt context. Every function needs the PHY powered on
+ * and returns -ENODEV when it is not, except en7581_pon_phy_link(), which then
+ * reports no light, en7581_pon_phy_set_transmitter() and
+ * en7581_pon_phy_watch_events().
+ */
+
+#ifndef __LINUX_PHY_EN7581_PON_H
+#define __LINUX_PHY_EN7581_PON_H
+
+#include <linux/bits.h>
+#include <linux/types.h>
+
+struct phy;
+
+/* Line modes, the submode of PHY_MODE_ETHERNET for phy_set_mode_ext() */
+enum en7581_pon_line {
+	EN7581_PON_GPON = 1,
+	EN7581_PON_XGSPON,
+};
+
+/* Counter groups for en7581_pon_phy_restart_counters() */
+#define EN7581_PON_CNT_FEC	BIT(0)
+#define EN7581_PON_CNT_BIP	BIT(1)
+#define EN7581_PON_CNT_FRAMES	BIT(2)
+#define EN7581_PON_CNT_ALL	(EN7581_PON_CNT_FEC | EN7581_PON_CNT_BIP | \
+				 EN7581_PON_CNT_FRAMES)
+
+/**
+ * struct en7581_pon_fec_stats - downstream FEC counters
+ * @corrected_bytes: bytes the decoder corrected
+ * @corrected_words: codewords the decoder corrected
+ * @uncorrectable_words: codewords it could not correct
+ * @total_words: codewords received
+ * @errored_seconds: seconds that saw an uncorrectable codeword
+ */
+struct en7581_pon_fec_stats {
+	u32 corrected_bytes;
+	u32 corrected_words;
+	u32 uncorrectable_words;
+	u32 total_words;
+	u32 errored_seconds;
+};
+
+/**
+ * struct en7581_pon_frame_stats - downstream frame counters
+ * @frames: frames received (32 bits wide in XGS-PON)
+ * @lof: loss-of-frame count
+ */
+struct en7581_pon_frame_stats {
+	u64 frames;
+	u32 lof;
+};
+
+/* Downstream FEC decoding, en7581_pon_phy_set_fec_decode() */
+enum en7581_pon_fec_decode {
+	EN7581_PON_FEC_DECODE_OFF,
+	EN7581_PON_FEC_DECODE_ON,
+	/* decode when the OLT announces FEC; XGS-PON only */
+	EN7581_PON_FEC_DECODE_AUTO,
+};
+
+/**
+ * struct en7581_pon_gpon_overhead - GPON upstream burst overhead
+ * @guard_time: guard time, in bits
+ * @type1_bits: type 1 preamble length, in bits
+ * @type2_bits: type 2 preamble length, in bits
+ * @type3_pattern: the type 3 preamble pattern byte
+ * @delimiter: the three burst delimiter bytes, in transmit order
+ *
+ * The fields of the Upstream_Overhead PLOAM message (ITU-T G.984.3).
+ */
+struct en7581_pon_gpon_overhead {
+	u8 guard_time;
+	u8 type1_bits;
+	u8 type2_bits;
+	u8 type3_pattern;
+	u8 delimiter[3];
+};
+
+/* GPON ONU activation states the burst logic needs (ITU-T G.984.3) */
+enum en7581_pon_onu_state {
+	EN7581_PON_ONU_STANDBY,		/* O2 */
+	EN7581_PON_ONU_RANGING,		/* O3, O4 */
+	EN7581_PON_ONU_OPERATION,	/* O5 */
+};
+
+/**
+ * struct en7581_pon_burst_profile - one XGS-PON upstream burst profile
+ * @preamble: the 8 preamble bytes, in transmit order
+ * @delimiter: the 8 delimiter bytes, in transmit order
+ * @delimiter_len: delimiter length, as the Burst_Profile message carries it
+ * @preamble_len: preamble length, as the message carries it
+ * @preamble_repeat: preamble repeat count, as the message carries it
+ * @fec: upstream FEC on for bursts that use this profile
+ *
+ * The fields of the Burst_Profile PLOAM message (ITU-T G.9807.1).
+ */
+struct en7581_pon_burst_profile {
+	u8 preamble[8];
+	u8 delimiter[8];
+	u8 delimiter_len;
+	u8 preamble_len;
+	u8 preamble_repeat;
+	bool fec;
+};
+
+/* Polarity sets for en7581_pon_phy_set_polarity() */
+#define EN7581_PON_POL_TX	BIT(0)	/* the three transmit-side signals */
+#define EN7581_PON_POL_RX	BIT(1)	/* receive signal-detect */
+#define EN7581_PON_POL_ALL	(EN7581_PON_POL_TX | EN7581_PON_POL_RX)
+
+/**
+ * struct en7581_pon_polarity - which optic signals the PHY inverts
+ * @invert_tx_detect: the transmit signal-detect input
+ * @invert_burst_enable: the burst-enable output
+ * @invert_tx_fault: the transmit-fault input
+ * @invert_rx_detect: the receive signal-detect input, so that it reports
+ *	loss of light rather than light
+ *
+ * The first three form the EN7581_PON_POL_TX set and are always set
+ * together; @invert_rx_detect alone is the EN7581_PON_POL_RX set.
+ */
+struct en7581_pon_polarity {
+	bool invert_tx_detect;
+	bool invert_burst_enable;
+	bool invert_tx_fault;
+	bool invert_rx_detect;
+};
+
+/* What the PHY concluded about the downstream link */
+enum en7581_pon_link_report {
+	EN7581_PON_REPORT_READY,	/* synchronised, with light */
+	EN7581_PON_REPORT_LOST,		/* sync or light gone */
+	EN7581_PON_REPORT_FRAME_LOST,	/* XGS-PON: downstream framing lost */
+};
+
+/**
+ * typedef en7581_pon_link_fn - a link report from the PHY
+ * @data: the pointer given to en7581_pon_phy_set_link_handler()
+ * @report: what the PHY concluded
+ * @polled: true when the PHY's periodic link check made the report for
+ *	itself; false when a latched link event led to it, and on the lost
+ *	report XGS-PON sends ahead of a ready one after an unexpected event
+ *
+ * GPON reports on every periodic check and XGS-PON only when the link
+ * changes; both also report the link events they act on. Runs in process
+ * context with the PHY's state locked: it must not call the functions below
+ * that sleep.
+ */
+typedef void (*en7581_pon_link_fn)(void *data,
+				   enum en7581_pon_link_report report,
+				   bool polled);
+
+int en7581_pon_phy_set_link_handler(struct phy *phy, en7581_pon_link_fn fn,
+				    void *data);
+int en7581_pon_phy_watch_events(struct phy *phy, bool on);
+int en7581_pon_phy_link(struct phy *phy, bool *ready, bool *light);
+int en7581_pon_phy_restart_counters(struct phy *phy, unsigned int groups);
+int en7581_pon_phy_bip_errors(struct phy *phy, u32 *errors);
+int en7581_pon_phy_fec_stats(struct phy *phy, struct en7581_pon_fec_stats *st);
+int en7581_pon_phy_frame_stats(struct phy *phy,
+			       struct en7581_pon_frame_stats *st);
+int en7581_pon_phy_fec_in_use(struct phy *phy, bool *down, bool *up);
+int en7581_pon_phy_get_fec_decode(struct phy *phy, bool *on);
+int en7581_pon_phy_set_fec_decode(struct phy *phy,
+				  enum en7581_pon_fec_decode mode);
+int en7581_pon_phy_rtt(struct phy *phy, u32 *rtt);
+int en7581_pon_phy_set_gpon_overhead(struct phy *phy,
+				     const struct en7581_pon_gpon_overhead *oh);
+int en7581_pon_phy_set_onu_state(struct phy *phy,
+				 enum en7581_pon_onu_state state);
+int en7581_pon_phy_set_extended_burst(struct phy *phy, u8 ranging_bytes,
+				      u8 operation_bytes);
+int en7581_pon_phy_set_bit_delay(struct phy *phy, unsigned int bits);
+int en7581_pon_phy_set_serdes_usable(struct phy *phy, bool usable);
+int en7581_pon_phy_logic_reset(struct phy *phy);
+int en7581_pon_phy_set_burst_profile(struct phy *phy, unsigned int n,
+				     const struct en7581_pon_burst_profile *bp);
+int en7581_pon_phy_get_burst_profile(struct phy *phy, unsigned int n,
+				     struct en7581_pon_burst_profile *bp);
+int en7581_pon_phy_set_receiver(struct phy *phy, bool on);
+int en7581_pon_phy_set_transmitter(struct phy *phy, bool on);
+int en7581_pon_phy_set_polarity(struct phy *phy,
+				const struct en7581_pon_polarity *pol,
+				unsigned int sets);
+int en7581_pon_phy_get_polarity(struct phy *phy,
+				struct en7581_pon_polarity *pol);
+int en7581_pon_phy_set_continuous_tx(struct phy *phy, bool on);
+int en7581_pon_phy_get_continuous_tx(struct phy *phy, bool *on);
+int en7581_pon_phy_set_test_pattern(struct phy *phy, bool on,
+				    unsigned int pattern, bool in_grants);
+
+#endif /* __LINUX_PHY_EN7581_PON_H */
