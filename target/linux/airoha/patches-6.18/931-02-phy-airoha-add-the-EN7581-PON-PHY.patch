+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * EN7581 PON PHY: the names of the fixed serdes write sequences.
+ *
+ * Register sequence definitions. These C tables are the editable source
+ * for the contributed driver; no external sequence specification is required.
+ */
+
+#ifndef _PHY_EN7581_PON_SEQ_H
+#define _PHY_EN7581_PON_SEQ_H
+
+enum pon_seq_id {
+	PON_SEQ_SERDES_PREP,
+	PON_SEQ_TXPLL_SETUP,
+	PON_SEQ_TX_RATE,
+	PON_SEQ_SERDES_COMMON_MID,
