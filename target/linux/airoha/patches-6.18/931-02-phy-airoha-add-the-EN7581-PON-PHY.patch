+	PON_SEQ_RX_FINISH,
+	PON_SEQ_RX_HOLD,
+	PON_SEQ_RX_RELOCK,
+	PON_SEQ_TX_TAPS,
+	PON_SEQ_EYE_PREP,
+	PON_SEQ_EYE_PHASE_RECAL,
+	PON_SEQ_EYE_START,
+	PON_SEQ_EYE_STOP,
+	PON_SEQ_EYE_LATCH,
+	PON_SEQ_LINE_LEAVE,
+	PON_SEQ_COUNT,
+};
+
+#endif /* _PHY_EN7581_PON_SEQ_H */
