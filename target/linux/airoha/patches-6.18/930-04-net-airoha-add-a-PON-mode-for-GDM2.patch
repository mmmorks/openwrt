+
 static int airoha_tc_htb_modify_queue(struct net_device *dev,
 				      struct tc_htb_qopt_offload *opt)
 {
@@ -3714,10 +3749,17 @@ static int airoha_tc_setup_qdisc_htb(struct net_device *netdev,
 static int airoha_dev_tc_setup(struct net_device *dev,
 			       enum tc_setup_type type, void *type_data)
 {
+	struct airoha_gdm_dev *gdm = netdev_priv(dev);
+
 	switch (type) {
