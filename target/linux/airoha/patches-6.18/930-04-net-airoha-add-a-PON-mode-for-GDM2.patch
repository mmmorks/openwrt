 void airoha_ppe_set_cpu_port(struct airoha_gdm_dev *dev, u8 ppe_id, u8 fport);
 bool airoha_ppe_is_enabled(struct airoha_eth *eth, int index);
diff --git a/drivers/net/ethernet/airoha/airoha_pon.c b/drivers/net/ethernet/airoha/airoha_pon.c
new file mode 100644
index 0000000..b9a808a
--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_pon.c
@@ -0,0 +1,635 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * PON mode of a GMAC port: the port carries the SoC's PON MAC, and a PON
+ * MAC driver tells the frame engine which GEM ports and T-CONTs exist.
+ */
+#include <linux/if_vlan.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/sort.h>
+
+#include "airoha_regs.h"
+#include "airoha_eth.h"
+
+/* the longest and shortest frame GDM2 passes in PON mode */
+#define AIROHA_PON_MAX_FRAME_LEN	2000
+#define AIROHA_PON_MIN_FRAME_LEN	60
+/* GDM2 RX channels the PON MAC delivers on */
+#define AIROHA_PON_RX_CHANS		GENMASK(1, 0)
+
+struct airoha_pon_client {
+	const struct airoha_pon_ops *ops;
+	void *priv;
+	struct rcu_head rcu;
+};
+
+struct airoha_pon_map {
+	struct rcu_head rcu;
+	unsigned int num_gems;
+	unsigned int num_rules;
+	/* sorted by port_id */
+	struct airoha_pon_gem gems[AIROHA_PON_MAX_GEMS];
+	struct airoha_pon_rule rules[AIROHA_PON_MAX_RULES];
+};
+
+static struct airoha_eth *airoha_pon_eth(struct airoha_pon *pon)
+{
+	return pon->dev->eth;
+}
+
+int airoha_pon_alloc(struct airoha_gdm_dev *dev)
+{
+	struct airoha_eth *eth = dev->eth;
+	struct airoha_pon *pon;
+
+	if (dev->port->id != AIROHA_GDM2_IDX) {
+		dev_err(eth->dev, "only GDM2 can be the PON interface\n");
+		return -EINVAL;
+	}
+
+	pon = devm_kzalloc(eth->dev, sizeof(*pon), GFP_KERNEL);
+	if (!pon)
+		return -ENOMEM;
+
+	pon->dev = dev;
+	mutex_init(&pon->lock);
+	dev->pon = pon;
+
+	return 0;
+}
+
+int airoha_pon_init(struct airoha_gdm_dev *dev)
+{
+	struct airoha_pon *pon = dev->pon;
+	struct airoha_eth *eth = dev->eth;
+
+	/* The PON datapath is the WAN QDMA's */
+	pon->qdma = airoha_qdma_deref(dev);
+	if (pon->qdma != &eth->qdma[1]) {
+		dev_err(eth->dev, "PON mode needs the second QDMA\n");
+		return -ENODEV;
+	}
+
+	airoha_fe_rmw(eth, REG_GDM_LEN_CFG(AIROHA_GDM2_IDX),
+		      GDM_SHORT_LEN_MASK | GDM_LONG_LEN_MASK,
+		      FIELD_PREP(GDM_SHORT_LEN_MASK, AIROHA_PON_MIN_FRAME_LEN) |
+		      FIELD_PREP(GDM_LONG_LEN_MASK, AIROHA_PON_MAX_FRAME_LEN));
+	airoha_fe_wr(eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX), 0);
+	airoha_fe_wr(eth, REG_GDM_RXCHN_EN(AIROHA_GDM2_IDX), 0);
+	airoha_qdma_init_qos_stats(pon->qdma, AIROHA_PON_NUM_TCONT_COUNTERS);
+	netif_carrier_off(netdev_from_priv(dev));
+
+	return 0;
+}
+
+void airoha_pon_start(struct airoha_pon *pon)
+{
+	struct airoha_eth *eth = airoha_pon_eth(pon);
+
+	mutex_lock(&pon->lock);
+	pon->running = true;
+	airoha_fe_wr(eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX), pon->tx_chans);
+	airoha_fe_wr(eth, REG_GDM_RXCHN_EN(AIROHA_GDM2_IDX),
+		     AIROHA_PON_RX_CHANS);
+	mutex_unlock(&pon->lock);
+}
+
+void airoha_pon_stop(struct airoha_pon *pon)
+{
+	struct airoha_eth *eth = airoha_pon_eth(pon);
+
+	mutex_lock(&pon->lock);
+	pon->running = false;
+	airoha_fe_wr(eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX), 0);
+	airoha_fe_wr(eth, REG_GDM_RXCHN_EN(AIROHA_GDM2_IDX), 0);
+	/* a closed T-CONT keeps its TX channel until the port stops */
+	pon->tx_chans = bitmap_read(pon->tconts, 0, AIROHA_PON_NUM_TCONTS);
+	mutex_unlock(&pon->lock);
+}
+
+void airoha_pon_free(struct airoha_pon *pon)
+{
+	kfree(rcu_dereference_protected(pon->map, true));
+	kfree(rcu_dereference_protected(pon->client, true));
+}
+
+/**
+ * airoha_pon_get() - take the PON interface of a frame engine
+ * @consumer: the PON MAC driver's device
+ * @np: the devicetree node of the GMAC port marked airoha,pon
+ *
+ * Only one consumer at a time may hold the interface. Unbinding the frame
+ * engine driver unbinds the consumer first.
+ *
+ * Return: the interface, or an ERR_PTR(): -EPROBE_DEFER while the frame
+ * engine has not registered its ports yet, -ENODEV when @np is not a PON
+ * port, -EBUSY when another consumer holds it.
+ */
+struct airoha_pon *airoha_pon_get(struct device *consumer,
+				  struct device_node *np)
+{
+	struct airoha_pon *pon = NULL;
+	struct platform_device *pdev;
+	struct device_node *parent;
+	struct airoha_eth *eth;
+	int i, j, err;
+
+	parent = of_get_parent(np);
+	if (!parent)
+		return ERR_PTR(-ENODEV);
+
+	pdev = of_find_device_by_node(parent);
+	of_node_put(parent);
+	if (!pdev)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	eth = platform_get_drvdata(pdev);
+	if (!eth || !test_bit(DEV_STATE_REGISTERED, &eth->state)) {
+		err = -EPROBE_DEFER;
+		goto error_pdev_put;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
+		struct airoha_gdm_port *port = eth->ports[i];
+
+		if (!port)
+			continue;
+
+		for (j = 0; j < ARRAY_SIZE(port->devs); j++) {
+			struct airoha_gdm_dev *dev = port->devs[j];
+
+			if (dev && dev->pon &&
+			    netdev_from_priv(dev)->dev.of_node == np)
+				pon = dev->pon;
+		}
+	}
+
+	if (!pon) {
+		err = -ENODEV;
+		goto error_pdev_put;
+	}
+
+	mutex_lock(&pon->lock);
+
+	if (pon->consumer) {
+		err = -EBUSY;
+		goto error_unlock;
+	}
+
+	if (!try_module_get(THIS_MODULE)) {
+		err = -ENODEV;
+		goto error_unlock;
+	}
+
+	if (!device_link_add(consumer, &pdev->dev,
+			     DL_FLAG_AUTOREMOVE_CONSUMER)) {
+		dev_err(&pdev->dev, "failed to link consumer %s\n",
+			dev_name(consumer));
+		err = -EINVAL;
+		goto error_module_put;
+	}
+
+	pon->consumer = consumer;
+	mutex_unlock(&pon->lock);
+
+	return pon;
+
+error_module_put:
+	module_put(THIS_MODULE);
+error_unlock:
+	mutex_unlock(&pon->lock);
+error_pdev_put:
+	platform_device_put(pdev);
+
+	return ERR_PTR(err);
+}
+EXPORT_SYMBOL_GPL(airoha_pon_get);
+
+/**
+ * airoha_pon_put() - release the PON interface airoha_pon_get() took
+ * @pon: the interface
+ *
+ * Unregisters the consumer's callbacks if it has not done so itself.
+ */
+void airoha_pon_put(struct airoha_pon *pon)
+{
+	struct airoha_eth *eth = airoha_pon_eth(pon);
+
+	airoha_pon_unregister(pon);
+
+	mutex_lock(&pon->lock);
+	pon->consumer = NULL;
+	mutex_unlock(&pon->lock);
+
+	module_put(THIS_MODULE);
+	put_device(eth->dev);
+}
+EXPORT_SYMBOL_GPL(airoha_pon_put);
+
+/**
+ * airoha_pon_netdev() - the net_device of the PON interface
+ * @pon: the interface
+ *
+ * Return: the net_device, valid while @pon is held.
+ */
+struct net_device *airoha_pon_netdev(struct airoha_pon *pon)
+{
+	return netdev_from_priv(pon->dev);
+}
+EXPORT_SYMBOL_GPL(airoha_pon_netdev);
+
+/**
+ * airoha_pon_register() - install the consumer's callbacks
+ * @pon: the interface
+ * @ops: the callbacks; they must stay valid until airoha_pon_unregister()
+ * @priv: the first argument of every callback
+ *
+ * Return: 0, or -EBUSY when callbacks are already installed.
+ */
+int airoha_pon_register(struct airoha_pon *pon,
+			const struct airoha_pon_ops *ops, void *priv)
+{
+	struct airoha_pon_client *client;
+	int err = 0;
+
+	client = kzalloc(sizeof(*client), GFP_KERNEL);
+	if (!client)
+		return -ENOMEM;
+
+	client->ops = ops;
+	client->priv = priv;
+
+	mutex_lock(&pon->lock);
+	if (rcu_access_pointer(pon->client))
+		err = -EBUSY;
+	else
+		rcu_assign_pointer(pon->client, client);
+	mutex_unlock(&pon->lock);
+
+	if (err)
+		kfree(client);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_register);
+
+/**
+ * airoha_pon_unregister() - remove the consumer's callbacks
+ * @pon: the interface
+ *
+ * Turns the carrier off. No callback runs once this returns.
+ */
+void airoha_pon_unregister(struct airoha_pon *pon)
+{
+	struct airoha_pon_client *client;
+
+	airoha_pon_set_carrier(pon, false);
+
+	mutex_lock(&pon->lock);
+	client = rcu_replace_pointer(pon->client, NULL,
+				     lockdep_is_held(&pon->lock));
+	mutex_unlock(&pon->lock);
+
+	if (client) {
+		synchronize_rcu();
+		kfree(client);
+	}
+}
+EXPORT_SYMBOL_GPL(airoha_pon_unregister);
+
+static int airoha_pon_gem_cmp(const void *a, const void *b)
+{
+	const struct airoha_pon_gem *ga = a, *gb = b;
+
+	return (int)ga->port_id - (int)gb->port_id;
+}
+
+/* Replace the GEM table or the rule table; a negative count keeps it. */
+static int airoha_pon_replace_map(struct airoha_pon *pon,
+				  const struct airoha_pon_gem *gems,
+				  int num_gems,
+				  const struct airoha_pon_rule *rules,
+				  int num_rules)
+{
+	struct airoha_pon_map *map, *old;
+
+	map = kzalloc(sizeof(*map), GFP_KERNEL);
+	if (!map)
+		return -ENOMEM;
+
+	mutex_lock(&pon->lock);
+
+	old = rcu_dereference_protected(pon->map, lockdep_is_held(&pon->lock));
+	if (num_gems < 0) {
+		gems = old ? old->gems : NULL;
+		num_gems = old ? old->num_gems : 0;
+	}
+	if (num_rules < 0) {
+		rules = old ? old->rules : NULL;
+		num_rules = old ? old->num_rules : 0;
+	}
+
+	if (num_gems)
+		memcpy(map->gems, gems, num_gems * sizeof(*gems));
+	map->num_gems = num_gems;
+	if (num_rules)
+		memcpy(map->rules, rules, num_rules * sizeof(*rules));
+	map->num_rules = num_rules;
+
+	rcu_assign_pointer(pon->map, map);
+
+	mutex_unlock(&pon->lock);
+
+	if (old)
+		kfree_rcu(old, rcu);
+
+	return 0;
+}
+
+/**
+ * airoha_pon_set_gems() - replace the GEM port table
+ * @pon: the interface
+ * @gems: the new table, in any order
+ * @n: its length, at most AIROHA_PON_MAX_GEMS
+ *
+ * Downstream frames on a GEM port the table does not mark
+ * AIROHA_PON_GEM_DOWNSTREAM are dropped.
+ *
+ * Return: 0, or -EINVAL when a GEM port ID repeats, is 0xffff, or names a
+ * T-CONT past AIROHA_PON_NUM_TCONTS or a queue past AIROHA_PON_TCONT_QUEUES.
+ */
+int airoha_pon_set_gems(struct airoha_pon *pon,
+			const struct airoha_pon_gem *gems, unsigned int n)
+{
+	struct airoha_pon_gem *sorted;
+	unsigned int i;
+	int err;
+
+	if (n > AIROHA_PON_MAX_GEMS)
+		return -EINVAL;
+
+	sorted = kmemdup_array(gems, n, sizeof(*gems), GFP_KERNEL);
+	if (n && !sorted)
+		return -ENOMEM;
+
+	sort(sorted, n, sizeof(*sorted), airoha_pon_gem_cmp, NULL);
+
+	err = 0;
+	for (i = 0; i < n; i++) {
+		const struct airoha_pon_gem *gem = &sorted[i];
+
+		if (gem->port_id == 0xffff ||
+		    (gem->flags & ~(AIROHA_PON_GEM_UPSTREAM |
+				    AIROHA_PON_GEM_DOWNSTREAM)) ||
+		    ((gem->flags & AIROHA_PON_GEM_UPSTREAM) &&
+		     (gem->tcont >= AIROHA_PON_NUM_TCONTS ||
+		      gem->queue >= AIROHA_PON_TCONT_QUEUES)) ||
+		    (i && gem->port_id == sorted[i - 1].port_id)) {
+			err = -EINVAL;
+			break;
+		}
+	}
+
+	if (!err)
+		err = airoha_pon_replace_map(pon, sorted, n, NULL, -1);
+	kfree(sorted);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_set_gems);
+
+/**
+ * airoha_pon_set_rules() - replace the upstream classification rules
+ * @pon: the interface
+ * @rules: the new rules, in match order
+ * @n: their number, at most AIROHA_PON_MAX_RULES
+ *
+ * Return: 0, or -EINVAL for a VLAN ID or PCP out of range.
+ */
+int airoha_pon_set_rules(struct airoha_pon *pon,
+			 const struct airoha_pon_rule *rules, unsigned int n)
+{
+	unsigned int i;
+
+	if (n > AIROHA_PON_MAX_RULES)
+		return -EINVAL;
+
+	for (i = 0; i < n; i++) {
+		const struct airoha_pon_rule *rule = &rules[i];
+
+		if (rule->vid >= VLAN_N_VID &&
+		    rule->vid != AIROHA_PON_VID_UNTAGGED &&
+		    rule->vid != AIROHA_PON_VID_ANY)
+			return -EINVAL;
+
+		if (rule->pcp > 7 && rule->pcp != AIROHA_PON_PCP_ANY)
+			return -EINVAL;
+	}
+
+	return airoha_pon_replace_map(pon, NULL, -1, rules, n);
+}
+EXPORT_SYMBOL_GPL(airoha_pon_set_rules);
+
+static void airoha_pon_close_queues(struct airoha_pon *pon,
+				    unsigned int tcont, bool close)
+{
+	u32 mask = 0;
+	int i;
+
+	for (i = 0; i < AIROHA_PON_TCONT_QUEUES; i++)
+		mask |= TXQ_DISABLE_CHAN_QUEUE_MASK(tcont, i);
+
+	airoha_qdma_rmw(pon->qdma, REG_QUEUE_CLOSE_CFG(tcont), mask,
+			close ? mask : 0);
+}
+
+/**
+ * airoha_pon_tcont_open() - start carrying a T-CONT
+ * @pon: the interface
+ * @tcont: the T-CONT, 0 to AIROHA_PON_NUM_TCONTS - 1
+ * @flags: AIROHA_PON_TCONT_NONBLOCK for the T-CONT that carries OMCI
+ *
+ * Call it once the OLT has assigned the T-CONT an Alloc-ID. Upstream
+ * frames of GEM ports on a T-CONT that is not open are dropped.
+ *
+ * Return: 0 or -EINVAL.
+ */
+int airoha_pon_tcont_open(struct airoha_pon *pon, unsigned int tcont,
+			  u32 flags)
+{
+	struct airoha_eth *eth = airoha_pon_eth(pon);
+
+	if (tcont >= AIROHA_PON_NUM_TCONTS ||
+	    (flags & ~AIROHA_PON_TCONT_NONBLOCK))
+		return -EINVAL;
+
+	mutex_lock(&pon->lock);
+
+	airoha_pon_close_queues(pon, tcont, false);
+
+	if (flags & AIROHA_PON_TCONT_NONBLOCK) {
+		u32 val = airoha_qdma_rr(pon->qdma, REG_CHAN_BLOCK_CFG);
+
+		/* restored when the T-CONT closes */
+		__assign_bit(tcont, pon->block_saved, val & BIT(tcont));
+		set_bit(tcont, pon->nonblock);
+		airoha_qdma_clear(pon->qdma, REG_CHAN_BLOCK_CFG, BIT(tcont));
+	}
+
+	pon->tx_chans |= BIT(tcont);
+	if (pon->running)
+		airoha_fe_set(eth, REG_GDM_TXCHN_EN(AIROHA_GDM2_IDX),
+			      BIT(tcont));
+	set_bit(tcont, pon->tconts);
+
+	mutex_unlock(&pon->lock);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_tcont_open);
+
+/**
+ * airoha_pon_tcont_close() - stop carrying a T-CONT
+ * @pon: the interface
+ * @tcont: the T-CONT
+ *
+ * Call it when the OLT withdraws the T-CONT's Alloc-ID. The T-CONT's
+ * queues close; frames already in them stay there until it opens again.
+ *
+ * Return: 0 or -EINVAL.
+ */
+int airoha_pon_tcont_close(struct airoha_pon *pon, unsigned int tcont)
+{
+	if (tcont >= AIROHA_PON_NUM_TCONTS)
+		return -EINVAL;
+
+	mutex_lock(&pon->lock);
+
+	clear_bit(tcont, pon->tconts);
+	airoha_pon_close_queues(pon, tcont, true);
+
+	if (test_and_clear_bit(tcont, pon->nonblock) &&
+	    test_bit(tcont, pon->block_saved))
+		airoha_qdma_set(pon->qdma, REG_CHAN_BLOCK_CFG, BIT(tcont));
+
+	mutex_unlock(&pon->lock);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_tcont_close);
+
+/**
+ * airoha_pon_tcont_sched() - set how a T-CONT's queues share it
+ * @pon: the interface
+ * @tcont: the T-CONT
+ * @nstrict: how many queues are served by strict priority: 0 to
+ *	AIROHA_PON_TCONT_QUEUES, but not AIROHA_PON_TCONT_QUEUES - 1. These
+ *	are the highest queues, queue 7 first.
+ * @weights: AIROHA_PON_TCONT_QUEUES weights; the queues below the strict
+ *	ones share what those leave by weight. NULL when every queue is
+ *	strict.
+ *
+ * Return: 0, -EINVAL, or the error of the scheduler's register interface.
+ */
+int airoha_pon_tcont_sched(struct airoha_pon *pon, unsigned int tcont,
+			   unsigned int nstrict, const u16 *weights)
+{
+	static const u16 none[AIROHA_PON_TCONT_QUEUES];
+	enum tx_sched_mode mode;
+	int err;
+
+	if (tcont >= AIROHA_PON_NUM_TCONTS ||
+	    nstrict > AIROHA_PON_TCONT_QUEUES ||
+	    nstrict == AIROHA_PON_TCONT_QUEUES - 1)
+		return -EINVAL;
+
+	if (nstrict == AIROHA_PON_TCONT_QUEUES)
+		mode = TC_SCH_SP;
+	else if (!nstrict)
+		mode = TC_SCH_WRR8;
+	else
+		mode = nstrict + 1;
+
+	if (!weights) {
+		if (nstrict != AIROHA_PON_TCONT_QUEUES)
+			return -EINVAL;
+		weights = none;
+	}
+
+	mutex_lock(&pon->lock);
+	err = airoha_qdma_set_chan_tx_sched(pon->qdma, tcont, mode, weights,
+					    AIROHA_PON_TCONT_QUEUES);
+	mutex_unlock(&pon->lock);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_tcont_sched);
+
+/**
+ * airoha_pon_tcont_rate() - limit a T-CONT's upstream rate
+ * @pon: the interface
+ * @tcont: the T-CONT
+ * @rate_kbps: the rate in kbit/s, 0 for no limit
+ * @bucket_size: the burst in bytes
+ *
+ * Return: 0, -EINVAL, or the error of the meter's register interface.
+ */
+int airoha_pon_tcont_rate(struct airoha_pon *pon, unsigned int tcont,
+			  u32 rate_kbps, u32 bucket_size)
+{
+	int err;
+
+	if (tcont >= AIROHA_PON_NUM_TCONTS)
+		return -EINVAL;
+
+	mutex_lock(&pon->lock);
+	err = airoha_qdma_set_chan_rate_limit(pon->qdma, tcont, rate_kbps,
+					      bucket_size);
+	mutex_unlock(&pon->lock);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_tcont_rate);
+
+/**
+ * airoha_pon_tcont_counters() - read a T-CONT's packet counters
+ * @pon: the interface
+ * @tcont: the T-CONT, below AIROHA_PON_NUM_TCONT_COUNTERS
+ * @cpu_packets: the frames the CPU sent on it
+ * @fwd_packets: the frames the PPE forwarded to it
+ *
+ * The counters are free-running 32-bit values.
+ *
+ * Return: 0 or -EINVAL.
+ */
+int airoha_pon_tcont_counters(struct airoha_pon *pon, unsigned int tcont,
+			      u32 *cpu_packets, u32 *fwd_packets)
+{
+	if (tcont >= AIROHA_PON_NUM_TCONT_COUNTERS)
+		return -EINVAL;
+
+	*cpu_packets = airoha_qdma_rr(pon->qdma, REG_CNTR_VAL(tcont << 1));
+	*fwd_packets = airoha_qdma_rr(pon->qdma,
+				      REG_CNTR_VAL((tcont << 1) + 1));
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_pon_tcont_counters);
+
+/**
+ * airoha_pon_set_carrier() - report whether the PON link carries traffic
+ * @pon: the interface
+ * @up: true once the ONU may send upstream data (G.984.3 state O5)
+ */
+void airoha_pon_set_carrier(struct airoha_pon *pon, bool up)
+{
+	struct net_device *netdev = netdev_from_priv(pon->dev);
+
+	if (up)
+		netif_carrier_on(netdev);
+	else
+		netif_carrier_off(netdev);
+}
+EXPORT_SYMBOL_GPL(airoha_pon_set_carrier);
diff --git a/drivers/net/ethernet/airoha/airoha_regs.h b/drivers/net/ethernet/airoha/airoha_regs.h
