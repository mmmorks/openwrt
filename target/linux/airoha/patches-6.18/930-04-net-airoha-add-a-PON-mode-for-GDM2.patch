diff --git a/include/linux/soc/airoha/airoha_pon.h b/include/linux/soc/airoha/airoha_pon.h
new file mode 100644
index 0000000..61a4c71
--- /dev/null
+++ b/include/linux/soc/airoha/airoha_pon.h
@@ -0,0 +1,131 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * The interface between the Airoha frame engine driver and a PON MAC
+ * driver, for a GMAC port the devicetree marks as the PON interface.
+ */
+
+#ifndef AIROHA_PON_H
+#define AIROHA_PON_H
+
+#include <linux/bits.h>
+#include <linux/err.h>
+#include <linux/types.h>
+
+struct device;
+struct device_node;
+struct net_device;
+struct sk_buff;
+struct airoha_pon;
+
+/* T-CONTs the frame engine can carry, one per QDMA channel */
+#define AIROHA_PON_NUM_TCONTS		32
+/* T-CONTs with packet counters, two counters each */
+#define AIROHA_PON_NUM_TCONT_COUNTERS	16
+/* GEM ports in one table */
+#define AIROHA_PON_MAX_GEMS		256
+/* upstream classification rules in one table */
+#define AIROHA_PON_MAX_RULES		64
+/* queues of one T-CONT */
+#define AIROHA_PON_TCONT_QUEUES		8
+
+/**
+ * struct airoha_pon_gem - a GEM port the frame engine carries
+ * @port_id: the GEM port ID the OLT assigned (G.984.3, G.9807.1)
+ * @tcont: the T-CONT, 0 to AIROHA_PON_NUM_TCONTS - 1, that carries the
+ *	upstream frames of this GEM port. Ignored unless @flags has
+ *	AIROHA_PON_GEM_UPSTREAM.
+ * @flags: AIROHA_PON_GEM_UPSTREAM and/or AIROHA_PON_GEM_DOWNSTREAM
+ * @queue: the queue of @tcont, 0 to AIROHA_PON_TCONT_QUEUES - 1 with 7 the
+ *	highest (as airoha_pon_tcont_sched() numbers them), that carries the
+ *	upstream frames of this GEM port. Ignored unless @flags has
+ *	AIROHA_PON_GEM_UPSTREAM.
+ */
+struct airoha_pon_gem {
+	u16 port_id;
+	u8 tcont;
+	u8 flags;
+	u8 queue;
+};
+
+/* upstream frames may use the GEM port */
+#define AIROHA_PON_GEM_UPSTREAM		BIT(0)
+/* downstream frames on the GEM port are delivered */
+#define AIROHA_PON_GEM_DOWNSTREAM	BIT(1)
+
+/**
+ * struct airoha_pon_rule - one upstream classification rule
+ * @vid: the VLAN ID of the frame's outer tag, AIROHA_PON_VID_UNTAGGED to
+ *	match a frame without a tag, or AIROHA_PON_VID_ANY
+ * @pcp: the priority code point of the outer tag, 0 to 7, or
+ *	AIROHA_PON_PCP_ANY. A frame without a tag has PCP 0.
+ * @port_id: the GEM port a matching frame is sent on
+ *
+ * Rules are tried in table order and the first match wins. A frame that
+ * matches no rule, or whose GEM port is not an upstream GEM port of the
+ * current table, is dropped.
+ */
+struct airoha_pon_rule {
+	u16 vid;
+	u8 pcp;
+	u16 port_id;
+};
+
+#define AIROHA_PON_VID_UNTAGGED		0x1000
+#define AIROHA_PON_VID_ANY		0xffff
+#define AIROHA_PON_PCP_ANY		0xff
+
+/* airoha_pon_tcont_open(): the channel never blocks (the OMCI T-CONT) */
+#define AIROHA_PON_TCONT_NONBLOCK	BIT(0)
+
+/**
+ * struct airoha_pon_ops - calls from the frame engine driver into the PON
+ *	MAC driver
+ * @rx_ctrl: a control (OMCI) frame arrived on GEM port @port_id. The callee
+ *	owns @skb. @flags is AIROHA_PON_RX_MIC_UNCHECKED when the hardware
+ *	left the frame's integrity check to software. Called from NAPI.
+ * @ctrl_tx_wake: airoha_pon_xmit_ctrl() returned -EBUSY earlier and the
+ *	control ring has room again. Called from NAPI.
+ */
+struct airoha_pon_ops {
+	void (*rx_ctrl)(void *priv, struct sk_buff *skb, u16 port_id,
+			u32 flags);
+	void (*ctrl_tx_wake)(void *priv);
+};
+
+#define AIROHA_PON_RX_MIC_UNCHECKED	BIT(0)
+
+#if IS_ENABLED(CONFIG_NET_AIROHA)
+struct airoha_pon *airoha_pon_get(struct device *consumer,
+				  struct device_node *np);
+void airoha_pon_put(struct airoha_pon *pon);
+struct net_device *airoha_pon_netdev(struct airoha_pon *pon);
+int airoha_pon_register(struct airoha_pon *pon,
+			const struct airoha_pon_ops *ops, void *priv);
+void airoha_pon_unregister(struct airoha_pon *pon);
+int airoha_pon_set_gems(struct airoha_pon *pon,
+			const struct airoha_pon_gem *gems, unsigned int n);
+int airoha_pon_set_rules(struct airoha_pon *pon,
+			 const struct airoha_pon_rule *rules, unsigned int n);
+int airoha_pon_tcont_open(struct airoha_pon *pon, unsigned int tcont,
+			  u32 flags);
+int airoha_pon_tcont_close(struct airoha_pon *pon, unsigned int tcont);
+int airoha_pon_tcont_sched(struct airoha_pon *pon, unsigned int tcont,
+			   unsigned int nstrict, const u16 *weights);
+int airoha_pon_tcont_rate(struct airoha_pon *pon, unsigned int tcont,
+			  u32 rate_kbps, u32 bucket_size);
+int airoha_pon_tcont_counters(struct airoha_pon *pon, unsigned int tcont,
+			      u32 *cpu_packets, u32 *fwd_packets);
+void airoha_pon_set_carrier(struct airoha_pon *pon, bool up);
+#else
+static inline struct airoha_pon *airoha_pon_get(struct device *consumer,
+						struct device_node *np)
+{
+	return ERR_PTR(-ENODEV);
+}
+
+static inline void airoha_pon_put(struct airoha_pon *pon)
+{
+}
+#endif
+
+#endif /* AIROHA_PON_H */
