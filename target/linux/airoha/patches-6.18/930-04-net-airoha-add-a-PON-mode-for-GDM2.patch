+			return -EOPNOTSUPP;
 		return airoha_tc_setup_qdisc_htb(dev, type_data);
 	case TC_SETUP_BLOCK:
 	case TC_SETUP_FT:
@@ -4014,6 +4056,10 @@ static int airoha_alloc_gdm_device(struct airoha_eth *eth,
 	dev->nbq = nbq;
 	port->devs[index] = dev;
 
+	/* A PON port has no PHY or PCS: its link is the PON MAC driver's */
+	if (of_property_read_bool(np, "airoha,pon"))
