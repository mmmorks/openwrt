From e6037aaa69d50f30fdd9a15ac57630ca4ef8399a Mon Sep 17 00:00:00 2001
From: John Morkel <john@morkel.me>
Date: Sun, 18 Oct 2026 21:00:00 +0000
Subject: [PATCH] dt-bindings: phy: add Airoha EN7572

Describe the laser controller and its per-line factory calibration cells.

Signed-off-by: John Morkel <john@morkel.me>
---
 .../bindings/phy/airoha,en7572.yaml           | 68 +++++++++++++++++++
 1 file changed, 68 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/airoha,en7572.yaml

diff --git a/Documentation/devicetree/bindings/phy/airoha,en7572.yaml b/Documentation/devicetree/bindings/phy/airoha,en7572.yaml
new file mode 100644
index 0000000..ffe4a69
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/airoha,en7572.yaml
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/airoha,en7572.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Airoha EN7572 PON laser driver
+
+maintainers:
+  - mmmorks <john@morkel.me>
+
+description:
+  The EN7572 drives the laser of a PON optic and amplifies its receiver. It
+  carries a microcontroller that runs the laser's loops from a calibration
+  table, one table per PON mode, which the board keeps in its factory data.
+  The chip answers on I2C at two consecutive addresses; the node's address
+  is the first, and the second is the next one up. A PON MAC uses the chip
+  as a PHY, selecting the PON mode before powering it on. The firmware for
+  the chip's microcontroller is loaded from the filesystem, not described
+  here.
+
+properties:
+  compatible:
+    const: airoha,en7572
+
+  reg:
+    maxItems: 1
+    description: the first of the chip's two I2C addresses
+
+  nvmem-cells:
+    minItems: 1
+    maxItems: 2
+    description:
+      The calibration tables, 512 bytes each, one for each PON mode the
+      board supports.
+
+  nvmem-cell-names:
+    minItems: 1
+    items:
+      - enum: [ calibration-gpon, calibration-xgspon ]
+      - const: calibration-xgspon
+
+  "#phy-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - nvmem-cells
+  - nvmem-cell-names
+  - "#phy-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        laser-driver@50 {
+            compatible = "airoha,en7572";
+            reg = <0x50>;
+            nvmem-cells = <&pon_cal_gpon>, <&pon_cal_xgspon>;
+            nvmem-cell-names = "calibration-gpon", "calibration-xgspon";
+            #phy-cells = <0>;
+        };
+    };
