 	netdev_tx_sent_queue(txq, skb->len);
@@ -2769,10 +2789,13 @@
 	return NETDEV_TX_OK;
 }
 
-static netdev_tx_t airoha_dev_xmit(struct sk_buff *skb,
-				   struct net_device *netdev)
-{
-	struct airoha_gdm_dev *dev = netdev_priv(netdev);
+/* Send @skb on @dev's QDMA. @netdev is the device it was sent on: @dev's
+ * own, or an ANI port device stacked on @dev's PON interface.
+ */
+netdev_tx_t airoha_gdm_dev_xmit(struct airoha_gdm_dev *dev,
+				struct sk_buff *skb, struct net_device *netdev)
+{
+	unsigned int len = skb->len;
 	struct airoha_qdma *qdma;
 	u32 tag, msg0, msg1;
 	netdev_tx_t ret;
@@ -2813,12 +2836,17 @@
 	       FIELD_PREP(QDMA_ETH_TXMSG_FPORT_MASK, fport) |
 	       FIELD_PREP(QDMA_ETH_TXMSG_METER_MASK, 0x7f);
 
-	if (dev->pon && airoha_pon_tx_msg(dev->pon, skb, &msg0, &msg1))
+	if (dev->pon && airoha_pon_tx_msg(dev->pon, netdev, skb, &msg0, &msg1))
 		goto error;
 
 	ret = airoha_qdma_tx_skb(qdma, skb, netdev, qid, msg0, msg1,
 				 netdev_xmit_more());
 	rcu_read_unlock();
+
+	/* the GDM counts its own frames; a device stacked on it does not */
+	if (ret == NETDEV_TX_OK &&
+	    netdev->pcpu_stat_type == NETDEV_PCPU_STAT_TSTATS)
+		dev_sw_netstats_tx_add(netdev, 1, len);
 
 	return ret;
 
@@ -2828,6 +2856,12 @@
 	rcu_read_unlock();
 
 	return NETDEV_TX_OK;
+}
+
+static netdev_tx_t airoha_dev_xmit(struct sk_buff *skb,
+				   struct net_device *netdev)
+{
+	return airoha_gdm_dev_xmit(netdev_priv(netdev), skb, netdev);
 }
 
 static void airoha_ethtool_get_drvinfo(struct net_device *netdev,
@@ -3542,8 +3576,8 @@
 	}
 }
 
-static int airoha_dev_setup_tc_block(struct net_device *dev,
-				     struct flow_block_offload *f)
+int airoha_dev_setup_tc_block(struct net_device *dev,
+			      struct flow_block_offload *f)
 {
 	flow_setup_cb_t *cb = airoha_dev_setup_tc_block_cb;
 	static LIST_HEAD(block_cb_list);
@@ -3848,6 +3882,19 @@
 
 		dst_release(&port->dsa_meta[i]->dst);
 	}
+}
+
+/* The PON interface @netdev is, or NULL */
+struct airoha_pon *airoha_dev_pon(const struct net_device *netdev)
+{
+	const struct airoha_gdm_dev *dev;
+
+	if (netdev->netdev_ops != &airoha_netdev_ops)
+		return NULL;
+
+	dev = netdev_priv(netdev);
+
+	return dev->pon;
 }
 
 bool airoha_is_valid_gdm_dev(struct airoha_eth *eth,
@@ -4578,7 +4625,29 @@
 		.of_match_table = of_airoha_match,
 	},
 };
-module_platform_driver(airoha_driver);
+
+static int __init airoha_eth_init(void)
+{
+	int err;
+
+	err = airoha_pon_ani_register();
+	if (err)
+		return err;
+
+	err = platform_driver_register(&airoha_driver);
+	if (err)
+		airoha_pon_ani_unregister();
+
+	return err;
+}
+module_init(airoha_eth_init);
+
+static void __exit airoha_eth_exit(void)
+{
+	platform_driver_unregister(&airoha_driver);
+	airoha_pon_ani_unregister();
+}
+module_exit(airoha_eth_exit);
 
 MODULE_LICENSE("GPL v2");
 MODULE_AUTHOR("Lorenzo Bianconi <lorenzo@kernel.org>");
