+/* The ANI port device @ifindex of @pon; call it under RCU or ->lock. */
+static struct airoha_pon_ani *airoha_pon_find_ani(struct airoha_pon *pon,
+						  int ifindex)
+{
+	struct airoha_pon_ani *ani;
+
+	list_for_each_entry_rcu(ani, &pon->anis, list,
+				lockdep_is_held(&pon->lock))
+		if (ani->netdev->ifindex == ifindex)
+			return ani;
+
+	return NULL;
+}
+
+/* Whether @ifindex is 0 or an ANI port device; call it with ->lock held. */
+static bool airoha_pon_ifindex_ok(struct airoha_pon *pon, int ifindex)
+{
+	return !ifindex || airoha_pon_find_ani(pon, ifindex);
+}
+
+/* The ifindex the PON table names @netdev by: 0 for the PON interface */
+static int airoha_pon_dev_ifindex(struct airoha_pon *pon,
+				  const struct net_device *netdev)
+{
+	return netdev == netdev_from_priv(pon->dev) ? 0 : netdev->ifindex;
+}
+
 /* Replace the GEM table or the rule table; a negative count keeps it. */
 static int airoha_pon_replace_map(struct airoha_pon *pon,
 				  const struct airoha_pon_gem *gems,
@@ -388,7 +418,10 @@
  * @n: its length, at most AIROHA_PON_MAX_GEMS
