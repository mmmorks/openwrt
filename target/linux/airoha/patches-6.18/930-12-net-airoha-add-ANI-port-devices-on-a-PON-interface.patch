+
+/* An ANI port device: a G.988 ANI-side bridge port of the PON interface
+ * beyond the one the interface itself is, a GEM interworking TP, 802.1p
+ * mapper or multicast GEM interworking TP. It receives the frames of the
+ * GEM ports the PON table binds to it, and it sends on the GEM ports its own
+ * rules pick, on the PON interface's TX rings.
+ */
+
+static const struct net_device_ops airoha_pon_ani_netdev_ops;
+
+/* the carrier of the PON interface, while it runs */
+static void airoha_pon_ani_carrier(struct net_device *lower,
+				   struct net_device *netdev)
+{
+	if (netif_running(lower) && netif_carrier_ok(lower))
+		netif_carrier_on(netdev);
+	else
+		netif_carrier_off(netdev);
+}
+
+static u16 airoha_pon_ani_select_queue(struct net_device *netdev,
+				       struct sk_buff *skb,
+				       struct net_device *sb_dev)
+{
+	struct airoha_pon_ani *ani = netdev_priv(netdev);
+
+	return airoha_pon_select_queue(ani->pon, netdev, skb);
+}
+
+static netdev_tx_t airoha_pon_ani_xmit(struct sk_buff *skb,
+				       struct net_device *netdev)
+{
+	struct airoha_pon_ani *ani = netdev_priv(netdev);
+
+	return airoha_gdm_dev_xmit(ani->pon->dev, skb, netdev);
+}
+
+static int airoha_pon_ani_get_iflink(const struct net_device *netdev)
+{
+	struct airoha_pon_ani *ani = netdev_priv(netdev);
+
+	return READ_ONCE(netdev_from_priv(ani->pon->dev)->ifindex);
+}
+
+/* A flowtable's flows towards the device are offloaded through the PON
+ * interface's block callback, so a flowtable holding both binds it once.
+ */
+static int airoha_pon_ani_setup_tc(struct net_device *netdev,
+				   enum tc_setup_type type, void *type_data)
+{
+	struct airoha_pon_ani *ani = netdev_priv(netdev);
+
+	if (type != TC_SETUP_FT)
+		return -EOPNOTSUPP;
+
+	return airoha_dev_setup_tc_block(netdev_from_priv(ani->pon->dev),
+					 type_data);
+}
+
+static const struct net_device_ops airoha_pon_ani_netdev_ops = {
+	.ndo_select_queue	= airoha_pon_ani_select_queue,
+	.ndo_start_xmit		= airoha_pon_ani_xmit,
+	.ndo_get_iflink		= airoha_pon_ani_get_iflink,
+	.ndo_set_mac_address	= eth_mac_addr,
+	.ndo_validate_addr	= eth_validate_addr,
+	.ndo_setup_tc		= airoha_pon_ani_setup_tc,
+};
+
+/**
+ * airoha_pon_ani_lower() - the PON interface behind an ANI port device
+ * @netdev: a flow's egress device; replaced by its PON interface when it
+ *	is an ANI port device
+ *
+ * Return: the ANI port device's ifindex, or 0 when @netdev is not one.
+ */
+int airoha_pon_ani_lower(struct net_device **netdev)
+{
+	struct airoha_pon_ani *ani;
+	int ifindex;
+
+	if (!*netdev || (*netdev)->netdev_ops != &airoha_pon_ani_netdev_ops)
+		return 0;
+
+	ani = netdev_priv(*netdev);
+	ifindex = (*netdev)->ifindex;
+	*netdev = netdev_from_priv(ani->pon->dev);
+
+	return ifindex;
+}
+
+static void airoha_pon_ani_setup(struct net_device *netdev)
+{
+	ether_setup(netdev);
+	netdev->netdev_ops = &airoha_pon_ani_netdev_ops;
+	netdev->needs_free_netdev = true;
+	/* the PON table names it by its ifindex */
+	netdev->netns_immutable = true;
+	netdev->pcpu_stat_type = NETDEV_PCPU_STAT_TSTATS;
+}
+
+static unsigned int airoha_pon_ani_num_tx_queues(void)
+{
+	return AIROHA_PON_TCONT_QUEUES;
+}
+
+static unsigned int airoha_pon_ani_num_rx_queues(void)
+{
+	return AIROHA_NUM_RX_RING;
+}
+
+static int airoha_pon_ani_newlink(struct net_device *netdev,
+				  struct rtnl_newlink_params *params,
+				  struct netlink_ext_ack *extack)
+{
+	struct net *link_net = rtnl_newlink_link_net(params);
+	struct airoha_pon_ani *ani = netdev_priv(netdev);
+	struct nlattr **tb = params->tb;
+	struct net_device *lower;
+	struct airoha_pon *pon;
+	int err;
+
+	if (!tb[IFLA_LINK]) {
+		NL_SET_ERR_MSG(extack, "an ANI port device needs a PON link");
+		return -EINVAL;
+	}
+
+	lower = __dev_get_by_index(link_net, nla_get_u32(tb[IFLA_LINK]));
+	if (!lower) {
+		NL_SET_ERR_MSG_ATTR(extack, tb[IFLA_LINK], "unknown link");
+		return -ENODEV;
+	}
+
+	pon = airoha_dev_pon(lower);
+	if (!pon) {
+		NL_SET_ERR_MSG_ATTR(extack, tb[IFLA_LINK],
+				    "the link is not a PON interface");
+		return -EINVAL;
+	}
+
+	if (!net_eq(dev_net(lower), dev_net(netdev))) {
+		NL_SET_ERR_MSG(extack,
+			       "an ANI port device stays in its link's namespace");
+		return -EINVAL;
+	}
+
+	/* one TX queue per T-CONT queue, as on the PON interface */
+	err = netif_set_real_num_tx_queues(netdev, AIROHA_PON_TCONT_QUEUES);
+	if (err) {
+		NL_SET_ERR_MSG(extack, "too few TX queues");
+		return err;
+	}
+
+	ani->pon = pon;
+	ani->netdev = netdev;
+	/* the frame engine DMA-maps its frames */
+	SET_NETDEV_DEV(netdev, lower->dev.parent);
+	netdev->hw_features = lower->vlan_features & ~NETIF_F_HW_TC;
+	netdev->features = netdev->hw_features;
+	netdev->vlan_features = netdev->hw_features;
+	netdev->max_mtu = lower->max_mtu;
+	if (!tb[IFLA_MTU])
+		netdev->mtu = lower->mtu;
+	if (!tb[IFLA_ADDRESS])
+		eth_hw_addr_inherit(netdev, lower);
+	netif_carrier_off(netdev);
+
+	err = register_netdevice(netdev);
+	if (err)
+		return err;
+
+	err = netdev_upper_dev_link(lower, netdev, extack);
+	if (err) {
+		unregister_netdevice(netdev);
+		return err;
+	}
+
+	mutex_lock(&pon->lock);
+	list_add_tail_rcu(&ani->list, &pon->anis);
+	mutex_unlock(&pon->lock);
+
+	airoha_pon_ani_carrier(lower, netdev);
+
+	return 0;
+}
+
+static void airoha_pon_ani_dellink(struct net_device *netdev,
+				   struct list_head *head)
+{
+	struct airoha_pon_ani *ani = netdev_priv(netdev);
+	struct airoha_pon *pon = ani->pon;
+
+	/* unregistering waits out the RCU readers that may still see it */
+	mutex_lock(&pon->lock);
+	list_del_rcu(&ani->list);
+	mutex_unlock(&pon->lock);
+
+	netdev_upper_dev_unlink(netdev_from_priv(pon->dev), netdev);
+	unregister_netdevice_queue(netdev, head);
+
+	/* PPE entries towards it were bound with its rules */
+	airoha_ppe_flush_pon_flows(airoha_pon_eth(pon));
+}
+
+static struct rtnl_link_ops airoha_pon_ani_link_ops __read_mostly = {
+	.kind			= "airoha-pon-ani",
+	.priv_size		= sizeof(struct airoha_pon_ani),
+	.setup			= airoha_pon_ani_setup,
+	.newlink		= airoha_pon_ani_newlink,
+	.dellink		= airoha_pon_ani_dellink,
+	.get_num_tx_queues	= airoha_pon_ani_num_tx_queues,
+	.get_num_rx_queues	= airoha_pon_ani_num_rx_queues,
+};
+
+/* ANI port devices follow their PON interface's carrier, and go with it */
+static int airoha_pon_ani_event(struct notifier_block *nb,
+				unsigned long event, void *ptr)
+{
+	struct net_device *lower = netdev_notifier_info_to_dev(ptr);
+	struct airoha_pon_ani *ani, *tmp;
+	struct airoha_pon *pon;
+	LIST_HEAD(kill);
+
+	pon = airoha_dev_pon(lower);
+	if (!pon)
+		return NOTIFY_DONE;
+
+	/* RTNL is held, and the list changes only under it */
+	switch (event) {
+	case NETDEV_UP:
+	case NETDEV_DOWN:
+	case NETDEV_CHANGE:
+		list_for_each_entry(ani, &pon->anis, list)
+			airoha_pon_ani_carrier(lower, ani->netdev);
+		break;
+	case NETDEV_UNREGISTER:
+		list_for_each_entry_safe(ani, tmp, &pon->anis, list)
+			airoha_pon_ani_dellink(ani->netdev, &kill);
+		unregister_netdevice_many(&kill);
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block airoha_pon_ani_nb = {
+	.notifier_call = airoha_pon_ani_event,
+};
+
+int airoha_pon_ani_register(void)
+{
+	int err;
+
+	err = register_netdevice_notifier(&airoha_pon_ani_nb);
+	if (err)
+		return err;
+
+	err = rtnl_link_register(&airoha_pon_ani_link_ops);
+	if (err)
+		unregister_netdevice_notifier(&airoha_pon_ani_nb);
+
+	return err;
+}
+
+void airoha_pon_ani_unregister(void)
+{
+	rtnl_link_unregister(&airoha_pon_ani_link_ops);
+	unregister_netdevice_notifier(&airoha_pon_ani_nb);
+}
+
+MODULE_ALIAS_RTNL_LINK("airoha-pon-ani");
