 }
 
+static const struct net_device_ops airoha_netdev_ops;
+
+/* A frame on a TX ring is done: report it to BQL and free it. A frame of a
+ * device stacked on a GDM device (a PON ANI port device) held that device
+ * while it was on the ring.
+ */
+static void airoha_qdma_tx_done(struct sk_buff *skb)
+{
+	struct net_device *netdev = skb->dev;
+	struct netdev_queue *txq;
+
+	txq = skb_get_tx_queue(netdev, skb);
+	if (netdev->netdev_ops == &airoha_netdev_ops) {
+		struct airoha_gdm_dev *dev = netdev_priv(netdev);
+		u16 qidx = skb_get_queue_mapping(skb);
+
+		spin_lock_bh(&dev->txq_lock[qidx]);
+		netdev_tx_completed_queue(txq, 1, skb->len);
+		spin_unlock_bh(&dev->txq_lock[qidx]);
+		dev_kfree_skb_any(skb);
+		return;
+	}
+
+	/* the PON interface's QDMA alone sends an ANI port device's frames */
+	netdev_tx_completed_queue(txq, 1, skb->len);
+	dev_kfree_skb_any(skb);
+	dev_put(netdev);
+}
+
 static void airoha_qdma_wake_netdev_txqs(struct airoha_queue *q)
 {
 	struct airoha_qdma *qdma = q->qdma;
@@ -1204,6 +1234,8 @@
 
 			if (dev->pon && qid == AIROHA_PON_CTRL_RING)
